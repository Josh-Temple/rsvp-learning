  "chunks": [
    {
      "text": "監査可能性は証拠から始まります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "何を記録するかを決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "いつ記録するかも決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰が記録するかも決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "版を識別できるようにします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "データ版も記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定変更も履歴に残します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "評価結果も対応付けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "承認記録も対応付けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更前後を比較できるようにします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "小変更でも影響はあり得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "モデル更新だけが変更ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "プロンプト変更も対象です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検索源変更も対象です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限変更も対象です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ベンダー変更も対象です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更前に影響を評価します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更後にも再評価します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "段階導入で影響を限定できます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ロールバック手段を用意します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "監視指標を事前に決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "閾値超過時の行動も決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "インシデントを定義します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "軽微な異常も記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重大事象は迅速に封じ込めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "影響範囲を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "証拠を保全します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "原因と再発条件を調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一時対策と恒久対策を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者への連絡要否も判断します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "外部報告要件は個別に確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "復旧後も監視を続けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "再発防止策を検証します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "定期レビューを行います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "独立した視点も有効です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ISOは継続的改善を重視します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "形式監査だけで終えません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "記録と実運用を照合します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "廃止も変更管理の一部です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "学びを次の統制へ反映します。",
      "duration_multiplier": 1.15
    }
  ]
}
