{
  "schema_version": 1,
  "id": "ai-eval-human-judge",
  "title": "人間評価とLLM-as-a-judge",
  "topic": "AI運用",
  "summary": "生成AIの出力を人間や別のLLMで評価するときの利点と限界を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "生成結果には、正解が一つでない場合があります",
      "duration_multiplier": 1.35
    },
    {
      "text": "その場合、人間評価が重要になります",
      "duration_multiplier": 1.1
    },
    {
      "text": "評価者には、明確な評価基準を渡します",
      "duration_multiplier": 1.1
    },
    {
      "text": "正確性、関連性、完全性など観点を分けます",
      "duration_multiplier": 1.1
    },
    {
      "text": "複数の観点を一つの点数へ無理にまとめない方法もあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "評価者によって判断が異なることがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "必要なら、複数人の評価を比較します",
      "duration_multiplier": 1.1
    },
    {
      "text": "LLM-as-a-judgeは、LLMを評価者として使う方法です",
      "duration_multiplier": 1.1
    },
    {
      "text": "大量評価を効率化できる場合があります",
      "duration_multiplier": 1.1
    },
    {
      "text": "一方で、評価モデルにも偏りや誤りがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "表現の長さや文体に影響されることもあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "重要な評価では、人間評価との一致を確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "同じモデルだけで生成と評価を完結させない設計も検討します",
      "duration_multiplier": 1.1
    },
    {
      "text": "自動評価は、人間評価を置き換えるのではなく補助として使います",
      "duration_multiplier": 1.35
    }
  ]
}
