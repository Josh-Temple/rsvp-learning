{
  "schema_version": 1,
  "id": "ai-ops-versioning-experiments-rollback",
  "title": "バージョン管理・比較実験・Rollback",
  "topic": "AI運用",
  "summary": "プロンプトやモデルなどの変更を比較し、問題時に戻せる運用の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST AI 600-1: Generative Artificial Intelligence Profile",
      "url": "https://www.nist.gov/publications/artificial-intelligence-risk-management-framework-generative-artificial-intelligence"
    }
  ],
  "chunks": [
    {
      "text": "案内AIの新しい版を試すときは、",
      "duration_multiplier": 1
    },
    {
      "text": "旧版と同じ質問集合で比較します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答の正確さだけでなく、",
      "duration_multiplier": 1
    },
    {
      "text": "待ち時間と重大な誤案内も測ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "AIシステムでは、",
      "duration_multiplier": 1
    },
    {
      "text": "モデル以外にも",
      "duration_multiplier": 1
    },
    {
      "text": "多くの要素が変わります",
      "duration_multiplier": 1.35
    },
    {
      "text": "プロンプト、検索設定、",
      "duration_multiplier": 1
    },
    {
      "text": "ツール、評価基準も",
      "duration_multiplier": 1
    },
    {
      "text": "変更対象です",
      "duration_multiplier": 1.15
    },
    {
      "text": "どの変更で",
      "duration_multiplier": 1
    },
    {
      "text": "結果が変わったか",
      "duration_multiplier": 1
    },
    {
      "text": "追えるようにします",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定やコードに、",
      "duration_multiplier": 1
    },
    {
      "text": "バージョンを持たせます",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更前と変更後を、",
      "duration_multiplier": 1
    },
    {
      "text": "同じ評価条件で",
      "duration_multiplier": 1
    },
    {
      "text": "比較します",
      "duration_multiplier": 1.15
    },
    {
      "text": "一度に多くを変えると、",
      "duration_multiplier": 1
    },
    {
      "text": "原因を特定しにくく",
      "duration_multiplier": 1
    },
    {
      "text": "なります",
      "duration_multiplier": 1.15
    },
    {
      "text": "可能なら、",
      "duration_multiplier": 1
    },
    {
      "text": "変更点を小さく",
      "duration_multiplier": 1
    },
    {
      "text": "分けます",
      "duration_multiplier": 1.15
    },
    {
      "text": "A/Bテストなどで、",
      "duration_multiplier": 1
    },
    {
      "text": "本番影響を比較する",
      "duration_multiplier": 1
    },
    {
      "text": "方法もあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "高リスク業務では",
      "duration_multiplier": 1
    },
    {
      "text": "実験方法に制約があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "問題が起きたときに、",
      "duration_multiplier": 1
    },
    {
      "text": "以前の状態へ",
      "duration_multiplier": 1
    },
    {
      "text": "戻せるようにします",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答が変わった原因はモデルだけとは限らず、",
      "duration_multiplier": 1
    },
    {
      "text": "指示文や検索資料の変更にもあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "これが、Rollbackです",
      "duration_multiplier": 1.1
    },
    {
      "text": "Rollback対象には、",
      "duration_multiplier": 1
    },
    {
      "text": "コードだけでなく",
      "duration_multiplier": 1
    },
    {
      "text": "設定も含まれます",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更履歴と",
      "duration_multiplier": 1
    },
    {
      "text": "評価結果を対応づけます",
      "duration_multiplier": 1.15
    },
    {
      "text": "改善速度と",
      "duration_multiplier": 1
    },
    {
      "text": "復旧可能性を",
      "duration_multiplier": 1
    },
    {
      "text": "両立させることが重要です",
      "duration_multiplier": 1.35
    },
    {
      "text": "少数の利用者から始め、",
      "duration_multiplier": 1
    },
    {
      "text": "決めた閾値を超えたら旧版へ戻します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "モデルだけでなく、指示文、参照資料、",
      "duration_multiplier": 1
    },
    {
      "text": "評価データの版も記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "戻した後にどの版が実際に応答したか確認します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "戻す条件と戻す対象を事前に決めておけば、",
      "duration_multiplier": 1
    },
    {
      "text": "異常時に曖昧な判断で変更を重ねずに済みます。",
      "duration_multiplier": 1.35
    }
  ]
}
