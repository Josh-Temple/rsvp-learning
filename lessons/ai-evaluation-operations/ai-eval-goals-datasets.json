{
  "schema_version": 1,
  "id": "ai-eval-goals-datasets",
  "title": "評価目的と評価データ",
  "topic": "AI運用",
  "summary": "AIを何のために評価するのかを定め、代表的な評価データを作る基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "AI評価では、最初に評価目的を決めます",
      "duration_multiplier": 1.35
    },
    {
      "text": "正しさを見るのか、速さを見るのかで方法は変わります",
      "duration_multiplier": 1.1
    },
    {
      "text": "業務上の重要な失敗を先に定義します",
      "duration_multiplier": 1.1
    },
    {
      "text": "評価データは、実際の利用場面を代表する必要があります",
      "duration_multiplier": 1.1
    },
    {
      "text": "簡単な例だけでは、実運用の品質を判断できません",
      "duration_multiplier": 1.1
    },
    {
      "text": "頻出ケースだけでなく、重要な例外も含めます",
      "duration_multiplier": 1.1
    },
    {
      "text": "期待する出力を定められる場合は、正解データを用意します",
      "duration_multiplier": 1.1
    },
    {
      "text": "正解が一つでない課題では、評価基準を言語化します",
      "duration_multiplier": 1.1
    },
    {
      "text": "評価データは、本番改善のたびに使い回せるようにします",
      "duration_multiplier": 1.1
    },
    {
      "text": "学習や調整に使ったデータと、最終評価用データを分けることがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "同じ評価データを見ながら調整し続けると、評価へ過適合することがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "データの出所と作成条件を記録します",
      "duration_multiplier": 1.1
    },
    {
      "text": "評価対象のバージョンも記録します",
      "duration_multiplier": 1.1
    },
    {
      "text": "評価は、再現できる条件で行うことが重要です",
      "duration_multiplier": 1.35
    }
  ]
}
