{
  "schema_version": 1,
  "id": "pm-initiation-scope-wbs",
  "title": "目的・スコープ・WBS",
  "topic": "プロジェクト管理",
  "summary": "プロジェクトの目的を定め、スコープを明確にし、作業をWBSへ分解する基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "申請受付を電子化する案件で、成果物を画面、",
      "duration_multiplier": 1
    },
    {
      "text": "入力規則、運用手順に分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "画面だけ完成しても担当者の",
      "duration_multiplier": 1
    },
    {
      "text": "確認手順がなければ運用できません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "プロジェクト管理は、",
      "duration_multiplier": 1
    },
    {
      "text": "目的を明確にする",
      "duration_multiplier": 1
    },
    {
      "text": "ところから始まります",
      "duration_multiplier": 1.35
    },
    {
      "text": "何を達成すれば",
      "duration_multiplier": 1
    },
    {
      "text": "成功かを定義します",
      "duration_multiplier": 1.15
    },
    {
      "text": "成果物も、",
      "duration_multiplier": 1
    },
    {
      "text": "できるだけ具体的に",
      "duration_multiplier": 1
    },
    {
      "text": "します",
      "duration_multiplier": 1.15
    },
    {
      "text": "スコープは、",
      "duration_multiplier": 1
    },
    {
      "text": "プロジェクトで",
      "duration_multiplier": 1
    },
    {
      "text": "扱う範囲です",
      "duration_multiplier": 1.15
    },
    {
      "text": "含むものと、",
      "duration_multiplier": 1
    },
    {
      "text": "含まないものを",
      "duration_multiplier": 1
    },
    {
      "text": "明確にします",
      "duration_multiplier": 1.15
    },
    {
      "text": "曖昧なスコープは、",
      "duration_multiplier": 1
    },
    {
      "text": "追加作業を",
      "duration_multiplier": 1
    },
    {
      "text": "生みやすくなります",
      "duration_multiplier": 1.15
    },
    {
      "text": "WBSは、",
      "duration_multiplier": 1
    },
    {
      "text": "Work Breakdown Structure",
      "duration_multiplier": 1.35
    },
    {
      "text": "の略です",
      "duration_multiplier": 1.15
    },
    {
      "text": "成果を実現するための",
      "duration_multiplier": 1
    },
    {
      "text": "作業を、",
      "duration_multiplier": 1
    },
    {
      "text": "管理可能な単位へ",
      "duration_multiplier": 1
    },
    {
      "text": "分解します",
      "duration_multiplier": 1.15
    },
    {
      "text": "大きすぎる作業は、",
      "duration_multiplier": 1
    },
    {
      "text": "進捗を判断しにくく",
      "duration_multiplier": 1
    },
    {
      "text": "なります",
      "duration_multiplier": 1.15
    },
    {
      "text": "細かすぎる作業は、",
      "duration_multiplier": 1
    },
    {
      "text": "管理負担を増やします",
      "duration_multiplier": 1.15
    },
    {
      "text": "画面だけを成果物とみなすと、",
      "duration_multiplier": 1
    },
    {
      "text": "受付後の確認や運用が抜けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "担当者と期限を",
      "duration_multiplier": 1
    },
    {
      "text": "割り当てられる程度まで",
      "duration_multiplier": 1
    },
    {
      "text": "分けます",
      "duration_multiplier": 1.15
    },
    {
      "text": "依存関係も",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "WBSは、",
      "duration_multiplier": 1
    },
    {
      "text": "単なるToDoリストでは",
      "duration_multiplier": 1
    },
    {
      "text": "ありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "目的、成果物、作業の",
      "duration_multiplier": 1
    },
    {
      "text": "つながりを保つことが",
      "duration_multiplier": 1
    },
    {
      "text": "重要です",
      "duration_multiplier": 1.35
    },
    {
      "text": "各成果物に設計、",
      "duration_multiplier": 1
    },
    {
      "text": "実装、試験の作業を割り当てます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "分解した作業に担当と完了条件を付け、",
      "duration_multiplier": 1
    },
    {
      "text": "漏れや重複を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象外の帳票も明記します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "成果物ごとに作業と完了条件を分けると、",
      "duration_multiplier": 1
    },
    {
      "text": "対象外の帳票も含めて範囲を確認できます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "システムが完成しても、研修日が未定とします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用開始までに必要な作業が残っています。",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用開始を成果の条件として分解します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "開発作業だけを数えれば完了ですか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "導入と引継ぎの作業も確認します。",
      "duration_multiplier": 1.15
    }
  ]
}
