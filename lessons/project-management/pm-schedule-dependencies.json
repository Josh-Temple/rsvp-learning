{
  "schema_version": 1,
  "id": "pm-schedule-dependencies",
  "title": "スケジュールと依存関係",
  "topic": "プロジェクト管理",
  "summary": "作業順序、依存関係、マイルストーン、遅延影響の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "スケジュールは、作業の順序と期限を管理します",
      "duration_multiplier": 1.35
    },
    {
      "text": "すべての作業を同時に始められるわけではありません",
      "duration_multiplier": 1.1
    },
    {
      "text": "前の作業が終わらないと始められない作業があります",
      "duration_multiplier": 1.1
    },
    {
      "text": "これが、依存関係です",
      "duration_multiplier": 1.1
    },
    {
      "text": "依存関係を見落とすと、計画が成立しません",
      "duration_multiplier": 1.1
    },
    {
      "text": "マイルストーンは、重要な節目を示します",
      "duration_multiplier": 1.1
    },
    {
      "text": "承認、完成、リリースなどを節目として置けます",
      "duration_multiplier": 1.1
    },
    {
      "text": "見積りには、不確実性があります",
      "duration_multiplier": 1.1
    },
    {
      "text": "過度に楽観的な日程は、後で無理を生みます",
      "duration_multiplier": 1.1
    },
    {
      "text": "遅延した作業が、後続へどう影響するかを確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "重要な依存関係は、定期的に見直します",
      "duration_multiplier": 1.1
    },
    {
      "text": "進捗率だけでなく、完了条件を明確にします",
      "duration_multiplier": 1.1
    },
    {
      "text": "予定と実績の差を見て、必要なら計画を更新します",
      "duration_multiplier": 1.1
    },
    {
      "text": "スケジュール管理は、遅れを隠す作業ではなく早く見つける作業です",
      "duration_multiplier": 1.35
    }
  ]
}
