{
  "schema_version": 1,
  "id": "pm-change-quality",
  "title": "変更管理と品質管理",
  "topic": "プロジェクト管理",
  "summary": "途中変更の影響評価と、成果物が要求を満たすための品質管理の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "申請機能の開発途中で、",
      "duration_multiplier": 1
    },
    {
      "text": "新しい通知方法を追加したいとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "追加すると設計と試験が増え、",
      "duration_multiplier": 1
    },
    {
      "text": "予定日に影響するかもしれません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "プロジェクトでは、",
      "duration_multiplier": 1
    },
    {
      "text": "途中で変更要求が",
      "duration_multiplier": 1
    },
    {
      "text": "発生します",
      "duration_multiplier": 1.35
    },
    {
      "text": "変更そのものが",
      "duration_multiplier": 1
    },
    {
      "text": "悪いわけではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要なのは、",
      "duration_multiplier": 1
    },
    {
      "text": "影響を確認せず",
      "duration_multiplier": 1
    },
    {
      "text": "追加しないことです",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更は、",
      "duration_multiplier": 1
    },
    {
      "text": "範囲、費用、期限、",
      "duration_multiplier": 1
    },
    {
      "text": "品質へ影響します",
      "duration_multiplier": 1.15
    },
    {
      "text": "関連する要件や",
      "duration_multiplier": 1
    },
    {
      "text": "テストへの影響も",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更理由と",
      "duration_multiplier": 1
    },
    {
      "text": "承認者を記録します",
      "duration_multiplier": 1.15
    },
    {
      "text": "品質管理では、",
      "duration_multiplier": 1
    },
    {
      "text": "成果物が",
      "duration_multiplier": 1
    },
    {
      "text": "基準を満たすか",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "品質は、",
      "duration_multiplier": 1
    },
    {
      "text": "最後のテストだけで",
      "duration_multiplier": 1
    },
    {
      "text": "作るものではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件や設計の段階から",
      "duration_multiplier": 1
    },
    {
      "text": "品質を考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "レビューは、",
      "duration_multiplier": 1
    },
    {
      "text": "早い段階で",
      "duration_multiplier": 1
    },
    {
      "text": "問題を見つける手段です",
      "duration_multiplier": 1.15
    },
    {
      "text": "通知方法を追加すると、",
      "duration_multiplier": 1
    },
    {
      "text": "新しい画面や処理だけでなく既存の",
      "duration_multiplier": 1
    },
    {
      "text": "試験や運用手順にも影響します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "不具合の件数だけが、",
      "duration_multiplier": 1
    },
    {
      "text": "品質ではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "重大度や",
      "duration_multiplier": 1
    },
    {
      "text": "利用者影響も見ます",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更と品質は、",
      "duration_multiplier": 1
    },
    {
      "text": "互いに影響します",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更を制御しながら、",
      "duration_multiplier": 1
    },
    {
      "text": "価値を守ることが",
      "duration_multiplier": 1
    },
    {
      "text": "重要です",
      "duration_multiplier": 1.35
    },
    {
      "text": "変更の価値、必要な作業、",
      "duration_multiplier": 1
    },
    {
      "text": "既存機能への影響を整理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "期限を固定するなら他の範囲の調整も検討します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "決めた内容と受入条件を更新し、",
      "duration_multiplier": 1
    },
    {
      "text": "変更前の計画と混同しないようにします。",
      "duration_multiplier": 1.35
    },
    {
      "text": "変更を受け入れるなら、完了条件と",
      "duration_multiplier": 1
    },
    {
      "text": "計画の両方を更新して品質を判断します。",
      "duration_multiplier": 1.35
    }
  ]
}
