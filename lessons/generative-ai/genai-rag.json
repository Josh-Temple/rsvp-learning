      "duration_multiplier": 1
    },
    {
      "text": "あります",
      "duration_multiplier": 1.15
    },
    {
      "text": "取得した文章を、",
      "duration_multiplier": 1
    },
    {
      "text": "LLMのコンテキストへ",
      "duration_multiplier": 1
    },
    {
      "text": "渡します",
      "duration_multiplier": 1.15
    },
    {
      "text": "LLMは、",
      "duration_multiplier": 1
    },
    {
      "text": "その情報を使って",
      "duration_multiplier": 1
    },
    {
