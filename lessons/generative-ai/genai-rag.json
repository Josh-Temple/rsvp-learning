      "duration_multiplier": 1
    },
    {
      "text": "探します",
      "duration_multiplier": 1.15
    },
    {
      "text": "Embeddingを使った",
      "duration_multiplier": 1
    },
    {
      "text": "意味検索が",
      "duration_multiplier": 1
    },
    {
      "text": "使われることがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "キーワード検索と",
      "duration_multiplier": 1
    },
    {
