{
  "schema_version": 1,
  "id": "genai-rag",
  "title": "RAGの基本",
  "topic": "生成AI",
  "summary": "外部資料を検索し、回答生成へ利用するRAGの構成と限界を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "Lewis et al., Retrieval-Augmented Generation for Knowledge-Intensive NLP Tasks",
      "url": "https://arxiv.org/abs/2005.11401"
    },
    {
      "title": "OWASP GenAI LLM Top 10 2026",
      "url": "https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/"
    },
    {
      "title": "NIST AI 600-1: Generative Artificial Intelligence Profile",
      "url": "https://www.nist.gov/publications/artificial-intelligence-risk-management-framework-generative-artificial-intelligence"
    }
  ],
  "chunks": [
    {
      "text": "必要書類を尋ねられたとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "まず関連する手引きを検索します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "別制度の文書なら根拠として誤りです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "RAGは検索結果を生成へ使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "外部知識をその場で参照できます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最初に参照文書を準備します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "文書の版や日付も管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検索しやすい単位へ分割します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "分割しすぎると文脈を失います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "大きすぎると検索が粗くなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "質問に関係する候補を探します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "意味検索を使うことがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "キーワード検索も利用できます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "両方を組み合わせる方法もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "候補を並べ直す処理もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "取得文書をLLMへ渡します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "LLMは根拠を使って回答します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検索失敗と生成失敗を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要箇所が取れたか確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答が根拠に忠実か確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "出典を返す設計も有効です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし出典表示だけでは十分でありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "引用先と回答内容を照合します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "古い版が取れれば回答も古くなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限のない文書を検索させません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "取得文書を命令として盲信しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "根拠不足なら無理に答えません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "人へ引き継ぐ設計も考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "正しい規程を取れたとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "それでも期限を誤答しました。",
      "duration_multiplier": 1.15
    },
    {
      "text": "この場合は生成側も調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検索だけ直しても改善しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "別の例で検索結果が空だとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "生成だけで補えば危険です。",
      "duration_multiplier": 1.35
    },
    {
      "text": "根拠不足を明示する方が安全です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "RAGは正答を保証する仕組みではありません。",
      "duration_multiplier": 1.35
    },
    {
      "text": "検索と生成を別々に評価します。",
      "duration_multiplier": 1.35
    }
  ]
}
