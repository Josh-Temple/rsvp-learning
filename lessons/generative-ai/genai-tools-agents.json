{
  "schema_version": 1,
  "id": "genai-tools-agents",
  "title": "Tool CallingとAgent",
  "topic": "生成AI",
  "summary": "LLMが外部ツールを使う仕組みと、複数ステップを進めるAgentの設計上の注意点を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "OpenAI API: Function Calling",
      "url": "https://developers.openai.com/api/docs/guides/function-calling"
    },
    {
      "title": "OWASP GenAI LLM Top 10 2026",
      "url": "https://genai.owasp.org/resource/owasp-genai-llm-top-10-2026/"
    },
    {
      "title": "NIST SP 800-53 Rev. 5 Update 1",
      "url": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final"
    }
  ],
  "chunks": [
    {
      "text": "LLMは、",
      "duration_multiplier": 1
    },
    {
      "text": "文章を生成するだけでなく",
      "duration_multiplier": 1
    },
    {
      "text": "外部機能を呼び出せます",
      "duration_multiplier": 1.35
    },
    {
      "text": "これを、",
      "duration_multiplier": 1
    },
    {
      "text": "Tool Callingとして",
      "duration_multiplier": 1.35
    },
    {
      "text": "扱います",
      "duration_multiplier": 1.15
    },
    {
      "text": "例えば、",
      "duration_multiplier": 1
    },
    {
      "text": "検索、計算、",
      "duration_multiplier": 1
    },
    {
      "text": "データ取得を",
      "duration_multiplier": 1
    },
    {
      "text": "ツールへ任せられます",
      "duration_multiplier": 1.15
    },
    {
      "text": "モデルは、",
      "duration_multiplier": 1
    },
    {
      "text": "用意されたツールの中から、",
      "duration_multiplier": 1
    },
    {
      "text": "呼び出すツール名と",
      "duration_multiplier": 1
    },
    {
      "text": "引数を応答として",
      "duration_multiplier": 1
    },
    {
      "text": "返します",
      "duration_multiplier": 1
    },
    {
      "text": "実際の処理は、",
      "duration_multiplier": 1
    },
    {
      "text": "呼び出し側のアプリが",
      "duration_multiplier": 1
    },
    {
      "text": "ツール名と引数を",
      "duration_multiplier": 1
    },
    {
      "text": "確認して",
      "duration_multiplier": 1
    },
    {
      "text": "実行します",
      "duration_multiplier": 1.25
    },
    {
      "text": "ツールの結果を、",
      "duration_multiplier": 1
    },
    {
      "text": "再びLLMへ返します",
      "duration_multiplier": 1.15
    },
    {
      "text": "Agentでは、",
      "duration_multiplier": 1
    },
    {
      "text": "この判断と実行を",
      "duration_multiplier": 1
    },
    {
      "text": "複数回繰り返す",
      "duration_multiplier": 1
    },
    {
      "text": "ことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "複雑な仕事を、",
      "duration_multiplier": 1
    },
    {
      "text": "複数ステップへ",
      "duration_multiplier": 1
    },
    {
      "text": "分けられます",
      "duration_multiplier": 1.15
    },
    {
      "text": "一方で、",
      "duration_multiplier": 1
    },
    {
      "text": "実行回数が増えるほど",
      "duration_multiplier": 1
    },
    {
      "text": "失敗経路も増えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "書込みや送信などの",
      "duration_multiplier": 1
    },
    {
      "text": "副作用には",
      "duration_multiplier": 1
    },
    {
      "text": "特に注意します",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限を必要最小限にします",
      "duration_multiplier": 1.1
    },
    {
      "text": "重要な操作前に、",
      "duration_multiplier": 1
    },
    {
      "text": "人間承認を置く",
      "duration_multiplier": 1
    },
    {
      "text": "ことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "途中状態と実行履歴を",
      "duration_multiplier": 1
    },
    {
      "text": "記録すると",
      "duration_multiplier": 1
    },
    {
      "text": "復旧しやすくなります",
      "duration_multiplier": 1.15
    },
    {
      "text": "Agentは、",
      "duration_multiplier": 1
    },
    {
      "text": "自律性より",
      "duration_multiplier": 1
    },
    {
      "text": "制御可能性を含めて",
      "duration_multiplier": 1
    },
    {
      "text": "設計します",
      "duration_multiplier": 1.35
    },
    {
      "text": "AIが申請状況を調べ、必要なら担当者",
      "duration_multiplier": 1
    },
    {
      "text": "へ通知するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検索は読み取りですが、通知は外部へ",
      "duration_multiplier": 1
    },
    {
      "text": "作用する操作です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "AIが選んだ宛先と内容を、送信前に",
      "duration_multiplier": 1
    },
    {
      "text": "権限と対象案件で検査します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "応答が遅くても、同じ通知を無条件に",
      "duration_multiplier": 1
    },
    {
      "text": "再送すると重複するかもしれません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "各呼出しの入力と結果を記録し、失敗",
      "duration_multiplier": 1
    },
    {
      "text": "後に何を再試行できるか決めます。",
      "duration_multiplier": 1.35
    }
  ]
}
