{
  "schema_version": 1,
  "id": "genai-llm-context",
  "title": "LLMとコンテキスト",
  "topic": "生成AI",
  "summary": "LLMの基本的な入出力と、コンテキストを設計する考え方を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "LLMは、",
      "duration_multiplier": 1
    },
    {
      "text": "与えられた入力から",
      "duration_multiplier": 1
    },
    {
      "text": "出力を生成します",
      "duration_multiplier": 1.35
    },
    {
      "text": "モデルが利用できる情報は、",
      "duration_multiplier": 1
    },
    {
      "text": "入力された文脈に",
      "duration_multiplier": 1
    },
    {
      "text": "強く依存します",
      "duration_multiplier": 1.15
    },
    {
      "text": "この文脈を、",
      "duration_multiplier": 1
    },
    {
      "text": "コンテキストとして",
      "duration_multiplier": 1
    },
    {
      "text": "扱います",
      "duration_multiplier": 1.15
    },
    {
      "text": "指示だけでなく、",
      "duration_multiplier": 1
    },
    {
      "text": "資料や会話履歴も",
      "duration_multiplier": 1
    },
    {
      "text": "コンテキストになります",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要な情報が",
      "duration_multiplier": 1
    },
    {
      "text": "入っていなければ、",
      "duration_multiplier": 1
    },
    {
      "text": "正確に答えられない",
      "duration_multiplier": 1
    },
    {
      "text": "場合があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "一方で、",
      "duration_multiplier": 1
    },
    {
      "text": "不要な情報を",
      "duration_multiplier": 1
    },
    {
      "text": "大量に入れると",
      "duration_multiplier": 1
    },
    {
      "text": "判断を難しくする",
      "duration_multiplier": 1
    },
    {
      "text": "ことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "コンテキストには、",
      "duration_multiplier": 1
    },
    {
      "text": "量の上限があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要な情報を選んで",
      "duration_multiplier": 1
    },
    {
      "text": "渡す設計が必要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "指示と参照資料を",
      "duration_multiplier": 1
    },
    {
      "text": "区別すると、",
      "duration_multiplier": 1
    },
    {
      "text": "役割が分かりやすく",
      "duration_multiplier": 1
    },
    {
      "text": "なります",
      "duration_multiplier": 1.15
    },
    {
      "text": "出力形式も、",
      "duration_multiplier": 1
    },
    {
      "text": "事前に明確にできます",
      "duration_multiplier": 1.15
    },
    {
      "text": "曖昧な依頼は、",
      "duration_multiplier": 1
    },
    {
      "text": "曖昧な出力に",
      "duration_multiplier": 1
    },
    {
      "text": "つながりやすくなります",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "指示を細かくすれば",
      "duration_multiplier": 1
    },
    {
      "text": "必ず正しくなる",
      "duration_multiplier": 1
    },
    {
      "text": "わけではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "モデルの能力と",
      "duration_multiplier": 1
    },
    {
      "text": "情報の質の両方が",
      "duration_multiplier": 1
    },
    {
      "text": "影響します",
      "duration_multiplier": 1.15
    },
    {
      "text": "LLM利用では、",
      "duration_multiplier": 1
    },
    {
      "text": "何をコンテキストへ",
      "duration_multiplier": 1
    },
    {
      "text": "入れるかが",
      "duration_multiplier": 1
    },
    {
      "text": "設計の中心です",
      "duration_multiplier": 1.35
    },
    {
      "text": "同じ申請期限を尋ねても、古い手引きを",
      "duration_multiplier": 1
    },
    {
      "text": "渡せば古い期限を答える可能性があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "新しい規程を渡しても、",
      "duration_multiplier": 1
    },
    {
      "text": "関係のない箇所を読ませれば",
      "duration_multiplier": 1
    },
    {
      "text": "正しく答えられるとは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "モデルが参照できる範囲と、",
      "duration_multiplier": 1
    },
    {
      "text": "質問に必要な資料を分けて考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答には確認した資料と適用時点を示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "資料に答えがなければ断定を避けます。",
      "duration_multiplier": 1.35
    }
  ]
}
