      "duration_multiplier": 1.4
    },
    {
      "text": "受信にはIMAPなど別の",
      "duration_multiplier": 1.2
    },
    {
      "text": "プロトコルが利用されます",
      "duration_multiplier": 1.4
    },
    {
      "text": "メールは多くの組織で重要",
      "duration_multiplier": 1.1
    },
    {
      "text": "な通信手段であり",
      "duration_multiplier": 1
    },
    {
      "text": "フィッシングやなりすまし",
      "duration_multiplier": 1.1
    },
    {
      "text": "にも利用されます",
      "duration_multiplier": 1.4
    },
    {
      "text": "そのためSMTPそのもの",
      "duration_multiplier": 1.2
    },
    {
      "text": "だけでなくSPFDKIM",
      "duration_multiplier": 1.2
    },
    {
      "text": "DMARCなどの送信",
      "duration_multiplier": 1.2
    },
    {
      "text": "ドメイン認証も後の章で",
      "duration_multiplier": 1.1
    },
    {
      "text": "扱います",
      "duration_multiplier": 1.4
    },
    {
      "text": "プロキシ",
      "duration_multiplier": 1.4
    },
    {
      "text": "プロキシはクライアントと",
      "duration_multiplier": 1.1
    },
    {
      "text": "通信先の間に入り通信を",
      "duration_multiplier": 1.1
    },
    {
      "text": "中継する仕組みです",
      "duration_multiplier": 1.4
    },
    {
      "text": "組織ではアクセス制御記録",
      "duration_multiplier": 1.1
    },
    {
      "text": "キャッシュセキュリティ",
      "duration_multiplier": 1.1
    },
    {
      "text": "検査などの目的で利用さ",
      "duration_multiplier": 1.1
    },
    {
      "text": "れることがあります",
      "duration_multiplier": 1.4
    },
    {
      "text": "逆に外部からのリクエスト",
      "duration_multiplier": 1.1
    },
    {
      "text": "をサーバー側で受ける中継",
      "duration_multiplier": 1.1
    },
    {
      "text": "役をリバースプロキシと",
      "duration_multiplier": 1.1
    },
    {
      "text": "呼ぶことがあります",
      "duration_multiplier": 1.4
    },
    {
      "text": "同じ「中継」でもどちら側",
      "duration_multiplier": 1.1
    },
    {
      "text": "のために動くかによって",
      "duration_multiplier": 1.1
    },
    {
      "text": "役割が異なります",
      "duration_multiplier": 1.4
    },
    {
      "text": "無線LAN",
      "duration_multiplier": 1.4
    },
    {
      "text": "無線LANでは電波を使",
      "duration_multiplier": 1.2
    },
    {
      "text": "ってネットワークへ接続します",
      "duration_multiplier": 1.4
    },
    {
      "text": "有線接続と異なり通信範囲",
      "duration_multiplier": 1.1
    },
    {
      "text": "内の第三者から電波を受信",
      "duration_multiplier": 1.1
    },
    {
      "text": "される可能性を考える必要",
      "duration_multiplier": 1.1
    },
    {
      "text": "があります",
      "duration_multiplier": 1.4
    },
    {
      "text": "そのため適切な暗号化と",
      "duration_multiplier": 1.1
    },
    {
      "text": "認証が重要です",
      "duration_multiplier": 1.4
    },
    {
      "text": "WPA2やWPA3などの",
      "duration_multiplier": 1.2
    },
    {
      "text": "方式があります",
      "duration_multiplier": 1.4
    },
    {
      "text": "ただし安全性は方式名だけ",
      "duration_multiplier": 1.1
    },
    {
      "text": "でなく設定やパスワード",
      "duration_multiplier": 1.1
    },
    {
      "text": "端末側の状態にも左右されます",
      "duration_multiplier": 1.4
    },
    {
      "text": "通信を層で考える",
      "duration_multiplier": 1.4
    },
    {
      "text": "ネットワークは一つの巨大",
      "duration_multiplier": 1.1
    },
    {
      "text": "な仕組みではなく複数の層",
      "duration_multiplier": 1.1
    },
    {
      "text": "の役割が組み合わさって",
      "duration_multiplier": 1.1
    },
    {
      "text": "動きます",
      "duration_multiplier": 1.4
    },
    {
      "text": "IPは宛先までパケットを",
      "duration_multiplier": 1.2
    },
    {
      "text": "届けます",
      "duration_multiplier": 1.4
    },
    {
      "text": "TCPやUDPは",
      "duration_multiplier": 1.2
    },
    {
      "text": "アプリケーション間の通信",
      "duration_multiplier": 1.1
    },
    {
      "text": "を支えます",
      "duration_multiplier": 1.4
    },
    {
      "text": "HTTPやDNSなどは",
      "duration_multiplier": 1.2
    },
    {
      "text": "それぞれの用途に応じた",
      "duration_multiplier": 1.1
    },
    {
      "text": "意味を持ちます",
      "duration_multiplier": 1.4
    },
    {
      "text": "TLSは通信を暗号学的に",
      "duration_multiplier": 1.2
    },
    {
      "text": "保護します",
      "duration_multiplier": 1.4
    },
    {
      "text": "攻撃や障害を考えるときも",
      "duration_multiplier": 1.1
    },
    {
      "text": "どの層で何が起きているか",
      "duration_multiplier": 1.1
    },
    {
      "text": "を分けて考えると理解しや",
      "duration_multiplier": 1.1
    },
    {
      "text": "すくなります",
      "duration_multiplier": 1.4
    }
  ]
}
