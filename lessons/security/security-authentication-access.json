      "text": "パスキー",
      "duration_multiplier": 1.4
    },
    {
      "text": "パスキーは",
      "duration_multiplier": 1
    },
    {
      "text": "WebAuthnなどの",
      "duration_multiplier": 1.1
    },
    {
      "text": "公開鍵暗号を利用する認証",
      "duration_multiplier": 1.1
    },
    {
      "text": "資格情報を利用者が使い",
      "duration_multiplier": 1.1
    },
    {
      "text": "やすい形で提供する仕組みです",
      "duration_multiplier": 1.4
    },
    {
      "text": "サービスごとに異なる鍵を",
      "duration_multiplier": 1.1
    },
    {
      "text": "利用するため通常の",
      "duration_multiplier": 1
    },
    {
      "text": "パスワードのように同じ",
      "duration_multiplier": 1.1
    },
    {
      "text": "秘密文字列を複数サイトへ",
      "duration_multiplier": 1.1
    },
    {
      "text": "入力しません",
      "duration_multiplier": 1.4
    },
    {
      "text": "正しく構成された",
      "duration_multiplier": 1
    },
    {
      "text": "WebAuthn認証では",
      "duration_multiplier": 1.1
    },
    {
      "text": "認証情報が特定のサイトや",
      "duration_multiplier": 1.1
    },
    {
      "text": "RelyingParty",
      "duration_multiplier": 1.3
    },
    {
      "text": "へ暗号学的に結び付けられます",
      "duration_multiplier": 1.4
    },
    {
      "text": "そのため偽サイトへ認証",
      "duration_multiplier": 1.1
    },
    {
      "text": "情報を入力させて正規",
      "duration_multiplier": 1
    },
    {
      "text": "サイトへ転用する典型的な",
      "duration_multiplier": 1.1
    },
    {
      "text": "フィッシングに強い性質が",
      "duration_multiplier": 1.1
    },
    {
      "text": "あります",
      "duration_multiplier": 1.4
    },
    {
      "text": "同期型パスキー",
      "duration_multiplier": 1.4
    },
    {
      "text": "認証鍵をクラウドなど",
      "duration_multiplier": 1
    },
    {
      "text": "を通じて複数端末へ同期",
      "duration_multiplier": 1.1
    },
    {
      "text": "できる仕組みがあります",
      "duration_multiplier": 1.4
    },
    {
      "text": "NISTSP800-",
      "duration_multiplier": 1.2
    },
    {
      "text": "63B-4では",
      "duration_multiplier": 1.2
    },
    {
      "text": "Syncable",
      "duration_multiplier": 1
    },
    {
      "text": "Authenticators",
      "duration_multiplier": 1.3
    },
    {
      "text": "として要件を整理しています",
      "duration_multiplier": 1.4
    },
    {
      "text": "同期によって端末変更時の",
      "duration_multiplier": 1.1
    },
    {
      "text": "利用性や復旧性を高められます",
      "duration_multiplier": 1.4
    },
    {
      "text": "一方同期基盤自体の",
      "duration_multiplier": 1
    },
    {
      "text": "アクセス制御やMFA鍵の",
      "duration_multiplier": 1.2
    },
    {
      "text": "保護が重要になります",
      "duration_multiplier": 1.4
    },
    {
      "text": "「同期できるから弱い」「",
      "duration_multiplier": 1.1
    },
    {
      "text": "端末固定だから常に強い」",
      "duration_multiplier": 1.1
    },
    {
      "text": "と単純に判断せず利用目的",
      "duration_multiplier": 1.1
    },
    {
      "text": "と保証水準を踏まえて選びます",
      "duration_multiplier": 1.4
    },
    {
      "text": "チャレンジとリプレイ耐性",
      "duration_multiplier": 1.4
    },
    {
      "text": "暗号学的認証では認証の",
      "duration_multiplier": 1.1
    },
    {
      "text": "たびに異なるチャレンジや",
      "duration_multiplier": 1.1
    },
    {
      "text": "ノンスを使う方法があります",
      "duration_multiplier": 1.4
    },
    {
      "text": "過去の認証メッセージを盗",
      "duration_multiplier": 1.1
    },
    {
      "text": "んでもそのまま再利用でき",
      "duration_multiplier": 1.1
    },
    {
      "text": "ないようにします",
      "duration_multiplier": 1.4
    },
    {
      "text": "この性質をリプレイ耐性と",
      "duration_multiplier": 1.1
    },
    {
      "text": "呼びます",
      "duration_multiplier": 1.4
    },
    {
      "text": "WebAuthnなどの",
      "duration_multiplier": 1.1
    },
    {
      "text": "暗号学的認証ではこのよう",
      "duration_multiplier": 1.1
    },
    {
      "text": "なチャレンジレスポンスの",
      "duration_multiplier": 1.1
    },
    {
      "text": "仕組みが使われます",
      "duration_multiplier": 1.4
    },
    {
      "text": "パスワードは毎回同じ値を",
      "duration_multiplier": 1.1
    },
    {
      "text": "送るためそれ自体は",
      "duration_multiplier": 1
    },
    {
      "text": "リプレイ耐性を持つ認証",
      "duration_multiplier": 1.1
    },
    {
      "text": "情報とは扱われません",
      "duration_multiplier": 1.4
    }
  ]
}
