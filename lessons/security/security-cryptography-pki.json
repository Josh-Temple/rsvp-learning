    {
      "text": "ただし",
      "duration_multiplier": 1.1
    },
    {
      "text": "失効確認の方法や実装には",
      "duration_multiplier": 1.1
    },
    {
      "text": "運用上の制約があります",
      "duration_multiplier": 1.4
    },
    {
      "text": "「失効の仕組みがあるから",
      "duration_multiplier": 1.1
    },
    {
      "text": "必ず即座に無効化さ",
      "duration_multiplier": 1
    },
    {
      "text": "れる」と単純化しない",
      "duration_multiplier": 1
    },
    {
      "text": "ことが重要です",
      "duration_multiplier": 1.4
    },
    {
      "text": "HTTPSと証明書",
      "duration_multiplier": 1.4
    },
    {
      "text": "HTTPSでは",
      "duration_multiplier": 1.2
    },
    {
      "text": "TLSを使って通信を",
      "duration_multiplier": 1.2
    },
    {
      "text": "保護します",
      "duration_multiplier": 1.4
    },
    {
      "text": "サーバーは証明書を",
      "duration_multiplier": 1
    },
    {
      "text": "提示し",
      "duration_multiplier": 1.1
    },
    {
      "text": "ブラウザは証明書の署名",
      "duration_multiplier": 1.1
    },
    {
      "text": "有効期間",
      "duration_multiplier": 1.1
    },
    {
      "text": "接続先の名前などを",
      "duration_multiplier": 1
    },
    {
      "text": "検証します",
      "duration_multiplier": 1.4
    },
    {
      "text": "検証が成功すると",
      "duration_multiplier": 1.1
    },
    {
      "text": "その証明書に含まれる",
      "duration_multiplier": 1
    },
    {
      "text": "公開鍵を信頼して",
      "duration_multiplier": 1
    },
    {
      "text": "TLSの通信を確立",
      "duration_multiplier": 1.2
    },
    {
      "text": "できます",
      "duration_multiplier": 1.4
    },
    {
      "text": "ここで確認しているのは",
      "duration_multiplier": 1.1
    },
    {
      "text": "主に「この証明書が",
      "duration_multiplier": 1
    },
    {
      "text": "この接続先に対して",
      "duration_multiplier": 1
    },
    {
      "text": "信頼できるか」です",
      "duration_multiplier": 1.4
    },
    {
      "text": "Webサイトの運営者の",
      "duration_multiplier": 1.1
    },
    {
      "text": "善悪や",
      "duration_multiplier": 1.1
    },
    {
      "text": "掲載内容の正確さま",
      "duration_multiplier": 1
    },
    {
      "text": "では保証しません",
      "duration_multiplier": 1.4
    },
    {
      "text": "PKI全体を見る",
      "duration_multiplier": 1.4
    },
    {
      "text": "PKIは",
      "duration_multiplier": 1.2
    },
    {
      "text": "公開鍵証明書を発行",
      "duration_multiplier": 1.1
    },
    {
      "text": "維持",
      "duration_multiplier": 1.1
    },
    {
      "text": "失効するための技術",
      "duration_multiplier": 1.1
    },
    {
      "text": "組織",
      "duration_multiplier": 1.1
    },
    {
      "text": "方針",
      "duration_multiplier": 1.1
    },
    {
      "text": "運用を含む仕組みです",
      "duration_multiplier": 1.4
    },
    {
      "text": "PKIは暗号",
      "duration_multiplier": 1.2
    },
    {
      "text": "アルゴリズムそのもの",
      "duration_multiplier": 1
    },
    {
      "text": "ではありません",
      "duration_multiplier": 1.4
    },
    {
      "text": "鍵",
      "duration_multiplier": 1.1
    },
    {
      "text": "証明書",
      "duration_multiplier": 1.1
    },
    {
      "text": "CA",
      "duration_multiplier": 1.2
    },
    {
      "text": "検証",
      "duration_multiplier": 1.1
    },
    {
      "text": "失効などを組み合わせ",
      "duration_multiplier": 1.1
    },
    {
      "text": "公開鍵を信頼して利用",
      "duration_multiplier": 1
    },
    {
      "text": "できる環境を作る",
      "duration_multiplier": 1
    },
    {
      "text": "仕組みです",
      "duration_multiplier": 1.4
    },
    {
      "text": "信頼は技術だけでは作",
      "duration_multiplier": 1
    },
    {
      "text": "れない",
      "duration_multiplier": 1.4
    },
    {
      "text": "証明書の署名が数学的に",
      "duration_multiplier": 1.1
    },
    {
      "text": "正しくても",
      "duration_multiplier": 1.1
    },
    {
      "text": "その証明書を発行した",
      "duration_multiplier": 1
    },
    {
      "text": "CAを信頼してよいとは",
      "duration_multiplier": 1.2
    },
    {
      "text": "限りません",
      "duration_multiplier": 1.4
    },
    {
      "text": "そのためPKIでは",
      "duration_multiplier": 1.2
    },
    {
      "text": "暗号技術とともに",
      "duration_multiplier": 1.1
    },
    {
      "text": "CAの本人確認手続",
      "duration_multiplier": 1.2
    },
    {
      "text": "監査",
      "duration_multiplier": 1.1
    },
    {
      "text": "鍵管理",
      "duration_multiplier": 1.1
    },
    {
      "text": "運用規程などが重要に",
      "duration_multiplier": 1
    },
    {
      "text": "なります",
      "duration_multiplier": 1.4
    },
    {
      "text": "情報セキュリティでは",
      "duration_multiplier": 1.1
    },
    {
      "text": "暗号の強さだけでなく",
      "duration_multiplier": 1.1
    },
    {
      "text": "信頼をどのように確立",
      "duration_multiplier": 1
    },
    {
      "text": "し維持するかを見る",
      "duration_multiplier": 1
    },
    {
      "text": "必要があります",
      "duration_multiplier": 1.4
    }
  ]
}
