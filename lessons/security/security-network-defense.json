      "text": "重要です",
      "duration_multiplier": 1.4
    },
    {
      "text": "無線LAN",
      "duration_multiplier": 1.4
    },
    {
      "text": "無線LANでは適切な認証",
      "duration_multiplier": 1.2
    },
    {
      "text": "と暗号化を利用します",
      "duration_multiplier": 1.4
    },
    {
      "text": "WPA2やWPA3などの",
      "duration_multiplier": 1.2
    },
    {
      "text": "方式があります",
      "duration_multiplier": 1.4
    },
    {
      "text": "安全性は方式名だけで",
