{
  "schema_version": 1,
  "id": "web-client-server-http",
  "title": "クライアント・サーバーとHTTP",
  "topic": "Web・API",
  "summary": "ブラウザなどのクライアントとサーバーがHTTPで通信する基本構造を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "RFC 9110: HTTP Semantics",
      "url": "https://www.rfc-editor.org/rfc/rfc9110.html"
    }
  ],
  "chunks": [
    {
      "text": "ブラウザで申請一覧を開くと、",
      "duration_multiplier": 1
    },
    {
      "text": "クライアントがサーバーへHTTP要求を送ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "サーバーは認証と権限を",
      "duration_multiplier": 1
    },
    {
      "text": "確認してからデータを返します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Webシステムでは、",
      "duration_multiplier": 1
    },
    {
      "text": "クライアントとサーバーが",
      "duration_multiplier": 1
    },
    {
      "text": "通信します",
      "duration_multiplier": 1.35
    },
    {
      "text": "ブラウザは、",
      "duration_multiplier": 1
    },
    {
      "text": "代表的なクライアントです",
      "duration_multiplier": 1.15
    },
    {
      "text": "サーバーは、",
      "duration_multiplier": 1
    },
    {
      "text": "要求を受けて処理し、",
      "duration_multiplier": 1
    },
    {
      "text": "応答を返します",
      "duration_multiplier": 1.15
    },
    {
      "text": "HTTPは、",
      "duration_multiplier": 1
    },
    {
      "text": "Webで広く使われる",
      "duration_multiplier": 1
    },
    {
      "text": "通信の仕組みです",
      "duration_multiplier": 1.15
    },
    {
      "text": "クライアントは、",
      "duration_multiplier": 1
    },
    {
      "text": "HTTP Requestを",
      "duration_multiplier": 1
    },
    {
      "text": "送ります",
      "duration_multiplier": 1.15
    },
    {
      "text": "サーバーは、",
      "duration_multiplier": 1
    },
    {
      "text": "HTTP Responseを",
      "duration_multiplier": 1
    },
    {
      "text": "返します",
      "duration_multiplier": 1.15
    },
    {
      "text": "URLは、",
      "duration_multiplier": 1
    },
    {
      "text": "アクセスする資源の",
      "duration_multiplier": 1
    },
    {
      "text": "場所を示します",
      "duration_multiplier": 1.15
    },
    {
      "text": "GETは、",
      "duration_multiplier": 1
    },
    {
      "text": "情報取得に使われる",
      "duration_multiplier": 1
    },
    {
      "text": "ことが多いです",
      "duration_multiplier": 1.15
    },
    {
      "text": "POSTは、",
      "duration_multiplier": 1
    },
    {
      "text": "新しい処理や登録に",
      "duration_multiplier": 1
    },
    {
      "text": "使われることが多いです",
      "duration_multiplier": 1.15
    },
    {
      "text": "PUTやPATCHは、",
      "duration_multiplier": 1
    },
    {
      "text": "更新に使われる",
      "duration_multiplier": 1
    },
    {
      "text": "ことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "ブラウザがURLを開くと、",
      "duration_multiplier": 1
    },
    {
      "text": "サーバーへの要求と返さ",
      "duration_multiplier": 1
    },
    {
      "text": "れた応答が画面表示につながります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "DELETEは、",
      "duration_multiplier": 1
    },
    {
      "text": "削除を表すために",
      "duration_multiplier": 1
    },
    {
      "text": "使われます",
      "duration_multiplier": 1.15
    },
    {
      "text": "Status Codeは、",
      "duration_multiplier": 1
    },
    {
      "text": "処理結果の種類を",
      "duration_multiplier": 1
    },
    {
      "text": "示します",
      "duration_multiplier": 1.15
    },
    {
      "text": "Headerは、",
      "duration_multiplier": 1
    },
    {
      "text": "通信に関する",
      "duration_multiplier": 1
    },
    {
      "text": "追加情報を持ちます",
      "duration_multiplier": 1.15
    },
    {
      "text": "Bodyは、",
      "duration_multiplier": 1
    },
    {
      "text": "送受信するデータ本体を",
      "duration_multiplier": 1
    },
    {
      "text": "持つことがあります",
      "duration_multiplier": 1.35
    },
    {
      "text": "画面に表示される情報は、",
      "duration_multiplier": 1
    },
    {
      "text": "送られた応答をブラウザが処理した結果です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通信に失敗した場合と、",
      "duration_multiplier": 1
    },
    {
      "text": "サーバーがエラーを返した場合を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "URLを知っているだけで他人の",
      "duration_multiplier": 1
    },
    {
      "text": "データを見られない設計にします。",
      "duration_multiplier": 1.35
    },
    {
      "text": "通信失敗と権限による拒否は原因が違うため、",
      "duration_multiplier": 1
    },
    {
      "text": "どの段階で止まったか分けて調べます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "応答が成功でも、他人の申請が含まれたとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通信と表示が動くことは、権限の正しさと別です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "サーバーで対象ごとの閲覧権限を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "画面で隠せば情報を守れるでしょうか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "返すデータ自体を制限します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "HTTPは要求と応答で通信します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "状態は別の仕組みで管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Cookieは状態管理に使われます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "HTTPSは通信経路を保護します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "HTTPSだけで認可は保証しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "状態コードだけで成功を決めません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "応答本文も意味を持ちます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "境界ごとに責任を分けます。",
      "duration_multiplier": 1.15
    }
  ]
}
