{
  "schema_version": 1,
  "id": "api-webhook-async",
  "title": "Webhookと非同期処理",
  "topic": "Web・API",
  "summary": "イベント通知、Webhook、Queueなどを使う非同期処理の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "Stripe Docs: Webhooks",
      "url": "https://docs.stripe.com/webhooks"
    }
  ],
  "chunks": [
    {
      "text": "審査完了時に外部システムへ",
      "duration_multiplier": 1
    },
    {
      "text": "Webhookを送るとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受信側が一時的に停止していれば、",
      "duration_multiplier": 1
    },
    {
      "text": "後で再送する必要があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同期処理では、",
      "duration_multiplier": 1
    },
    {
      "text": "処理結果を待ってから",
      "duration_multiplier": 1
    },
    {
      "text": "次へ進みます",
      "duration_multiplier": 1.35
    },
    {
      "text": "非同期処理では、",
      "duration_multiplier": 1
    },
    {
      "text": "結果を待たずに",
      "duration_multiplier": 1
    },
    {
      "text": "別の処理へ進めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "時間のかかる処理では、",
      "duration_multiplier": 1
    },
    {
      "text": "非同期が有効な",
      "duration_multiplier": 1
    },
    {
      "text": "場合があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "Webhookは、",
      "duration_multiplier": 1
    },
    {
      "text": "出来事が起きた側から",
      "duration_multiplier": 1
    },
    {
      "text": "通知する仕組みです",
      "duration_multiplier": 1.15
    },
    {
      "text": "例えば、",
      "duration_multiplier": 1
    },
    {
      "text": "決済完了後に",
      "duration_multiplier": 1
    },
    {
      "text": "通知を送ることができます",
      "duration_multiplier": 1.15
    },
    {
      "text": "通知を受けるURLを、",
      "duration_multiplier": 1
    },
    {
      "text": "事前に登録します",
      "duration_multiplier": 1.15
    },
    {
      "text": "Webhookは、",
      "duration_multiplier": 1
    },
    {
      "text": "同じ通知が",
      "duration_multiplier": 1
    },
    {
      "text": "複数回来る可能性も",
      "duration_multiplier": 1
    },
    {
      "text": "考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "そのため、",
      "duration_multiplier": 1
    },
    {
      "text": "受信側には",
      "duration_multiplier": 1
    },
    {
      "text": "冪等性が重要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "Queueは、",
      "duration_multiplier": 1
    },
    {
      "text": "処理要求を一時的に",
      "duration_multiplier": 1
    },
    {
      "text": "ためる仕組みです",
      "duration_multiplier": 1.15
    },
    {
      "text": "送信側と処理側を、",
      "duration_multiplier": 1
    },
    {
      "text": "時間的に分離できます",
      "duration_multiplier": 1.15
    },
    {
      "text": "Webhookの送信は",
      "duration_multiplier": 1
    },
    {
      "text": "相手の処理完了を保証しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "再試行や失敗処理を",
      "duration_multiplier": 1
    },
    {
      "text": "設計しやすくなります",
      "duration_multiplier": 1.15
    },
    {
      "text": "一方で、",
      "duration_multiplier": 1
    },
    {
      "text": "処理状況が",
      "duration_multiplier": 1
    },
    {
      "text": "見えにくくなる",
      "duration_multiplier": 1
    },
    {
      "text": "ことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "監視とログが、",
      "duration_multiplier": 1
    },
    {
      "text": "より重要になります",
      "duration_multiplier": 1.15
    },
    {
      "text": "非同期化は、",
      "duration_multiplier": 1
    },
    {
      "text": "複雑性と引き換えに",
      "duration_multiplier": 1
    },
    {
      "text": "柔軟性を得る設計です",
      "duration_multiplier": 1.35
    },
    {
      "text": "再送で同じ通知が二度届いても、",
      "duration_multiplier": 1
    },
    {
      "text": "受付番号とイベントIDで重複を判定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "順番が入れ替わる場合は時刻だけで",
      "duration_multiplier": 1
    },
    {
      "text": "なく状態の遷移を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "送信成功と相手の処理完了を同一視しません。",
      "duration_multiplier": 1.35
    },
    {
      "text": "イベントIDで重複を見分け、",
      "duration_multiplier": 1
    },
    {
      "text": "届かなかった通知と順序が逆に",
      "duration_multiplier": 1
    },
    {
      "text": "なった通知を追えるようにします。",
      "duration_multiplier": 1.35
    },
    {
      "text": "新しい状態の通知が先に届く場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "後から古い通知で状態を戻すと誤ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "イベントIDと状態の順序を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受信時刻だけで最新状態を決められますか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "発生順と遷移の妥当性を見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "非同期では完了通知が遅れます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重複通知も想定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "順序逆転も起こり得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "イベントIDで重複を見分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "状態遷移の妥当性も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受信成功と処理成功を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "再送回数に上限を置きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "失敗を後から追えるようにします。",
      "duration_multiplier": 1.15
    }
  ]
}
