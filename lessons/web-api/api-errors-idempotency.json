{
  "schema_version": 1,
  "id": "api-errors-idempotency",
  "title": "エラー処理と冪等性",
  "topic": "Web・API",
  "summary": "APIの失敗を扱うためのStatus Code、Retry、冪等性の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "RFC 9110: HTTP Semantics",
      "url": "https://www.rfc-editor.org/rfc/rfc9110.html"
    }
  ],
  "chunks": [
    {
      "text": "申請APIへ送信した直後に",
      "duration_multiplier": 1
    },
    {
      "text": "応答がタイムアウトしたとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "サーバー側では作成済みかもしれません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "API通信は、",
      "duration_multiplier": 1
    },
    {
      "text": "常に成功するとは",
      "duration_multiplier": 1
    },
    {
      "text": "限りません",
      "duration_multiplier": 1.35
    },
    {
      "text": "入力が不正な",
      "duration_multiplier": 1
    },
    {
      "text": "場合があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限が不足している",
      "duration_multiplier": 1
    },
    {
      "text": "場合があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象データが",
      "duration_multiplier": 1
    },
    {
      "text": "存在しない場合があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "サーバー内部で",
      "duration_multiplier": 1
    },
    {
      "text": "失敗する場合もあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "HTTP Status Codeは、",
      "duration_multiplier": 1.35
    },
    {
      "text": "失敗の種類を",
      "duration_multiplier": 1
    },
    {
      "text": "伝えるために使われます",
      "duration_multiplier": 1.15
    },
    {
      "text": "4xxは、",
      "duration_multiplier": 1
    },
    {
      "text": "要求側に原因がある",
      "duration_multiplier": 1
    },
    {
      "text": "場合に使われることが",
      "duration_multiplier": 1
    },
    {
      "text": "多いです",
      "duration_multiplier": 1.15
    },
    {
      "text": "5xxは、",
      "duration_multiplier": 1
    },
    {
      "text": "サーバー側の失敗を",
      "duration_multiplier": 1
    },
    {
      "text": "表すことが多いです",
      "duration_multiplier": 1.15
    },
    {
      "text": "失敗時に、",
      "duration_multiplier": 1
    },
    {
      "text": "何でもRetryすれば",
      "duration_multiplier": 1
    },
    {
      "text": "良いわけではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ要求を再送すると、",
      "duration_multiplier": 1
    },
    {
      "text": "二重登録が起こる",
      "duration_multiplier": 1
    },
    {
      "text": "ことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "タイムアウトは、",
      "duration_multiplier": 1
    },
    {
      "text": "申請が作られなかった証拠にはなりません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "冪等性は、",
      "duration_multiplier": 1
    },
    {
      "text": "同じ要求を何度行っても、",
      "duration_multiplier": 1
    },
    {
      "text": "意図した効果が",
      "duration_multiplier": 1
    },
    {
      "text": "一度のときと",
      "duration_multiplier": 1
    },
    {
      "text": "同じになる性質です",
      "duration_multiplier": 1.25
    },
    {
      "text": "GETは、",
      "duration_multiplier": 1
    },
    {
      "text": "通常は副作用を",
      "duration_multiplier": 1
    },
    {
      "text": "持たないように設計します",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要な登録処理では、",
      "duration_multiplier": 1
    },
    {
      "text": "Idempotency Keyを",
      "duration_multiplier": 1.35
    },
    {
      "text": "使う設計もあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "エラー処理は、",
      "duration_multiplier": 1
    },
    {
      "text": "正常処理と同じくらい",
      "duration_multiplier": 1
    },
    {
      "text": "重要です",
      "duration_multiplier": 1.35
    },
    {
      "text": "同じ要求に識別子を付けて再送し、",
      "duration_multiplier": 1
    },
    {
      "text": "作成済みなら元の結果を返す設計にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "入力不備、権限不足、サーバー障害では、",
      "duration_multiplier": 1
    },
    {
      "text": "利用者や呼出し側の対応が異なります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "エラー内容と再試行の可否を分けて伝えます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "識別子で同じ要求を見分け、",
      "duration_multiplier": 1
    },
    {
      "text": "再送しても一件の結果へ収束するようにします。",
      "duration_multiplier": 1.35
    }
  ]
}
