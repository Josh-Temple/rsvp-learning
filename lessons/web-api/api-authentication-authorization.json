{
  "schema_version": 1,
  "id": "api-authentication-authorization",
  "title": "認証と認可",
  "topic": "Web・API",
  "summary": "申請APIの例で、認証と認可の違い、対象ごとの権限確認、トークンとOAuthの役割を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "RFC 6749: The OAuth 2.0 Authorization Framework",
      "url": "https://www.rfc-editor.org/rfc/rfc6749.html"
    },
    {
      "title": "RFC 9700: Best Current Practice for OAuth 2.0 Security",
      "url": "https://www.rfc-editor.org/rfc/rfc9700.html"
    },
    {
      "title": "NIST SP 800-63B-4: Authentication and Authenticator Management",
      "url": "https://csrc.nist.gov/pubs/sp/800/63/b/4/final"
    },
    {
      "title": "NIST SP 800-53 Rev. 5 Update 1",
      "url": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final"
    }
  ],
  "chunks": [
    {
      "text": "申請APIへ利用者Aが入るとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "本人確認を行うのが認証です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Aが何をできるか決めるのが認可です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証と認可は別の判断です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ログイン済みでも全件は読めません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象ごとに権限を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰が何へ何をするかで考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "画面でボタンを隠すだけでは不十分です。",
      "duration_multiplier": 1.35
    },
    {
      "text": "API側でも必ず認可します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "パスワードは認証手段の一つです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "多要素認証も認証を強めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし認可範囲は別に決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "セッションは認証状態を保てます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "アクセストークンも利用されます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "トークンの有効性を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "用途と権限の範囲も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "トークンがあるだけでは足りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象資源との関係も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "担当職員は担当案件だけとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "これは対象単位の認可です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最小権限では必要な操作だけ許します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "OAuthはアクセス委任の枠組みです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "別アプリへ限定権限を渡せます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "OAuthだけで本人確認とは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "APIキーは呼出元識別に使えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最終利用者の認証とは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "秘密情報をコードへ埋め込みません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "漏えい時に失効できる設計にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "AがBの申請IDを指定するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証済みでも閲覧は許されません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "所有関係と操作権限を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "MFA済みなら全件を読めますか。",
      "duration_multiplier": 1.15
    },
    {
      "text": "強い認証と広い認可は別です。",
      "duration_multiplier": 1.35
    },
    {
      "text": "各リクエストで境界を守ります。",
      "duration_multiplier": 1.35
    }
  ]
}
