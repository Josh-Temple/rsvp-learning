      "duration_multiplier": 1.35
    },
    {
      "text": "認可は、",
      "duration_multiplier": 1
    },
    {
      "text": "何をしてよいかを",
      "duration_multiplier": 1
    },
    {
      "text": "決めることです",
      "duration_multiplier": 1.15
    },
    {
      "text": "この二つは、",
      "duration_multiplier": 1
    },
    {
      "text": "同じではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "ログインは、",
      "duration_multiplier": 1
    },
    {
      "text": "認証の代表例です",
      "duration_multiplier": 1.15
    },
    {
      "text": "パスワードだけでなく、",
      "duration_multiplier": 1
    },
    {
      "text": "多要素認証も",
      "duration_multiplier": 1
    },
    {
      "text": "使われます",
      "duration_multiplier": 1.15
    },
    {
      "text": "セッションは、",
      "duration_multiplier": 1
    },
    {
      "text": "ログイン状態を",
      "duration_multiplier": 1
    },
    {
      "text": "維持する方法の一つです",
      "duration_multiplier": 1.15
    },
    {
      "text": "Tokenを使って、",
      "duration_multiplier": 1
    },
    {
      "text": "API呼び出しを",
      "duration_multiplier": 1
    },
    {
      "text": "認証する方法もあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "OAuthは、",
      "duration_multiplier": 1
    },
    {
      "text": "別サービスへ",
      "duration_multiplier": 1
    },
    {
      "text": "限定的な権限を",
      "duration_multiplier": 1
    },
    {
      "text": "委任するために使われます",
      "duration_multiplier": 1.15
    },
    {
      "text": "API Keyは、",
      "duration_multiplier": 1
    },
    {
      "text": "呼び出し元識別に",
      "duration_multiplier": 1
    },
    {
      "text": "使われることがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "秘密情報は、",
      "duration_multiplier": 1
    },
    {
      "text": "ソースコードへ",
      "duration_multiplier": 1
    },
    {
      "text": "直接書かないようにします",
      "duration_multiplier": 1.15
    },
    {
      "text": "認可では、",
      "duration_multiplier": 1
    },
    {
      "text": "RoleやPermissionを",
      "duration_multiplier": 1.35
    },
    {
      "text": "使うことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "最小権限は、",
      "duration_multiplier": 1
    },
    {
      "text": "必要な権限だけを",
      "duration_multiplier": 1
    },
    {
      "text": "与える考え方です",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証済みでも、",
      "duration_multiplier": 1
    },
    {
      "text": "すべての操作を",
      "duration_multiplier": 1
    },
    {
      "text": "許可してよいとは",
      "duration_multiplier": 1
    },
    {
      "text": "限りません",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要な操作ほど、",
      "duration_multiplier": 1
    },
    {
      "text": "認証と認可の両方を",
