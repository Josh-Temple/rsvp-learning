{
  "schema_version": 1,
  "id": "architecture-state-source-of-truth",
  "title": "状態管理とSingle Source of Truth",
  "topic": "ソフトウェア設計",
  "summary": "複数の場所に状態を持つ難しさと、正本を明確にする設計の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "状態は、システムが現在どの状況にあるかを表します",
      "duration_multiplier": 1.35
    },
    {
      "text": "例えば、申請中、承認済み、取消済みなどがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "同じ状態を複数の場所で管理すると、ずれが起こることがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "どの情報を正本とするかを決めます",
      "duration_multiplier": 1.1
    },
    {
      "text": "Single Source of Truthは、正しい状態の基準を一つに定める考え方です",
      "duration_multiplier": 1.1
    },
    {
      "text": "他の画面や集計表は、正本から派生させます",
      "duration_multiplier": 1.1
    },
    {
      "text": "派生データは、遅れて更新される場合があります",
      "duration_multiplier": 1.1
    },
    {
      "text": "その場合、どの程度の遅延を許すか考えます",
      "duration_multiplier": 1.1
    },
    {
      "text": "状態変更には、権限と条件を設けることがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "不正な順序で状態が変わらないようにします",
      "duration_multiplier": 1.1
    },
    {
      "text": "履歴を残すと、後から変化を追えます",
      "duration_multiplier": 1.1
    },
    {
      "text": "更新が途中で失敗した場合の扱いも決めます",
      "duration_multiplier": 1.1
    },
    {
      "text": "状態と履歴を混同しないことが重要です",
      "duration_multiplier": 1.1
    },
    {
      "text": "正本と派生情報を区別すると、復旧しやすくなります",
      "duration_multiplier": 1.35
    }
  ]
}
