{
  "schema_version": 1,
  "id": "architecture-modules-interfaces",
  "title": "モジュールとインターフェース",
  "topic": "ソフトウェア設計",
  "summary": "システムを責務ごとに分け、部品同士の接点を明確にする基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "受付機能が申請を保存し、",
      "duration_multiplier": 1
    },
    {
      "text": "通知機能が受付番号を送るとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "二つを分けるなら、通知へ渡す受付番号、",
      "duration_multiplier": 1
    },
    {
      "text": "宛先、時刻を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "大きなシステムは、",
      "duration_multiplier": 1
    },
    {
      "text": "役割ごとの部品へ",
      "duration_multiplier": 1
    },
    {
      "text": "分けて考えます",
      "duration_multiplier": 1.35
    },
    {
      "text": "モジュールは、",
      "duration_multiplier": 1
    },
    {
      "text": "関連する責務を",
      "duration_multiplier": 1
    },
    {
      "text": "まとめた単位です",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つのモジュールに",
      "duration_multiplier": 1
    },
    {
      "text": "多くの責務を",
      "duration_multiplier": 1
    },
    {
      "text": "詰め込みすぎないように",
      "duration_multiplier": 1
    },
    {
      "text": "します",
      "duration_multiplier": 1.15
    },
    {
      "text": "責務が明確だと、",
      "duration_multiplier": 1
    },
    {
      "text": "変更範囲を",
      "duration_multiplier": 1
    },
    {
      "text": "限定しやすくなります",
      "duration_multiplier": 1.15
    },
    {
      "text": "インターフェースは、",
      "duration_multiplier": 1
    },
    {
      "text": "部品同士の接点です",
      "duration_multiplier": 1.15
    },
    {
      "text": "何を受け取り、",
      "duration_multiplier": 1
    },
    {
      "text": "何を返すかを",
      "duration_multiplier": 1
    },
    {
      "text": "定めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "内部実装を知らなくても",
      "duration_multiplier": 1
    },
    {
      "text": "利用できる形が",
      "duration_multiplier": 1
    },
    {
      "text": "望まれます",
      "duration_multiplier": 1.15
    },
    {
      "text": "インターフェースを",
      "duration_multiplier": 1
    },
    {
      "text": "安定させると、",
      "duration_multiplier": 1
    },
    {
      "text": "内部変更の影響を",
      "duration_multiplier": 1
    },
    {
      "text": "減らせます",
      "duration_multiplier": 1.15
    },
    {
      "text": "データ形式や",
      "duration_multiplier": 1
    },
    {
      "text": "エラー条件も、",
      "duration_multiplier": 1
    },
    {
      "text": "接点の一部です",
      "duration_multiplier": 1.15
    },
    {
      "text": "責務の境界が",
      "duration_multiplier": 1
    },
    {
      "text": "曖昧だと、",
      "duration_multiplier": 1
    },
    {
      "text": "同じ処理が",
      "duration_multiplier": 1
    },
    {
      "text": "複数箇所へ広がります",
      "duration_multiplier": 1.15
    },
    {
      "text": "受付を保存する責務と、",
      "duration_multiplier": 1
    },
    {
      "text": "通知を届ける責務を分けても、",
      "duration_multiplier": 1
    },
    {
      "text": "受付番号の受け渡しは残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "共通処理を分ける場合も、",
      "duration_multiplier": 1
    },
    {
      "text": "責務を確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "細かく分けすぎると、",
      "duration_multiplier": 1
    },
    {
      "text": "連携が複雑になります",
      "duration_multiplier": 1.15
    },
    {
      "text": "分割には、",
      "duration_multiplier": 1
    },
    {
      "text": "適切な粒度が必要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "設計では、",
      "duration_multiplier": 1
    },
    {
      "text": "責務と接点を",
      "duration_multiplier": 1
    },
    {
      "text": "説明できることが",
      "duration_multiplier": 1
    },
    {
      "text": "重要です",
      "duration_multiplier": 1.35
    },
    {
      "text": "通知が失敗しても申請自体を消すのか、",
      "duration_multiplier": 1
    },
    {
      "text": "後で再送するのかを明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "境界を越えるデータの型と責任を揃えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "独立した部品でも全体の動きを試験します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "境界で渡す値と失敗時の扱いを決めて初めて、",
      "duration_multiplier": 1
    },
    {
      "text": "二つの部品を安全につなげられます。",
      "duration_multiplier": 1.35
    }
  ]
}
