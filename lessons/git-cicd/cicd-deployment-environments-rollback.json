    },
    {
      "title": "NIST SP 800-53 Rev. 5 Update 1",
      "url": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final"
    }
  ],
  "chunks": [
    {
      "text": "新しい版を検証環境で試し、",
      "duration_multiplier": 1
    },
    {
      "text": "本番へ反映した直後に申請失敗が増えたとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "事前に決めた指標と閾値で異常を検知し、",
      "duration_multiplier": 1
    },
    {
      "text": "影響を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "CDは、",
      "duration_multiplier": 1
    },
    {
      "text": "継続的デリバリーまたは",
      "duration_multiplier": 1
    },
    {
      "text": "継続的デプロイを",
      "duration_multiplier": 1
    },
    {
      "text": "指します",
      "duration_multiplier": 1
    },
    {
      "text": "継続的デリバリーは、",
      "duration_multiplier": 1
    },
    {
      "text": "変更をリリースできる",
      "duration_multiplier": 1
    },
    {
      "text": "状態に保つ考え方です",
      "duration_multiplier": 1
    },
    {
      "text": "継続的デプロイは、",
      "duration_multiplier": 1
    },
    {
      "text": "条件を満たした変更を",
      "duration_multiplier": 1
    },
    {
      "text": "自動で公開する",
      "duration_multiplier": 1
    },
    {
      "text": "考え方です",
      "duration_multiplier": 1.25
    },
    {
      "text": "開発環境、検証環境、",
      "duration_multiplier": 1
    },
    {
      "text": "本番環境を",
      "duration_multiplier": 1
    },
    {
      "text": "分けることがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "環境ごとに",
      "duration_multiplier": 1
    },
    {
      "text": "設定値が異なる",
      "duration_multiplier": 1
    },
    {
      "text": "場合があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "秘密情報は、",
      "duration_multiplier": 1
    },
    {
      "text": "コードへ直接",
      "duration_multiplier": 1
    },
    {
      "text": "保存しないようにします",
      "duration_multiplier": 1.15
    },
    {
      "text": "Deploymentは、",
      "duration_multiplier": 1
    },
    {
      "text": "変更を実行環境へ",
      "duration_multiplier": 1
    },
    {
      "text": "反映する作業です",
      "duration_multiplier": 1.15
    },
    {
      "text": "自動デプロイにすると、",
      "duration_multiplier": 1
    },
    {
      "text": "手作業のばらつきを",
      "duration_multiplier": 1
    },
    {
      "text": "減らせます",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "本番反映には",
      "duration_multiplier": 1
    },
    {
      "text": "承認を必要とする",
      "duration_multiplier": 1
    },
    {
      "text": "運用もあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "リリース前に、",
      "duration_multiplier": 1
    },
    {
      "text": "必要なテスト結果を",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "旧アプリへ戻す操作が成功しても、",
      "duration_multiplier": 1
    },
    {
      "text": "新しい形式へ変えた",
      "duration_multiplier": 1
    },
    {
      "text": "データと両立しない場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "リリース後には、",
      "duration_multiplier": 1
    },
    {
      "text": "正常に動いているか",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "問題があれば、",
      "duration_multiplier": 1
    },
    {
      "text": "以前の状態へ",
      "duration_multiplier": 1
    },
    {
      "text": "戻すことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "これがRollbackです",
      "duration_multiplier": 1.1
    },
    {
      "text": "データベース変更は、",
      "duration_multiplier": 1
    },
    {
      "text": "単純に戻せない",
      "duration_multiplier": 1
    },
    {
      "text": "場合があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "そのため、",
      "duration_multiplier": 1
    },
    {
      "text": "変更前に復旧手順を",
      "duration_multiplier": 1
    },
    {
      "text": "考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "CDは、",
      "duration_multiplier": 1
    },
    {
      "text": "速さより",
      "duration_multiplier": 1
    },
    {
      "text": "安全に繰り返せることが",
      "duration_multiplier": 1
    },
    {
      "text": "重要です",
      "duration_multiplier": 1.35
    },
    {
      "text": "アプリだけを旧版へ戻しても、",
      "duration_multiplier": 1
    },
    {
      "text": "変更済みのデータ形式と合わない場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "反映前にデータ変更と切戻し手順を準備します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "旧版へ戻した後も利用者の操作が",
      "duration_multiplier": 1
    },
    {
      "text": "回復したか確かめます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "切戻し可能性はアプリとデータを合わせて試し、",
      "duration_multiplier": 1
    },
    {
      "text": "戻した後の利用者操作まで確かめます。",
      "duration_multiplier": 1.35
    }
  ]
}
