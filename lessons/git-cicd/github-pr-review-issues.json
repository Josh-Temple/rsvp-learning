  "chunks": [
    {
      "text": "申請画面の不具合をIssueに記録し、",
      "duration_multiplier": 1
    },
    {
      "text": "再現手順と期待する動作を書きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "修正ブランチのPRで差分とテスト結果を示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Pull Requestは、",
      "duration_multiplier": 1
    },
    {
      "text": "変更を統合するための",
      "duration_multiplier": 1
    },
    {
      "text": "提案です",
      "duration_multiplier": 1.35
    },
    {
      "text": "変更内容を、",
      "duration_multiplier": 1
    },
    {
      "text": "差分として確認できます",
      "duration_multiplier": 1.15
    },
    {
      "text": "目的や背景を",
      "duration_multiplier": 1
    },
    {
      "text": "説明する文章も",
      "duration_multiplier": 1
    },
    {
      "text": "重要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "Reviewでは、",
      "duration_multiplier": 1
    },
    {
      "text": "コードや設計の問題を",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "動作だけでなく、",
      "duration_multiplier": 1
    },
    {
      "text": "保守性や安全性も",
      "duration_multiplier": 1
    },
    {
      "text": "見ます",
      "duration_multiplier": 1.15
    },
    {
      "text": "コメントは、",
      "duration_multiplier": 1
    },
    {
      "text": "具体的な変更箇所へ",
      "duration_multiplier": 1
    },
    {
      "text": "付けられます",
      "duration_multiplier": 1.15
    },
    {
      "text": "承認条件を、",
      "duration_multiplier": 1
    },
    {
      "text": "チームで決める",
      "duration_multiplier": 1
    },
    {
      "text": "ことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "Issueは、",
      "duration_multiplier": 1
    },
    {
      "text": "課題や要望を",
      "duration_multiplier": 1
    },
    {
      "text": "記録するために",
      "duration_multiplier": 1
    },
    {
      "text": "使えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つのIssueから",
      "duration_multiplier": 1
    },
    {
      "text": "Pull Requestへ",
      "duration_multiplier": 1
    },
    {
      "text": "つなげる運用も",
      "duration_multiplier": 1
    },
    {
      "text": "あります",
      "duration_multiplier": 1.15
    },
    {
      "text": "何を完了条件と",
      "duration_multiplier": 1
    },
    {
      "text": "するか明確にします",
      "duration_multiplier": 1.15
    },
    {
      "text": "Issueの再現条件からPRの試験",
      "duration_multiplier": 1
    },
    {
      "text": "へつなぐと、何を直したか追えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "大きな変更は、",
      "duration_multiplier": 1
    },
    {
      "text": "小さなPull Requestへ",
      "duration_multiplier": 1.35
    },
    {
      "text": "分けると",
      "duration_multiplier": 1
    },
    {
      "text": "確認しやすくなります",
      "duration_multiplier": 1.15
    },
    {
      "text": "自動テストの結果も、",
      "duration_multiplier": 1
    },
    {
      "text": "Review材料になります",
      "duration_multiplier": 1.15
    },
    {
      "text": "Review履歴は、",
      "duration_multiplier": 1
    },
    {
      "text": "意思決定の記録にも",
      "duration_multiplier": 1
    },
    {
      "text": "なります",
      "duration_multiplier": 1.15
    },
    {
      "text": "GitHubは、",
      "duration_multiplier": 1
    },
    {
      "text": "コードだけでなく",
      "duration_multiplier": 1
    },
    {
      "text": "変更管理の場として",
      "duration_multiplier": 1
    },
    {
      "text": "使えます",
      "duration_multiplier": 1.35
    },
    {
      "text": "レビューで別の入力条件を指摘さ",
      "duration_multiplier": 1
    },
    {
      "text": "れたら修正し、再度確認を受けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "PRをマージする前に、",
      "duration_multiplier": 1
    },
    {
      "text": "Issueの完了条件を満たしたか",
      "duration_multiplier": 1
    },
    {
      "text": "確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "議論とコードの変更が対応するように",
      "duration_multiplier": 1
    },
    {
      "text": "リンクを残します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "テスト通過だけで完了にせず、",
      "duration_multiplier": 1
    },
    {
      "text": "レビューで見つかった別",
      "duration_multiplier": 1
    },
    {
      "text": "条件と元の完了条件も確かめます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "PRの試験は通ったが、元の不具合は残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "試験条件がIssueの再現条件と違いました。",
      "duration_multiplier": 1.15
    },
    {
      "text": "二つを対応させて試験を追加します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "CIの緑だけでIssueを閉じられますか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "完了条件を実際に確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Issueは問題と完了条件を残します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "PRは変更と根拠を示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "レビュー範囲を明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "大きすぎる差分は分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "CI結果と人の確認を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "未解決コメントを確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "完了条件を読み戻します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "マージ後の結果も確かめます。",
      "duration_multiplier": 1.15
    }
  ]
}
