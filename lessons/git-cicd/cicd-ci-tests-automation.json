    }
  ],
  "chunks": [
    {
      "text": "CIは、",
      "duration_multiplier": 1
    },
    {
      "text": "Continuous Integration",
      "duration_multiplier": 1.35
    },
    {
      "text": "の略です",
      "duration_multiplier": 1.35
    },
    {
      "text": "変更を頻繁に統合し、",
      "duration_multiplier": 1
    },
    {
      "text": "問題を早く見つける",
      "duration_multiplier": 1
    },
    {
      "text": "考え方です",
      "duration_multiplier": 1.15
    },
    {
      "text": "コードをpushしたときに、",
      "duration_multiplier": 1
    },
    {
      "text": "自動処理を",
      "duration_multiplier": 1
    },
    {
      "text": "実行できます",
      "duration_multiplier": 1.15
    },
    {
      "text": "自動テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "代表的なCI処理です",
      "duration_multiplier": 1.15
    },
    {
      "text": "Lintや型検査を",
      "duration_multiplier": 1
    },
    {
      "text": "実行することも",
      "duration_multiplier": 1
    },
    {
      "text": "あります",
      "duration_multiplier": 1.15
    },
    {
      "text": "Buildが成功するか",
      "duration_multiplier": 1
    },
    {
      "text": "確認できます",
      "duration_multiplier": 1.15
    },
    {
      "text": "Pull Requestごとに",
      "duration_multiplier": 1.35
    },
    {
      "text": "CIを動かす",
      "duration_multiplier": 1
    },
    {
      "text": "運用があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "失敗した変更を、",
      "duration_multiplier": 1
    },
    {
      "text": "mainへ入れない",
      "duration_multiplier": 1
    },
    {
      "text": "ための条件にできます",
      "duration_multiplier": 1.15
    },
    {
      "text": "自動化すると、",
      "duration_multiplier": 1
    },
    {
      "text": "同じ検査を毎回",
      "duration_multiplier": 1
    },
    {
      "text": "同じ条件で行えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "一方で、",
      "duration_multiplier": 1
    },
    {
      "text": "自動テスト自体にも",
      "duration_multiplier": 1
    },
    {
      "text": "不具合はあり得ます",
      "duration_multiplier": 1.15
    },
    {
      "text": "不安定なテストは、",
      "duration_multiplier": 1
    },
    {
      "text": "判断を難しくします",
      "duration_multiplier": 1.15
    },
    {
      "text": "実行時間が長すぎると、",
      "duration_multiplier": 1
    },
    {
      "text": "開発速度へ",
      "duration_multiplier": 1
    },
    {
      "text": "影響します",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要な検査から",
      "duration_multiplier": 1
    },
    {
      "text": "自動化します",
      "duration_multiplier": 1.15
    },
    {
      "text": "CIは、",
      "duration_multiplier": 1
    },
    {
      "text": "問題を早い段階で",
      "duration_multiplier": 1
    },
    {
      "text": "発見する仕組みです",
      "duration_multiplier": 1.35
    },
    {
      "text": "申請画面の入力チェックを直した変更を",
      "duration_multiplier": 1
    },
    {
      "text": "PRへ出すとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "CIで構文検査と自動テストが動き、誤",
      "duration_multiplier": 1
    },
    {
      "text": "った入力を通す回帰が見つかれば失敗し",
      "duration_multiplier": 1
    },
    {
      "text": "ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "修正を追加した後、同じ検査が通ったか",
      "duration_multiplier": 1
    },
    {
      "text": "確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "テスト成功は実機での見やすさや仕様の",
      "duration_multiplier": 1
    },
    {
      "text": "妥当性まで保証しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "人のレビューと必要な環境での確認も残",
      "duration_multiplier": 1
    },
    {
      "text": "します。",
      "duration_multiplier": 1.35
    }
  ]
}
