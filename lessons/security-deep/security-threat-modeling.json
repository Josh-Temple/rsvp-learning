{
  "schema_version": 1,
  "id": "security-threat-modeling",
  "title": "脅威モデリング",
  "topic": "情報セキュリティ",
  "summary": "システムを構造化して捉え、何が起こり得るか、何をするか、十分に検討できたかを繰り返し考える脅威モデリングを学びます。",
  "created_at": "2026-10-08",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "OWASP Threat Modeling Project",
      "url": "https://owasp.org/projects/threat-modeling-project"
    },
    {
      "title": "OWASP Threat Modeling Cheat Sheet",
      "url": "https://cheatsheetseries.owasp.org/cheatsheets/Threat_Modeling_Cheat_Sheet.html"
    },
    {
      "title": "IPA 情報処理安全確保支援士試験 シラバス案 Ver.0.1",
      "url": "https://www.ipa.go.jp/shiken/syllabus/minaoshi/rcu1hd000001g5rk-att/syllabus_sc_ver0_1.pdf"
    }
  ],
  "chunks": [
    {
      "text": "脅威モデリングは設計を検討する活動です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "狙いは図を作ることだけではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "何を守るかから考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最初に対象範囲を定めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設計前提と未確定点を記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "構成要素を洗い出します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "データの流れを図にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "外部の主体も記入します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "主体や管理領域をまたぐ境界を示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "信頼水準が変わる経路も確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "次に起こり得る問題を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "STRIDEは分類の一例です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "なりすましは主体を偽る問題です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "改ざんは内容を不正に変える問題です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "否認は行為の追跡が難しい問題です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "情報漏えいは秘密が露出する問題です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "サービス妨害は利用を妨げます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限昇格は許可範囲を越えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "分類名だけでは脅威は決まりません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "資産と操作の流れに結び付けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "架空の住民申請サービスを考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "住民が申請を登録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "職員は担当分だけ閲覧します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "申請はデータベースへ保存されます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "住民と職員の権限は異なります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "他人の申請が見える恐れを検討します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "成立条件は権限確認の欠落です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証済みでも閲覧権限は別です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "影響は個人情報の不正閲覧です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対策は申請ごとの認可確認です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "画面を隠すだけでは不十分です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "API側でも権限を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "拒否されるべき要求を試験します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "試験は架空の申請データで行います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "期待結果は他人の申請の拒否です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定資料は実装の証拠ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "試験結果も記録して確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "監査ログで不正な試行を追います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ログがない場合は観測が不足します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "脅威がないとは判定できません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "担当者と改善期限を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "残るリスクを判断者へ示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "審査権限を変えた場合も見直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "委託先のAPI追加でも更新します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限以外の境界も再確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "STRIDE以外の方法も選べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Misuse Caseも候補です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Attack Treeも利用できます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "手法の選択は目的に従います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "脅威モデルは侵入試験とは別です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "コードレビューとも役割が異なります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "結果を組み合わせて改善します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最後に対策が働くか確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "図と脅威一覧を更新します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "未検証事項は未検証として残します。",
      "duration_multiplier": 1.15
    }
  ]
}
