{
  "schema_version": 1,
  "id": "security-key-secret-credential-lifecycle",
  "title": "鍵・Secret・Credentialのライフサイクル",
  "topic": "情報セキュリティ",
  "summary": "暗号鍵、API key、Password、Certificate、Service credentialを秘密情報として一括管理せず、生成から失効・破棄まで用途別に管理します。",
  "created_at": "2026-10-08",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-57 Part 1 Rev.5 Key Management",
      "url": "https://csrc.nist.gov/pubs/sp/800/57/pt1/r5/final"
    },
    {
      "title": "NIST SP 800-63B-4 Authentication and Authenticator Management",
      "url": "https://csrc.nist.gov/pubs/sp/800/63/b/4/final"
    },
    {
      "title": "IPA 新試験制度のシラバス案について",
      "url": "https://www.ipa.go.jp/shiken/syllabus/henkou/2026/20260630.html"
    }
  ],
  "chunks": [
    {
      "text": "Secretには複数の種類があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "暗号鍵があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Passwordがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "API keyがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Tokenがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Certificateの秘密鍵もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Service credentialもあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "用途を明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じSecretを使い回しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "環境間で分離します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "開発と本番を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Tenant間も必要に応じて分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "生成方法が重要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "十分なRandomnessを使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "独自乱数を避けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "発行者を明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "所有者も明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用主体を限定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限を最小化します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "保存場所を管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Source codeへ埋め込みません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Repositoryへ置きません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定Fileにも注意します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Secret managerを",
      "duration_multiplier": 1.15
    },
    {
      "text": "使う場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Hardware保護も選択肢です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用時の露出を減らします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Logへ出力しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Error messageにも注意します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Process環境も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Backup内のSecretも守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Distributionを追跡します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰へ渡したか把握します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "自動配布を使う場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "短命Credentialも有効です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "固定Secretを減らせます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Rotationを設計します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "更新可能性を事前に確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一斉失効へ備えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "古いSecretを残しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "侵害時は即時失効を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "依存Systemを把握します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "交換順序も設計します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "失効で障害を起こさないようにします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Emergency rotationも",
      "duration_multiplier": 1.15
    },
    {
      "text": "演習します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用状況を監視します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "未使用Secretを検出します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "期限切れを監視します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限超過も見直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "破棄を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Lifecycle全体を自動化と監査で支えます。",
      "duration_multiplier": 1.4
    }
  ]
}
