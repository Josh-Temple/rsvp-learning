{
  "schema_version": 1,
  "id": "security-firewall-proxy-waf-ids-ips",
  "title": "Firewall・Proxy・WAF・IDS/IPS",
  "topic": "情報セキュリティ",
  "summary": "NetworkとApplicationの防御装置を役割別に整理し、許可制御、仲介、検知、遮断を混同せず、多層防御へ配置します。",
  "created_at": "2026-10-08",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-41 Rev.1 Guidelines on Firewalls and Firewall Policy",
      "url": "https://csrc.nist.gov/pubs/sp/800/41/r1/final"
    },
    {
      "title": "CIS Critical Security Controls v8.1",
      "url": "https://www.cisecurity.org/controls/v8-1"
    },
    {
      "title": "IPA 新試験制度のシラバス案について",
      "url": "https://www.ipa.go.jp/shiken/syllabus/henkou/2026/20260630.html"
    },
    {
      "title": "NIST SP 800-94 Guide to Intrusion Detection and Prevention Systems (IDPS)",
      "url": "https://csrc.nist.gov/pubs/sp/800/94/final"
    }
  ],
  "chunks": [
    {
      "text": "通信防御は装置名だけで決まりません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "目的と配置を先に確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Firewallは通信を制御します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "送信元や宛先を条件にできます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通信方向とPortも確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Stateを見る製品もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "端末にも配置できます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "クラウドの通信制御もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Proxyは通信を仲介します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Forward proxyは利用者側です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Reverse proxyは提供側の前段です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "仲介する通信の範囲を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "WAFは主にWeb要求を検査します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "HTTPの条件で判断します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "WAFはアプリ修正の代替ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "IDSは侵入の兆候を検知します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "IPSは通信の遮断も扱います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "方式ごとに観測対象は異なります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "暗号化で内容が見えない場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "TLSの終端位置を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ログだけで全通信を知れません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "架空の申請APIを考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "公開入口にWAFを設置します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "職員が申請を照会します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "WAFのルールは稼働しています。",
      "duration_multiplier": 1.15
    },
    {
      "text": "しかし閲覧権限の確認が欠けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "WAF稼働だけでは保護できません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "API側の認可が必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "試験用の他人の申請を用意します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "その閲覧要求を安全に試験します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "期待結果はアクセス拒否です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "WAFの遮断ログも調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "アプリ側の拒否記録も調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ルール設定と有効性は別です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "入口を通らない経路も探します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "内部から直接接続できる場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "迂回経路があれば効果は限定的です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ネットワーク図を更新します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "許可ルールの所有者を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "不要な許可を整理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "例外ルールには期限を付けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更前後で通信を検証します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "正常な業務の誤遮断も見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誤検知も見逃しもあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "警告を確認する担当を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "保存するログの範囲も設計します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ログ欠損時は結論を保留します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "障害時の通過動作を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Fail openは常に許容できません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "装置停止時の業務影響も考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "管理画面と設定Backupを守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "更新と権限管理も必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "事前の設定確認だけで終えません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "模擬要求で防御動作を確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "構成変更後には再検証します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最後に残る脆弱性を記録します。",
      "duration_multiplier": 1.15
    }
  ]
}
