{
  "schema_version": 1,
  "id": "security-firewall-proxy-waf-ids-ips",
  "title": "Firewall・Proxy・WAF・IDS/IPS",
  "topic": "情報セキュリティ",
  "summary": "NetworkとApplicationの防御装置を役割別に整理し、許可制御、仲介、検知、遮断を混同せず、多層防御へ配置します。",
  "created_at": "2026-10-08",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-41 Rev.1 Guidelines on Firewalls and Firewall Policy",
      "url": "https://csrc.nist.gov/pubs/sp/800/41/r1/final"
    },
    {
      "title": "CIS Critical Security Controls v8.1",
      "url": "https://www.cisecurity.org/controls/v8-1"
    },
    {
      "title": "IPA 新試験制度のシラバス案について",
      "url": "https://www.ipa.go.jp/shiken/syllabus/henkou/2026/20260630.html"
    }
  ],
  "chunks": [
    {
      "text": "Firewallは通信を制御します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Ruleに基づいて許可します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "送信元を条件にできます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "送信先も条件にできます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ProtocolやPortも使えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Stateを追う方式もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Network境界だけに置くとは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Host側にも置けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Cloud security group",
      "duration_multiplier": 1.15
    },
    {
      "text": "も似た役割があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Proxyは通信を仲介します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Forward proxyがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Client側の通信を仲介します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Reverse proxyもあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Server側の前段に置きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証や記録を追加できます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Content制御にも使えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "WAFはWeb trafficを対象にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "HTTPの内容を見て判断します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Application脆弱性の補完に使えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "根本修正の代替にはしません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "IDSは検知を目的にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "IPSは遮断も行います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Network型があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Host型もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Signature検知があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Behavior検知もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誤検知があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "見逃しもあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "暗号化で見えにくくなる場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "TLS終端位置が影響します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Ruleの品質が重要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "不要な許可を減らします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Any許可を放置しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "期限付きRuleを管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "所有者を明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Change管理を行います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Logを有効にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし全Logが同価値ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要Ruleを監視します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "遮断イベントも調査します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Bypass経路を探します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "別Portを使える場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "直接接続できる場合もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Cloud経路も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "装置自体も資産です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "管理画面を強く守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Firmware更新も必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定Backupも守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Fail open条件を理解します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "役割と限界を組み合わせます。",
      "duration_multiplier": 1.4
    }
  ]
}
