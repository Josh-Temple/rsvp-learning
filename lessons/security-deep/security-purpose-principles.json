{
  "schema_version": 1,
  "id": "security-purpose-principles",
  "title": "セキュリティの目的と基本原則",
  "topic": "情報セキュリティ",
  "summary": "CIAを入口に、真正性、責任追跡性、最小権限、セキュア・バイ・デザインなどを結び、何を守るための原則なのかを学びます。",
  "created_at": "2026-10-08",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST Cybersecurity Framework (CSF) 2.0",
      "url": "https://www.nist.gov/cyberframework"
    },
    {
      "title": "IPA 情報処理安全確保支援士試験 シラバス案 Ver.0.1",
      "url": "https://www.ipa.go.jp/shiken/syllabus/minaoshi/rcu1hd000001g5rk-att/syllabus_sc_ver0_1.pdf"
    }
  ],
  "chunks": [
    {
      "text": "セキュリティには目的があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "秘密にするだけではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "業務を安全に続けることも目的です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "機密性は閲覧範囲を守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "完全性は正しさを守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "可用性は必要時の利用を守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "この三つをCIAと呼びます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただしCIAだけでは足りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "真正性も重要な性質です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "本物かどうかを確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "責任追跡性も重要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰が何をしたか追える状態です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "否認防止も扱われます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "行為の否定を難しくします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "信頼性も重要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "意図した働きを続ける性質です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "性質同士は衝突することがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰も使えなければ安全ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用目的との均衡が必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "絶対安全を前提にしません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "残るリスクを管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最小権限は基本原則です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要な権限だけを与えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限が強いほど影響も広がります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "セキュア・バイ・デザインがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設計段階から安全性を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "後付け対策だけに頼りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "セキュア・バイ・デフォルトも重要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "初期状態を安全側にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者任せの設定を減らします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "フェイルセキュアも考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "故障時の挙動まで設計します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "失敗時に権限を広げません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "攻撃対象領域を減らします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "不要な機能や入口を減らします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "多層防御も基本原則です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つの対策だけに依存しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "失敗を別の対策で補います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし製品数が目的ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "役割の違う対策を組み合わせます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "予防だけでは足りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検知と対応も必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "復旧も設計に含めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "組織の判断も必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "技術だけで完結しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "NIST CSFは六機能で整理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Governで統治を扱います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Identifyで状況を把握します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Protectで保護を進めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Detectで異常を見つけます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Respondで影響へ対応します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Recoverで復旧を進めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "六機能は一方向の手順ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "継続して組み合わせます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "守る目的から原則を選びます。",
      "duration_multiplier": 1.4
    }
  ]
}
