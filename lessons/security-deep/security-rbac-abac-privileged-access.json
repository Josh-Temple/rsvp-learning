{
  "schema_version": 1,
  "id": "security-rbac-abac-privileged-access",
  "title": "RBAC・ABAC・最小権限・特権管理",
  "topic": "情報セキュリティ",
  "summary": "役割と属性によるアクセス制御を使い分け、最小権限、職務分掌、特権管理、JITアクセスをLifecycleで設計します。",
  "created_at": "2026-10-08",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-63-4 Digital Identity Guidelines",
      "url": "https://csrc.nist.gov/pubs/sp/800/63/4/final"
    },
    {
      "title": "IPA 新試験制度のシラバス案について",
      "url": "https://www.ipa.go.jp/shiken/syllabus/henkou/2026/20260630.html"
    }
  ],
  "chunks": [
    {
      "text": "認可は何を許すかを決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最小権限が基本です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要な操作だけを許します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要な期間だけ許します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要な対象だけ許します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "RBACはRoleを使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "職務ごとにRoleを作ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者へRoleを割り当てます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "管理しやすい利点があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Roleが増え過ぎる問題もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "例外が積み重なる場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ABACはAttributeを使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者属性を使えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "資源属性も使えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "環境条件も使えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "柔軟な判断ができます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "属性品質が重要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "古い属性は誤認可を生みます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Policy管理も必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "RBACとABACを組み合わせる場合もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "職務分掌も重要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一人で完結させない操作があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "承認と実行を分ける場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利益相反も考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "特権は影響が大きい権限です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "管理者権限を常用しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通常IDと管理IDを分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "PAMを使う場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "特権利用を記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Credentialを保護します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "JITアクセスもあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要時だけ権限を上げます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "期限を設けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "承認を要求する場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "操作記録も残します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Break glassも設計します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "非常時だけ使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用後に必ずレビューします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Service accountも管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "人の退職では消えない点に注意します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "所有者を明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "用途を限定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "不要な権限を削ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Access reviewを行います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限棚卸しを繰り返します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "付与根拠を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用実績も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "異動時に再評価します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "例外権限に期限を付けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限Lifecycleを閉じます。",
      "duration_multiplier": 1.4
    }
  ]
}
