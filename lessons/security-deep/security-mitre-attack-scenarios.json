{
  "schema_version": 1,
  "id": "security-mitre-attack-scenarios",
  "title": "MITRE ATT&CKと攻撃シナリオ",
  "topic": "情報セキュリティ",
  "summary": "MITRE ATT&CKのtacticとtechniqueを攻撃手順書ではなく共通言語として使い、脅威シナリオ、検知、管理策、リスク評価をつなげます。",
  "created_at": "2026-10-08",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "MITRE ATT&CK Enterprise Tactics",
      "url": "https://attack.mitre.org/tactics/"
    },
    {
      "title": "MITRE ATT&CK Enterprise Matrix",
      "url": "https://attack.mitre.org/matrices/enterprise/"
    },
    {
      "title": "IPA 新試験制度のシラバス案について",
      "url": "https://www.ipa.go.jp/shiken/syllabus/henkou/2026/20260630.html"
    }
  ],
  "chunks": [
    {
      "text": "ATT&CKは攻撃行動の知識ベースです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "組織間の共通言語になります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "tacticは攻撃者の目的を表します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "techniqueは行動の方法です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "sub-techniqueは細分化した方法です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "項目名は攻撃順序を定めません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "全ての段階が現れるとは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Enterpriseと他領域を区別します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "環境ごとに適用範囲が違います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "架空の行政サービスを考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "職員に偽の通知が届きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "職員は不審メールを報告します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "これだけでは侵害は未確定です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "次に異常なログインを想定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "正規アカウントの悪用を疑います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Valid Accountsが分類候補です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "成功ログだけで断定しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通常の勤務や端末を照合します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "新しい権限付与も観測します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限変更の記録を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "異常な探索行動も調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Discoveryとの関係を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "別サービスへのアクセスも調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Lateral Movementも候補です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "外部への転送量を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Exfiltrationの可能性を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通常の連携通信かもしれません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "分類と攻撃確定は別の作業です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "複数の証拠を時系列で結びます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "メール報告と認証ログを照合します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "端末とクラウドの記録も使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "観測不能な区間を明記します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "データの未収集は無事の証拠ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "各行動に予防策を対応させます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "各行動に検知方法も対応させます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "封じ込めの判断条件を整理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "失効すべき認証情報を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "担当者が判断を記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "仮説に反する証拠も探します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "分類済みなら検知済みとは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検知ルール数は網羅率ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象ログが届くか確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "模擬イベントで警告を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検知までの遅れも記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誤検知の理由も調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "観測点が欠ければ限界を示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "新しい行動を脅威情報で確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ATT&CKはリスク得点表ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "資産と業務影響を別に評価します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "組織に重要な行動を優先します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "手法一覧を埋めても安全ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "模擬ケースの条件を変更します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象が端末からSaaSへ変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要なログや検知点も変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "攻撃の再現ではなく防御を検証します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "学んだ欠落を改善計画へ戻します。",
      "duration_multiplier": 1.15
    }
  ]
}
