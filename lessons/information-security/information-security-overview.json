  "sources": [],
  "chunks": [
    {
      "text": "情報セキュリティは、",
      "duration_multiplier": 1
    },
    {
      "text": "情報とシステムを",
      "duration_multiplier": 1
    },
    {
      "text": "適切に守るための",
      "duration_multiplier": 1
    },
    {
      "text": "分野です",
      "duration_multiplier": 1.4
    },
    {
      "text": "機密性は、",
      "duration_multiplier": 1
    },
    {
      "text": "許可された人だけが",
      "duration_multiplier": 1
    },
    {
      "text": "情報へアクセスできる",
      "duration_multiplier": 1
    },
    {
      "text": "状態です",
      "duration_multiplier": 1.15
    },
    {
      "text": "完全性は、",
      "duration_multiplier": 1
    },
    {
      "text": "情報が正確で",
      "duration_multiplier": 1
    },
    {
      "text": "不正に変更されていない",
      "duration_multiplier": 1
    },
    {
      "text": "状態です",
      "duration_multiplier": 1.15
    },
    {
      "text": "可用性は、",
      "duration_multiplier": 1
    },
    {
      "text": "必要なときに",
      "duration_multiplier": 1
    },
    {
      "text": "利用できる状態です",
      "duration_multiplier": 1.15
    },
    {
      "text": "脅威は、",
      "duration_multiplier": 1
    },
    {
      "text": "損害を起こす原因に",
      "duration_multiplier": 1
    },
    {
      "text": "なり得るものです",
      "duration_multiplier": 1.15
    },
    {
      "text": "脆弱性は、",
      "duration_multiplier": 1
    },
    {
      "text": "攻撃や事故につながる",
      "duration_multiplier": 1
    },
    {
      "text": "弱点です",
      "duration_multiplier": 1.15
    },
    {
      "text": "リスクは、",
      "duration_multiplier": 1
    },
    {
      "text": "脅威と脆弱性と影響を",
      "duration_multiplier": 1
    },
    {
      "text": "踏まえて考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証と認可は、",
      "duration_multiplier": 1
    },
    {
      "text": "アクセス制御の",
      "duration_multiplier": 1
    },
    {
      "text": "基本です",
      "duration_multiplier": 1.15
    },
    {
      "text": "暗号は、",
      "duration_multiplier": 1
    },
    {
      "text": "通信や保存データを",
      "duration_multiplier": 1
    },
    {
      "text": "守る重要な技術です",
      "duration_multiplier": 1.15
    },
    {
      "text": "ネットワーク防御だけでなく、",
      "duration_multiplier": 1
    },
    {
      "text": "人と運用の対策も",
      "duration_multiplier": 1
    },
    {
      "text": "必要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "インシデントでは、",
      "duration_multiplier": 1
    },
    {
      "text": "検知、封じ込め、",
      "duration_multiplier": 1
    },
    {
      "text": "復旧、再発防止を",
      "duration_multiplier": 1
    },
    {
      "text": "考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "この章は入口であり、",
      "duration_multiplier": 1
    },
    {
      "text": "IPA範囲を扱う本編は",
      "duration_multiplier": 1
    },
    {
      "text": "別章で拡張します",
      "duration_multiplier": 1.4
    }
  ]
}
