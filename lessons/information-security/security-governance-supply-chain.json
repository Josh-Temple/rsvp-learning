{
  "schema_version": 1,
  "id": "security-governance-supply-chain",
  "title": "セキュリティガバナンスと供給網",
  "topic": "情報セキュリティ",
  "summary": "方針、責任、例外管理、教育、指標、委託・調達、供給網、終了時の処理まで組織として管理する考え方を学びます。",
  "created_at": "2026-09-28",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST Cybersecurity Framework (CSF) 2.0",
      "url": "https://www.nist.gov/cyberframework"
    },
    {
      "title": "NIST SP 1305, CSF 2.0 Quick-Start Guide for Cybersecurity Supply Chain Risk Management",
      "url": "https://csrc.nist.gov/pubs/sp/1305/final"
    },
    {
      "title": "IPA 試験要綱・シラバスについて",
      "url": "https://www.ipa.go.jp/shiken/syllabus/gaiyou.html"
    }
  ],
  "chunks": [
    {
      "text": "セキュリティはIT部門だけの仕事ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "経営上のリスクとして扱います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "組織の目的と方針を結びます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "守る資産と優先順位を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "責任者を明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "判断権限も明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "例外承認の方法を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "例外には期限を置く場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ルールは実行可能な形にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "守れないルールを放置しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "現場の回避策も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "技術と業務を同時に見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "教育を定期的に行います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "役割ごとに内容を変えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標的型メールだけを教えません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誤送信や権限管理も扱います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "指標で状態を追います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "件数だけで良否を決めません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重大度や対応時間も見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "例外件数も改善材料です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "委託先もリスクへ含めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "契約前に要件を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "扱うデータを確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用する下請先も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "責任分界を明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "契約中も状態を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重大障害時の連絡を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "報告条件も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "終了時のデータ処理を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "アカウント停止も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "外部サービスの依存を把握します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ソフト部品の供給元も見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "更新停止のリスクもあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "供給網は自社だけで完結しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要な要件を相手へ伝えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "証明書だけで安心しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "監査結果だけでも安心しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実際の運用も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一社への集中もリスクです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "代替手段を検討します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要サービスの終了条件を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "移行に必要なデータも確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "事故や変更から方針を見直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "統治は一度作って終わりません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "技術と運用を同じ目的へ合わせます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "責任と権限を対応させます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "供給網の変化も再評価します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "組織全体で継続的に改善します。",
      "duration_multiplier": 1.15
    }
  ]
}
