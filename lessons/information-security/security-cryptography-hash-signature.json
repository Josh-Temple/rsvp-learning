  "id": "security-cryptography-hash-signature",
  "title": "暗号・ハッシュ・デジタル署名",
  "topic": "情報セキュリティ",
  "summary": "暗号化、ハッシュ、デジタル署名の役割を分け、鍵管理やパスワード保存を含めて何を守れるのかを学びます。",
  "created_at": "2026-09-28",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "FIPS 197, Advanced Encryption Standard (AES)",
      "url": "https://csrc.nist.gov/pubs/fips/197/final"
    },
    {
      "title": "FIPS 180-4, Secure Hash Standard (SHS)",
      "url": "https://csrc.nist.gov/pubs/fips/180-4/upd1/final"
    },
    {
      "title": "FIPS 186-5, Digital Signature Standard (DSS)",
      "url": "https://csrc.nist.gov/pubs/fips/186-5/final"
    },
    {
      "title": "NIST SP 800-57 Part 1 Rev. 5, Recommendation for Key Management",
      "url": "https://csrc.nist.gov/pubs/sp/800/57/pt1/r5/final"
    },
    {
      "title": "NIST SP 800-63B-4, Authentication and Authenticator Management",
      "url": "https://csrc.nist.gov/pubs/sp/800/63/b/4/final"
    }
  ],
  "chunks": [
    {
      "text": "暗号化は内容を読みにくくします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "復号には対応する鍵を使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "共通鍵方式では秘密鍵を共有します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ鍵の管理が重要になります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "公開鍵方式は鍵の役割を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "公開鍵と秘密鍵を使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "用途に応じて方式を組み合わせます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一方が常に優れるわけではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "暗号化は機密性に使われます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "改ざん検知とは目的が違います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ハッシュは要約値を作ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "入力が変われば値も変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通常は元へ戻す用途ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "完全性確認に利用できます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "パスワード保存にも使われます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "単純な高速ハッシュだけでは足りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "専用の保存方式を使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ソルトも攻撃耐性を高めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "デジタル署名は署名者を確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "データ変更の検知にも使えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "署名と暗号化は目的が違います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "秘密にしたいなら暗号化を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更を見たいなら完全性を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "署名者を見たいなら署名を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通信では複数方式を組み合わせます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "鍵交換と暗号化を分けて考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "強い方式でも鍵漏えいは危険です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "鍵管理まで含めて安全性を見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "鍵の生成も管理対象です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "保存場所も管理対象です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "配布方法も管理対象です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用権限も管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "更新と失効も管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "バックアップも慎重に扱います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "鍵ごとに用途を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "秘密鍵を共有しすぎません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "暗号方式を自作しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標準方式を適切に利用します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "乱数の品質も重要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実装ミスでも安全性は崩れます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "暗号化済みなら安全でしょうか。",
      "duration_multiplier": 1.15
    },
    {
      "text": "鍵と設定まで確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "署名済みなら内容は秘密ですか。",
      "duration_multiplier": 1.15
    },
    {
      "text": "署名は機密化を保証しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ハッシュ一致だけで送信者は分かりません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "目的に合う仕組みを選びます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "方式名だけで判断しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用まで含めて確認します。",
      "duration_multiplier": 1.15
    }
  ]
}
