{
  "schema_version": 1,
  "id": "security-authentication-access-control",
  "title": "認証・認可・アクセス制御",
  "topic": "情報セキュリティ",
  "summary": "本人確認、認可、最小権限、セッション、権限モデル、アカウントのライフサイクルを一連のアクセス制御として学びます。",
  "created_at": "2026-09-28",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-63B-4, Authentication and Authenticator Management",
      "url": "https://csrc.nist.gov/pubs/sp/800/63/b/4/final"
    },
    {
      "title": "NIST SP 800-207, Zero Trust Architecture",
      "url": "https://csrc.nist.gov/pubs/sp/800/207/final"
    }
  ],
  "chunks": [
    {
      "text": "利用者Aがログインするとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰かを確かめるのが認証です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "その前に本人確認がある場合もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証と本人確認は同じではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "何を許すか決めるのが認可です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証と認可は別の判断です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ログイン済みでも全件は読めません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象と操作ごとに確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証要素には種類があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "知っている情報があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "持っている物があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "本人の特徴も使われます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "異なる要素を組み合わせます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "多要素認証は認証を強めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ種類を二つ使うとは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "強い認証でも権限は別です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最小権限で必要分だけ許します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "役割で権限をまとめる方法があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "属性で条件を決める方法もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "方式は用途に合わせて選びます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "画面を隠すだけでは不十分です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "サーバー側でも認可します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "IDを変えた要求にも備えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "所有関係も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "セッションも管理対象です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "有効期限を設けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "失効できる仕組みを用意します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "トークンの権限範囲も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "共有アカウントは追跡を難しくします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者ごとに識別します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "異動時は権限を見直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "退職時は利用を停止します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一時権限には期限を置きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "不要な権限を残しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "定期的に実効権限を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "役割名だけでは判断しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "端末の状態も判断材料になります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "接続場所だけで信用しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "毎回必要な条件を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "継続的にアクセスを評価します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証済みなら安全でしょうか。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象と操作の認可も必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "MFA済みなら管理者ですか。",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証の強さと権限は別です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限付与には承認を残します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "剥奪まで含めて設計します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "例外権限も記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰が何をできるか追跡します。",
      "duration_multiplier": 1.15
    }
  ]
}
