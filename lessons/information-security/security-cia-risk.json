{
  "schema_version": 1,
  "id": "security-cia-risk",
  "title": "機密性・完全性・可用性とリスク",
  "topic": "情報セキュリティ",
  "summary": "情報資産、機密性・完全性・可用性、脅威・脆弱性・影響を結び、対策後に残るリスクまで考える基礎を学びます。",
  "created_at": "2026-09-28",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST Cybersecurity Framework (CSF) 2.0",
      "url": "https://www.nist.gov/cyberframework"
    },
    {
      "title": "IPA 試験要綱・シラバスについて",
      "url": "https://www.ipa.go.jp/shiken/syllabus/gaiyou.html"
    }
  ],
  "chunks": [
    {
      "text": "守る対象を資産として捉えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "情報だけが資産ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "業務やシステムも対象です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "人や設備も依存関係に入ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "機密性は閲覧範囲を守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "完全性は正しさを守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "可用性は必要時の利用を守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "三つは互いに代替できません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "暗号化だけでは停止を防げません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "バックアップだけでは漏えいを防げません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "脅威は損害の原因になり得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "攻撃者だけが脅威ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誤操作や故障や災害も含みます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "脆弱性は利用され得る弱点です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "古いソフトも弱点になります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "過剰権限も弱点になります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定ミスも弱点になります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "影響は起きた損害の大きさです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ弱点でも影響は変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "公開情報と個人情報では違います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要業務の停止なら影響も大きいです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "起こりやすさも判断材料です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つの数値だけで決めません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "資産と文脈を合わせて見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対策は目的で分けられます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "予防は発生を減らします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検知は異常を早く知るためです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "復旧は影響を短くします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つの対策だけに依存しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "多層で失敗を補い合います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対策後にもリスクは残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "残存リスクを記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回避する判断があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "低減する判断があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "移転する判断もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受容する判断もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受容には責任ある判断が要ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "環境変化で前提は変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "新しい委託先も変化です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "新しい機能も変化です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重大変更なら再評価します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "指標で対策の効き目を見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対策の存在だけでは安心しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実際の結果を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "顧客名簿を例に考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "漏えい防止だけでは足りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誤更新と停止も考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "三つの性質を同時に見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "守る対象から判断を始めます。",
      "duration_multiplier": 1.15
    }
  ]
}
