{
  "schema_version": 1,
  "id": "database-relational-model",
  "title": "リレーショナルモデルの基本",
  "topic": "データ",
  "summary": "テーブル、行、列、主キー、外部キーなどリレーショナルデータベースの基本構造を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "PostgreSQL 18 文書: 制約",
      "url": "https://www.postgresql.org/docs/18/ddl-constraints.html"
    }
  ],
  "chunks": [
    {
      "text": "リレーショナル",
      "duration_multiplier": 1
    },
    {
      "text": "データベースは、",
      "duration_multiplier": 1
    },
    {
      "text": "表の関係として",
      "duration_multiplier": 1
    },
    {
      "text": "データを扱います",
      "duration_multiplier": 1.35
    },
    {
      "text": "表を、",
      "duration_multiplier": 1
    },
    {
      "text": "テーブルと呼びます",
      "duration_multiplier": 1.15
    },
    {
      "text": "一件分のデータを、",
      "duration_multiplier": 1
    },
    {
      "text": "行として表します",
      "duration_multiplier": 1.15
    },
    {
      "text": "属性を、",
      "duration_multiplier": 1
    },
    {
      "text": "列として表します",
      "duration_multiplier": 1.15
    },
    {
      "text": "主キーは、",
      "duration_multiplier": 1
    },
    {
      "text": "行を一意に",
      "duration_multiplier": 1
    },
    {
      "text": "識別します",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ主キーを、",
      "duration_multiplier": 1
    },
    {
      "text": "複数の行で",
      "duration_multiplier": 1
    },
    {
      "text": "使わないようにします",
      "duration_multiplier": 1.15
    },
    {
      "text": "外部キーは、",
      "duration_multiplier": 1
    },
    {
      "text": "別のテーブルの行との",
      "duration_multiplier": 1
    },
    {
      "text": "関係を表します",
      "duration_multiplier": 1.15
    },
    {
      "text": "例えば、",
      "duration_multiplier": 1
    },
    {
      "text": "注文は顧客IDを",
      "duration_multiplier": 1
    },
    {
      "text": "持つことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "顧客情報を",
      "duration_multiplier": 1
    },
    {
      "text": "毎回注文表へ",
      "duration_multiplier": 1
    },
    {
      "text": "重複保存する必要は",
      "duration_multiplier": 1
    },
    {
      "text": "ありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "関係を使うことで、",
      "duration_multiplier": 1
    },
    {
      "text": "データを分けて",
      "duration_multiplier": 1
    },
    {
      "text": "管理できます",
      "duration_multiplier": 1.15
    },
    {
      "text": "NULLは、",
      "duration_multiplier": 1
    },
    {
      "text": "値が不明または",
      "duration_multiplier": 1
    },
    {
      "text": "未設定であることを",
      "duration_multiplier": 1
    },
    {
      "text": "表し、ゼロや空文字とは",
      "duration_multiplier": 1
    },
    {
      "text": "別に扱われます",
      "duration_multiplier": 1.25
    },
    {
      "text": "データ型は、",
      "duration_multiplier": 1
    },
    {
      "text": "列に入る値の種類を",
      "duration_multiplier": 1
    },
    {
      "text": "定めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "制約は、",
      "duration_multiplier": 1
    },
    {
      "text": "データの整合性を",
      "duration_multiplier": 1
    },
    {
      "text": "守るために使われます",
      "duration_multiplier": 1.15
    },
    {
      "text": "良いデータ設計は、",
      "duration_multiplier": 1
    },
    {
      "text": "業務上の関係を",
      "duration_multiplier": 1
    },
    {
      "text": "正しく表します",
      "duration_multiplier": 1.35
    },
    {
      "text": "顧客表に顧客IDと氏名、",
      "duration_multiplier": 1
    },
    {
      "text": "注文表に注文IDと顧客IDを置きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "顧客IDは顧客表の行を識別する主キーです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "注文表の顧客IDを、",
      "duration_multiplier": 1
    },
    {
      "text": "顧客表を参照する外部キーとして",
      "duration_multiplier": 1
    },
    {
      "text": "設定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一人の顧客に注文が二件あれば、",
      "duration_multiplier": 1
    },
    {
      "text": "注文表には同じ顧客IDが二行現れます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "注文IDだけで顧客名を探すには、",
      "duration_multiplier": 1
    },
    {
      "text": "二つの表の関係をたどります。",
      "duration_multiplier": 1.35
    }
  ]
}
