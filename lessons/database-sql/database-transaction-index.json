{
  "schema_version": 1,
  "id": "database-transaction-index",
  "title": "トランザクションとインデックス",
  "topic": "データ",
  "summary": "データ更新の整合性を守るトランザクションと、検索性能を支えるインデックスの基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "PostgreSQL 18 Tutorial: Transactions",
      "url": "https://www.postgresql.org/docs/18/tutorial-transactions.html"
    },
    {
      "title": "PostgreSQL 18: Concurrency Control",
      "url": "https://www.postgresql.org/docs/18/mvcc.html"
    },
    {
      "title": "PostgreSQL 18: CREATE INDEX",
      "url": "https://www.postgresql.org/docs/18/sql-createindex.html"
    }
  ],
  "chunks": [
    {
      "text": "口座AからBへ送金するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Aだけ減って処理が止まると困ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "二つの更新を一まとまりにします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "失敗時はまとめて戻します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "成功時はまとめて確定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "これがトランザクションの基本です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Atomicityは全体性を守ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "途中だけ残る状態を避けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Consistencyは整合性に関係します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "制約や処理規則も整合性を支えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Isolationは同時実行を扱います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "互いの途中状態をどう見せるか決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Durabilityは確定結果を保持します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "確定後の結果が失われにくくなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ口座へ同時入金するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "双方が古い残高を読むと危険です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一方の更新が消えることがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同時更新の扱いを設計します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "隔離の強さには違いがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "強くすれば常に最良とは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "待ち時間や競合も増え得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "次に検索性能を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "インデックスは検索を助ける構造です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "注文IDの検索などで役立ちます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし更新時にも維持が必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "保存領域も追加で使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "すべての列に付ければよくありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検索条件と利用頻度を見て決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "索引は整合性を保証しません。",
      "duration_multiplier": 1.35
    },
    {
      "text": "トランザクションとは役割が違います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "索引を増やせば競合を防げますか。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同時更新の問題は別に扱います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "検索が遅いなら実行計画も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "整合性と性能を分けて診断します。",
      "duration_multiplier": 1.35
    }
  ]
}
