{
  "schema_version": 1,
  "id": "database-normalization",
  "title": "正規化の基本",
  "topic": "データ",
  "summary": "注文と顧客の例から、更新時の矛盾、第一〜第三正規形、意図的な重複の扱いを学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "Cornell University CS 330: Database Normalization",
      "url": "https://www.cs.cornell.edu/courses/cs330/2007fa/slides/2007-09-24-CS330-Normalization.pdf"
    }
  ],
  "chunks": [
    {
      "text": "注文表に、",
      "duration_multiplier": 1
    },
    {
      "text": "注文IDと顧客ID、",
      "duration_multiplier": 1
    },
    {
      "text": "顧客名と住所を保存するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ顧客が五回注文すると、",
      "duration_multiplier": 1
    },
    {
      "text": "名前と住所も五回記録されます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "引っ越し後に一行だけ直すと、",
      "duration_multiplier": 1
    },
    {
      "text": "同じ顧客に二つの住所が残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "これは、",
      "duration_multiplier": 1
    },
    {
      "text": "更新時に生じる矛盾の例です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "顧客IDと名前、住所は",
      "duration_multiplier": 1
    },
    {
      "text": "顧客表へまとめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "注文表には、",
      "duration_multiplier": 1
    },
    {
      "text": "注文IDと顧客ID、",
      "duration_multiplier": 1
    },
    {
      "text": "注文日を残します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "顧客の住所は一か所で管理し、",
      "duration_multiplier": 1
    },
    {
      "text": "必要なときに二つの表を結びます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "このように、",
      "duration_multiplier": 1
    },
    {
      "text": "事実を適切な表へ分ける考え方が",
      "duration_multiplier": 1
    },
    {
      "text": "正規化です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "第一正規形は、",
      "duration_multiplier": 1
    },
    {
      "text": "一つの欄に複数の値や",
      "duration_multiplier": 1
    },
    {
      "text": "繰り返し項目を詰め込まない形です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "注文表の",
      "duration_multiplier": 1
    },
    {
      "text": "商品一、商品二という列より、",
      "duration_multiplier": 1
    },
    {
      "text": "注文明細を行で持ちます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "注文明細のキーを、",
      "duration_multiplier": 1
    },
    {
      "text": "注文IDと商品IDの組とします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "商品名が商品IDだけで決まるなら、",
      "duration_multiplier": 1
    },
    {
      "text": "組全体へ依存していません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "第一正規形を満たし、",
      "duration_multiplier": 1
    },
    {
      "text": "こうした部分的な依存を分けるのが",
      "duration_multiplier": 1
    },
    {
      "text": "第二正規形です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "商品名は商品表へ移し、",
      "duration_multiplier": 1
    },
    {
      "text": "明細には商品IDと数量を置けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "第三正規形では、",
      "duration_multiplier": 1
    },
    {
      "text": "非キー項目を経由する依存も整理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "注文IDから顧客IDが決まり、",
      "duration_multiplier": 1
    },
    {
      "text": "顧客IDから顧客名が決まる例です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "顧客名は注文表で繰り返さず、",
      "duration_multiplier": 1
    },
    {
      "text": "顧客表に置きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "注文時に確定した配送先や単価は、",
      "duration_multiplier": 1
    },
    {
      "text": "後日の変更と区別が必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "現在の顧客住所を参照するのか、",
      "duration_multiplier": 1
    },
    {
      "text": "当時の配送先を保存するのかを",
      "duration_multiplier": 1
    },
    {
      "text": "業務要件で決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "分割すれば必ず速くなるわけではなく、",
      "duration_multiplier": 1
    },
    {
      "text": "結合や運用の負担も増えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "性能のため意図的に重複させる場合は、",
      "duration_multiplier": 1
    },
    {
      "text": "どちらを正本とし、",
      "duration_multiplier": 1
    },
    {
      "text": "どう同期するかを決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "正規化は、",
      "duration_multiplier": 1
    },
    {
      "text": "重複を一律に消すことではなく、",
      "duration_multiplier": 1
    },
    {
      "text": "事実の意味と更新規則を揃える手段です。",
      "duration_multiplier": 1.35
    }
  ]
}
