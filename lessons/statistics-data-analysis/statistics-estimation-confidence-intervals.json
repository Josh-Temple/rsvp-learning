    },
    {
      "title": "NIST/SEMATECH e-Handbook: Confidence Limits for the Mean",
      "url": "https://www.itl.nist.gov/div898/handbook/eda/section3/eda352.htm"
    }
  ],
  "chunks": [
    {
      "text": "標本から得た値には、",
      "duration_multiplier": 1
    },
    {
      "text": "不確実性があります",
      "duration_multiplier": 1.35
    },
    {
      "text": "別の標本を取れば、",
      "duration_multiplier": 1
    },
    {
      "text": "結果は少し変わります",
      "duration_multiplier": 1.15
    },
    {
      "text": "点推定は、",
      "duration_multiplier": 1
    },
    {
      "text": "一つの値で",
      "duration_multiplier": 1
    },
    {
      "text": "母集団の特徴を",
      "duration_multiplier": 1
    },
    {
      "text": "推定します",
      "duration_multiplier": 1.15
    },
    {
      "text": "平均値の推定は、",
      "duration_multiplier": 1
    },
    {
      "text": "その代表例です",
      "duration_multiplier": 1.15
    },
    {
      "text": "信頼区間は、",
      "duration_multiplier": 1
    },
    {
      "text": "推定値の不確実性を",
      "duration_multiplier": 1
    },
    {
      "text": "区間で示します",
      "duration_multiplier": 1.25
    },
    {
      "text": "区間が狭いほど、",
      "duration_multiplier": 1
    },
    {
      "text": "推定が精密である",
      "duration_multiplier": 1
    },
    {
      "text": "場合があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "標本数が増えると、",
      "duration_multiplier": 1
    },
    {
      "text": "一般に推定精度は",
      "duration_multiplier": 1
    },
    {
      "text": "上がります",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "バイアスのある標本を",
      "duration_multiplier": 1
    },
    {
      "text": "増やしても",
      "duration_multiplier": 1
    },
    {
      "text": "問題は残ります",
      "duration_multiplier": 1.15
    },
    {
      "text": "信頼区間の解釈には、",
      "duration_multiplier": 1
    },
    {
      "text": "統計的な前提があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ手順で",
      "duration_multiplier": 1
    },
    {
      "text": "区間を作り直すと、",
      "duration_multiplier": 1
    },
    {
      "text": "指定した割合の区間が",
      "duration_multiplier": 1
    },
    {
      "text": "真の値を含む",
      "duration_multiplier": 1
    },
    {
      "text": "という意味です",
      "duration_multiplier": 1.25
    },
    {
      "text": "実務では、",
      "duration_multiplier": 1
    },
    {
      "text": "点の差だけでなく",
      "duration_multiplier": 1
    },
    {
      "text": "幅も確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "小さな差が、",
      "duration_multiplier": 1
    },
    {
      "text": "実質的に重要かも",
      "duration_multiplier": 1
    },
    {
      "text": "考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "統計的不確実性と",
      "duration_multiplier": 1
    },
    {
      "text": "業務上の重要性を",
      "duration_multiplier": 1
    },
    {
      "text": "分けます",
      "duration_multiplier": 1.15
    },
    {
      "text": "推定値には、",
      "duration_multiplier": 1
    },
    {
      "text": "どの程度の不確実性が",
      "duration_multiplier": 1
    },
    {
      "text": "あるかを添えます",
      "duration_multiplier": 1.35
    }
  ]
}
