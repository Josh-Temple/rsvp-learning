{
  "schema_version": 1,
  "id": "statistics-estimation-confidence-intervals",
  "title": "推定と信頼区間",
  "topic": "データ分析",
  "summary": "処理時間の仮例から、点推定と信頼区間の意味、反復抽出での解釈と前提を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST/SEMATECH e-Handbook: Confidence Intervals",
      "url": "https://www.itl.nist.gov/div898/handbook/prc/section1/prc14.htm"
    },
    {
      "title": "NIST/SEMATECH e-Handbook: Confidence Limits for the Mean",
      "url": "https://www.itl.nist.gov/div898/handbook/eda/section3/eda352.htm"
    }
  ],
  "chunks": [
    {
      "text": "百人の申請処理時間から、",
      "duration_multiplier": 1
    },
    {
      "text": "全体の平均を推定するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "百人の標本を得ても、",
      "duration_multiplier": 1
    },
    {
      "text": "別の百人を選べば",
      "duration_multiplier": 1
    },
    {
      "text": "値は変わり得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つの値で示すのが",
      "duration_multiplier": 1
    },
    {
      "text": "点推定です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "推定の揺れを、",
      "duration_multiplier": 1
    },
    {
      "text": "区間で示す方法が",
      "duration_multiplier": 1
    },
    {
      "text": "信頼区間です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "例えば、",
      "duration_multiplier": 1
    },
    {
      "text": "ある手順で求めた",
      "duration_multiplier": 1
    },
    {
      "text": "九五パーセント信頼区間が、",
      "duration_multiplier": 1.15
    },
    {
      "text": "八分から十二分だったとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "これは、",
      "duration_multiplier": 1
    },
    {
      "text": "今回の真の平均が",
      "duration_multiplier": 1
    },
    {
      "text": "九五パーセントの確率で、",
      "duration_multiplier": 1.15
    },
    {
      "text": "その区間にあるという意味では",
      "duration_multiplier": 1
    },
    {
      "text": "ありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ手順を何度も繰り返すと、",
      "duration_multiplier": 1
    },
    {
      "text": "作られる区間の約九五パーセントが、",
      "duration_multiplier": 1.15
    },
    {
      "text": "真の平均を含むように設計された",
      "duration_multiplier": 1
    },
    {
      "text": "方法という意味です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つの標本から得た区間は、",
      "duration_multiplier": 1
    },
    {
      "text": "真の値を含むか含まないかの",
      "duration_multiplier": 1
    },
    {
      "text": "どちらかです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "区間の幅には、",
      "duration_multiplier": 1
    },
    {
      "text": "標本数とデータのばらつきが",
      "duration_multiplier": 1
    },
    {
      "text": "影響します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標本が多いほど、",
      "duration_multiplier": 1
    },
    {
      "text": "他の条件が同じなら",
      "duration_multiplier": 1
    },
    {
      "text": "狭くなりやすくなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "偏った人だけを集めても、",
      "duration_multiplier": 1
    },
    {
      "text": "偏りは解消しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標準的な計算には、",
      "duration_multiplier": 1
    },
    {
      "text": "無作為抽出などの",
      "duration_multiplier": 1
    },
    {
      "text": "前提が必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実際には、",
      "duration_multiplier": 1
    },
    {
      "text": "対象をどう選んだかを",
      "duration_multiplier": 1
    },
    {
      "text": "先に確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "八分と十二分では、",
      "duration_multiplier": 1
    },
    {
      "text": "運用上の判断が変わるかも",
      "duration_multiplier": 1
    },
    {
      "text": "考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "区間が狭くても、",
      "duration_multiplier": 1
    },
    {
      "text": "測定方法が不適切なら",
      "duration_multiplier": 1
    },
    {
      "text": "結論は危うくなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "信頼区間は、",
      "duration_multiplier": 1
    },
    {
      "text": "個々の申請時間の大半が",
      "duration_multiplier": 1
    },
    {
      "text": "入る区間でもありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "何の平均を、",
      "duration_multiplier": 1
    },
    {
      "text": "どの標本から、",
      "duration_multiplier": 1
    },
    {
      "text": "どの方法で推定したかを示します。",
      "duration_multiplier": 1.35
    }
  ]
}
