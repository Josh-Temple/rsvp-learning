{
  "schema_version": 1,
  "id": "statistics-estimation-confidence-intervals",
  "title": "推定と信頼区間",
  "topic": "データ分析",
  "summary": "処理時間の仮例から、点推定と信頼区間の意味、反復抽出での解釈と前提を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST/SEMATECH e-Handbook: Confidence Intervals",
      "url": "https://www.itl.nist.gov/div898/handbook/prc/section1/prc14.htm"
    },
    {
      "title": "NIST/SEMATECH e-Handbook: Confidence Limits for the Mean",
      "url": "https://www.itl.nist.gov/div898/handbook/eda/section3/eda352.htm"
    }
  ],
  "chunks": [
    {
      "text": "百人の申請処理時間から、",
      "duration_multiplier": 1
    },
    {
      "text": "全体の平均を推定するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "百人の標本を得ても、",
      "duration_multiplier": 1
    },
    {
      "text": "別の百人を選べば",
      "duration_multiplier": 1
    },
    {
      "text": "値は変わり得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つの値で示すのが",
      "duration_multiplier": 1
    },
    {
      "text": "点推定です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "推定の揺れを、",
      "duration_multiplier": 1
    },
    {
      "text": "区間で示す方法が",
      "duration_multiplier": 1
    },
    {
      "text": "信頼区間です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "例えば、",
      "duration_multiplier": 1
    },
    {
      "text": "ある手順で求めた",
      "duration_multiplier": 1
    },
    {
      "text": "九五パーセント信頼区間が、",
      "duration_multiplier": 1.15
    },
    {
      "text": "八分から十二分だったとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "これは、",
      "duration_multiplier": 1
    },
    {
      "text": "今回の真の平均が",
      "duration_multiplier": 1
    },
    {
      "text": "九五パーセントの確率で、",
      "duration_multiplier": 1.15
    },
    {
      "text": "その区間にあるという意味では",
      "duration_multiplier": 1
    },
    {
      "text": "ありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ手順を何度も繰り返すと、",
      "duration_multiplier": 1
    },
    {
      "text": "作られる区間の約九五パーセントが、",
      "duration_multiplier": 1.15
    },
    {
      "text": "真の平均を含むように設計された",
      "duration_multiplier": 1
    },
    {
      "text": "方法という意味です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つの標本から得た区間は、",
      "duration_multiplier": 1
    },
    {
      "text": "真の値を含むか含まないかの",
      "duration_multiplier": 1
    },
    {
      "text": "どちらかです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "区間の幅には、",
      "duration_multiplier": 1
    },
    {
      "text": "標本数とデータのばらつきが",
      "duration_multiplier": 1
    },
    {
      "text": "影響します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標本が多いほど、",
      "duration_multiplier": 1
    },
    {
      "text": "他の条件が同じなら",
      "duration_multiplier": 1
    },
    {
      "text": "狭くなりやすくなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "偏った人だけを集めても、",
      "duration_multiplier": 1
    },
    {
      "text": "偏りは解消しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標準的な計算には、",
      "duration_multiplier": 1
    },
    {
      "text": "無作為抽出などの",
      "duration_multiplier": 1
    },
    {
      "text": "前提が必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実際には、",
      "duration_multiplier": 1
    },
    {
      "text": "対象をどう選んだかを",
      "duration_multiplier": 1
    },
    {
      "text": "先に確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "八分と十二分では、",
      "duration_multiplier": 1
    },
    {
      "text": "運用上の判断が変わるかも",
      "duration_multiplier": 1
    },
    {
      "text": "考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "区間が狭くても、",
      "duration_multiplier": 1
    },
    {
      "text": "測定方法が不適切なら",
      "duration_multiplier": 1
    },
    {
      "text": "結論は危うくなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "信頼区間は、",
      "duration_multiplier": 1
    },
    {
      "text": "個々の申請時間の大半が",
      "duration_multiplier": 1
    },
    {
      "text": "入る区間でもありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "何の平均を、",
      "duration_multiplier": 1
    },
    {
      "text": "どの標本から、",
      "duration_multiplier": 1
    },
    {
      "text": "どの方法で推定したかを示します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "標本数を増やし区間が狭くなったとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "集め方に偏りがあれば、推定はなおずれます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標本の選び方と測定を点検します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "狭い区間なら全体に当てはまりますか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "不確実性の計算と代表性は別です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "区間の幅は標本量にも影響されます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ばらつきが大きいと幅も広がります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "信頼水準を変えると幅も変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "区間は個人値の範囲ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "偏った標本は区間でも直りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "測定誤差も別に考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実務上重要な幅か確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "推定条件を結果と一緒に示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "別の架空例で区間の幅を計算します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "無作為に選んだ百件の平均処理時間は十分。",
      "duration_multiplier": 1.15
    },
    {
      "text": "母標準偏差が既知の四分と仮定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "各件が独立で、標本平均の分布は",
      "duration_multiplier": 1
    },
    {
      "text": "正規分布で扱えると仮定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "平均の標準誤差は四を百の平方根、",
      "duration_multiplier": 1
    },
    {
      "text": "つまり十で割った〇点四分です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "九五パーセント信頼区間の近似に使う",
      "duration_multiplier": 1
    },
    {
      "text": "標準正規分布の係数は一・九六。",
      "duration_multiplier": 1.15
    },
    {
      "text": "〇点四に一・九六を掛けると、",
      "duration_multiplier": 1
    },
    {
      "text": "区間の片側の幅は〇点七八四分です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "平均十分からこの幅を引き足しすると、",
      "duration_multiplier": 1
    },
    {
      "text": "約九点二二分から十点七八分。",
      "duration_multiplier": 1.15
    },
    {
      "text": "これが設定した条件での信頼区間です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ平均十分、母標準偏差四分で、",
      "duration_multiplier": 1
    },
    {
      "text": "今度は四百件を調べたと仮定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標準誤差は四を二十で割った",
      "duration_multiplier": 1
    },
    {
      "text": "〇点二分へ小さくなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一・九六を掛けた片側の幅は",
      "duration_multiplier": 1
    },
    {
      "text": "〇点三九二分です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "区間は約九点六一分から",
      "duration_multiplier": 1
    },
    {
      "text": "十点三九分へ狭くなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ここでは比較のために平均を",
      "duration_multiplier": 1
    },
    {
      "text": "同じ十分と仮定しています。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標本を増やせば実際の標本平均が",
      "duration_multiplier": 1
    },
    {
      "text": "変わらないという意味ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "母標準偏差が未知の場合は、",
      "duration_multiplier": 1
    },
    {
      "text": "通常、標本標準偏差で推定し、",
      "duration_multiplier": 1
    },
    {
      "text": "条件に合った別の区間を使います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "また、採りやすい案件に偏った標本では、",
      "duration_multiplier": 1
    },
    {
      "text": "区間が狭くても全体の平均から",
      "duration_multiplier": 1
    },
    {
      "text": "系統的にずれているかもしれません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標本の選択や、追跡できない案件も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "狭い区間が即座に良い判断を",
      "duration_multiplier": 1
    },
    {
      "text": "保証するわけではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "判断に必要な精度と前提を示します。",
      "duration_multiplier": 1.15
    }
  ]
}
