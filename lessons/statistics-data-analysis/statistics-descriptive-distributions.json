{
  "schema_version": 1,
  "id": "statistics-descriptive-distributions",
  "title": "代表値・ばらつき・分布",
  "topic": "データ分析",
  "summary": "小さな処理時間の例を使い、平均・中央値・ばらつき・分布の違いと集計時の注意を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST/SEMATECH e-Handbook: Measures of Location",
      "url": "https://www.itl.nist.gov/div898/handbook/eda/section3/eda351.htm"
    },
    {
      "title": "NIST/SEMATECH e-Handbook: Measures of Scale",
      "url": "https://www.itl.nist.gov/div898/handbook/eda/section3/eda356.htm"
    },
    {
      "title": "NIST/SEMATECH e-Handbook: Histogram",
      "url": "https://www.itl.nist.gov/div898/handbook/eda/section3/eda33e.htm"
    }
  ],
  "chunks": [
    {
      "text": "データ分析では、",
      "duration_multiplier": 1
    },
    {
      "text": "代表値だけでなく、",
      "duration_multiplier": 1
    },
    {
      "text": "ばらつきと分布も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "五件の処理時間が、",
      "duration_multiplier": 1
    },
    {
      "text": "二、三、三、四、十八分だったとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "平均は合計三十分を",
      "duration_multiplier": 1
    },
    {
      "text": "五で割り、",
      "duration_multiplier": 1
    },
    {
      "text": "六分です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "小さい順に並べた中央の値、",
      "duration_multiplier": 1
    },
    {
      "text": "中央値は三分です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "十八分の一件が、",
      "duration_multiplier": 1
    },
    {
      "text": "平均を大きく押し上げています。",
      "duration_multiplier": 1.15
    },
    {
      "text": "もし十八分が五分なら、",
      "duration_multiplier": 1
    },
    {
      "text": "平均は三点四分になります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "この二組の中央値は、",
      "duration_multiplier": 1
    },
    {
      "text": "どちらも三分です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "中央値は、",
      "duration_multiplier": 1
    },
    {
      "text": "極端な値の影響を",
      "duration_multiplier": 1
    },
    {
      "text": "平均ほど受けません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "中央値だけでは",
      "duration_multiplier": 1
    },
    {
      "text": "十八分の遅い案件を見落とします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最小値と最大値は",
      "duration_multiplier": 1
    },
    {
      "text": "両端を示しますが、",
      "duration_multiplier": 1
    },
    {
      "text": "途中の集まり方は示しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "四分位数は、",
      "duration_multiplier": 1
    },
    {
      "text": "値を並べたときの",
      "duration_multiplier": 1
    },
    {
      "text": "位置を区切る指標です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "中央の半分が広く散らばるかも",
      "duration_multiplier": 1
    },
    {
      "text": "確認できます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ヒストグラムでは、",
      "duration_multiplier": 1
    },
    {
      "text": "範囲ごとの件数を棒で示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "山の位置や複数の山、",
      "duration_multiplier": 1
    },
    {
      "text": "片側に伸びる裾を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "棒の幅を変えると、",
      "duration_multiplier": 1
    },
    {
      "text": "見え方も変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "分散は、",
      "duration_multiplier": 1
    },
    {
      "text": "平均からのずれを二乗して",
      "duration_multiplier": 1
    },
    {
      "text": "まとめたばらつきです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標準偏差は",
      "duration_multiplier": 1
    },
    {
      "text": "分散の平方根で、",
      "duration_multiplier": 1
    },
    {
      "text": "元の値と同じ単位になります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "計算方法は、",
      "duration_multiplier": 1
    },
    {
      "text": "母集団か標本かによって",
      "duration_multiplier": 1
    },
    {
      "text": "分母が異なります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "全体の速さを知りたいのか、",
      "duration_multiplier": 1
    },
    {
      "text": "遅い案件を減らしたいのかで、",
      "duration_multiplier": 1
    },
    {
      "text": "見る指標は変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "欠損をゼロ分として扱うと、",
      "duration_multiplier": 1
    },
    {
      "text": "平均を誤ることがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "十八分が入力ミスか",
      "duration_multiplier": 1
    },
    {
      "text": "実際の例外かを確認し、",
      "duration_multiplier": 1
    },
    {
      "text": "理由なく除外しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "代表値と分布を併せて、",
      "duration_multiplier": 1
    },
    {
      "text": "何が起きたかを説明します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "中央値は三分のまま、遅い案件が増えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "中央値だけでは長い待ちの悪化を見逃します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "上位の待ち時間と分布も併せて見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "代表値一つで利用者体験を示せますか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "遅い側の広がりも確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "平均と中央値は違う特徴を見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "外れ値の理由も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "分位点で遅い側を見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "分布の形を図でも確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "欠損件数を別に示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "単位と測定条件をそろえます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "全体と群別の分布を比べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "代表値だけで結論を出しません。",
      "duration_multiplier": 1.15
    }
  ]
}
