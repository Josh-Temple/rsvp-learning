{
  "schema_version": 1,
  "id": "statistics-population-sample-bias",
  "title": "母集団・標本・バイアス",
  "topic": "データ分析",
  "summary": "観測した一部のデータから全体を考えるときの標本設計とバイアスを学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "母集団は、知りたい対象全体です",
      "duration_multiplier": 1.35
    },
    {
      "text": "標本は、実際に観測した一部です",
      "duration_multiplier": 1.1
    },
    {
      "text": "標本から、母集団の特徴を推定します",
      "duration_multiplier": 1.1
    },
    {
      "text": "標本が偏っていると、推定も偏ります",
      "duration_multiplier": 1.1
    },
    {
      "text": "これを、選択バイアスとして考えることがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "回答した人だけを見ると、回答者の特徴が影響する場合があります",
      "duration_multiplier": 1.1
    },
    {
      "text": "測定方法そのものが、結果へ影響することもあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "データが多ければ、偏りが自動で消えるわけではありません",
      "duration_multiplier": 1.1
    },
    {
      "text": "誰がデータに含まれているか確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "誰が含まれていないかも確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "観測期間も重要です",
      "duration_multiplier": 1.1
    },
    {
      "text": "特定時期だけでは、季節性を誤解することがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "対象範囲を明示して結論を書きます",
      "duration_multiplier": 1.1
    },
    {
      "text": "標本の限界を説明することが、分析の信頼性につながります",
      "duration_multiplier": 1.35
    }
  ]
}
