{
  "schema_version": 1,
  "id": "statistics-population-sample-bias",
  "title": "母集団・標本・バイアス",
  "topic": "データ分析",
  "summary": "市民アンケートの例で、母集団と標本、回答者の偏り、結果を一般化できる範囲を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "AAPOR: Best Practices for Survey Research",
      "url": "https://aapor.org/standards-and-ethics/best-practices/"
    },
    {
      "title": "Statistics Canada: Questions to ask about surveys",
      "url": "https://www.statcan.gc.ca/en/customized-products-services/custom-surveys/questions-to-ask"
    },
    {
      "title": "Statistics Canada: Poststratification tests and nonresponse bias",
      "url": "https://www150.statcan.gc.ca/n1/pub/12-001-x/2016002/article/14677/02-eng.htm"
    }
  ],
  "chunks": [
    {
      "text": "市民全体の満足度を知りたいなら、",
      "duration_multiplier": 1
    },
    {
      "text": "母集団は対象の市民全体です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実際に回答した人は、",
      "duration_multiplier": 1
    },
    {
      "text": "観測された標本です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一万人へ案内し、",
      "duration_multiplier": 1
    },
    {
      "text": "千人が回答したとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "千人という件数だけでは、",
      "duration_multiplier": 1
    },
    {
      "text": "全体を代表するとは言えません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "オンラインだけで募集すると、",
      "duration_multiplier": 1
    },
    {
      "text": "使わない人が入りにくくなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "不満の強い人ほど",
      "duration_multiplier": 1
    },
    {
      "text": "答えやすい場合もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答者と非回答者で",
      "duration_multiplier": 1
    },
    {
      "text": "関心が違えば、",
      "duration_multiplier": 1
    },
    {
      "text": "回答の割合は偏り得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰を対象に含めたかと、",
      "duration_multiplier": 1
    },
    {
      "text": "誰が回答したかを分けて確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象名簿から無作為に選んでも、",
      "duration_multiplier": 1
    },
    {
      "text": "非回答があれば",
      "duration_multiplier": 1
    },
    {
      "text": "偏りは残り得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標本を増やすと、",
      "duration_multiplier": 1
    },
    {
      "text": "偶然による揺れは",
      "duration_multiplier": 1
    },
    {
      "text": "小さくなりやすくなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "しかし、",
      "duration_multiplier": 1
    },
    {
      "text": "同じ方法で偏った人だけを増やしても、",
      "duration_multiplier": 1
    },
    {
      "text": "偏りは自動で消えません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "調査方法も、",
      "duration_multiplier": 1
    },
    {
      "text": "答えやすさや回答内容へ",
      "duration_multiplier": 1
    },
    {
      "text": "影響することがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "質問に誘導的な表現がないかを",
      "duration_multiplier": 1
    },
    {
      "text": "確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "平日の昼だけ調べると、",
      "duration_multiplier": 1
    },
    {
      "text": "別の時間帯の利用者を",
      "duration_multiplier": 1
    },
    {
      "text": "見落とすかもしれません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "時期や場所が偏れば、",
      "duration_multiplier": 1
    },
    {
      "text": "結論を広げられる範囲も限られます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "既知の人口構成と比べて、",
      "duration_multiplier": 1
    },
    {
      "text": "回答者の偏りを調べる方法があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重み付けで調整しても、",
      "duration_multiplier": 1
    },
    {
      "text": "観測できない違いまで",
      "duration_multiplier": 1
    },
    {
      "text": "必ず消せるわけではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "結果には、",
      "duration_multiplier": 1
    },
    {
      "text": "対象、募集方法、",
      "duration_multiplier": 1
    },
    {
      "text": "回答者数を添えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答者の割合を、",
      "duration_multiplier": 1
    },
    {
      "text": "市民全体の割合と",
      "duration_multiplier": 1
    },
    {
      "text": "断定しないようにします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "結論は、",
      "duration_multiplier": 1
    },
    {
      "text": "実際に観測できた範囲と",
      "duration_multiplier": 1
    },
    {
      "text": "残る不確実性に合わせます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "平日昼だけ窓口で満足度を尋ねました。",
      "duration_multiplier": 1.15
    },
    {
      "text": "働く人やオンライン利用者が抜けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象集団と回答可能な人を比べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答率が高ければ代表的ですか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "届かなかった人を調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標本数と代表性は別です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "抽出方法を記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "無回答の偏りを確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "測定方法の偏りもあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象外になった人を調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "群ごとの構成を母集団と比べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重み付けにも前提があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一般化できる範囲を明示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "構成の偏りを、架空の件数で比べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一万人の市民が、A地区八千人と",
      "duration_multiplier": 1
    },
    {
      "text": "B地区二千人に分かれているとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "調査にはA地区から二百人、",
      "duration_multiplier": 1
    },
    {
      "text": "B地区から八百人が回答しました。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答者千人のうち、A地区では",
      "duration_multiplier": 1
    },
    {
      "text": "百六十人が満足と答え、",
      "duration_multiplier": 1
    },
    {
      "text": "B地区では四百人が満足と答えました。",
      "duration_multiplier": 1.15
    },
    {
      "text": "A地区の回答者の満足割合は八十パーセント、",
      "duration_multiplier": 1
    },
    {
      "text": "B地区では五十パーセントです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答者を一人ずつ等しく数えると、",
      "duration_multiplier": 1
    },
    {
      "text": "満足者は合計五百六十人。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回答者全体では五十六パーセントです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一方、市民の地区別構成を使えば、",
      "duration_multiplier": 1
    },
    {
      "text": "A地区に八割、B地区に二割の重みを置きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "八十に〇点八を掛けて六十四。",
      "duration_multiplier": 1.15
    },
    {
      "text": "五十に〇点二を掛けて十。",
      "duration_multiplier": 1.15
    },
    {
      "text": "合計は七十四パーセントです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "この値は、地区構成だけをそろえた",
      "duration_multiplier": 1
    },
    {
      "text": "補助的な推定値です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "市民全体の満足割合が",
      "duration_multiplier": 1
    },
    {
      "text": "七十四パーセントと確定したわけではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ地区でも回答者と非回答者に",
      "duration_multiplier": 1
    },
    {
      "text": "満足度の違いがあれば、偏りは残り得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "地区Aの回答率が低いこと自体も、",
      "duration_multiplier": 1
    },
    {
      "text": "無回答の偏りを疑う理由です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "調査の対象名簿、回答方法、",
      "duration_multiplier": 1
    },
    {
      "text": "未回答者の特徴を確認する必要があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "この計算では、地区の人口構成が",
      "duration_multiplier": 1
    },
    {
      "text": "正しいと仮定しています。",
      "duration_multiplier": 1.15
    },
    {
      "text": "重み付けした数値と回答者の生の割合を",
      "duration_multiplier": 1
    },
    {
      "text": "混同せず、両方の計算方法を示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "必要なら地区内の抽出・非回答に",
      "duration_multiplier": 1
    },
    {
      "text": "対応する追加の調整や調査を検討します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標本数だけでなく、代表性を確かめます。",
      "duration_multiplier": 1.15
    }
  ]
}
