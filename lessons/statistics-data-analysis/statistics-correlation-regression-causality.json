{
  "schema_version": 1,
  "id": "statistics-correlation-regression-causality",
  "title": "相関・回帰・因果関係",
  "topic": "データ分析",
  "summary": "暑さ、飲料の売上、熱中症搬送の例で、相関・回帰・因果関係の違いを学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST/SEMATECH e-Handbook: Linear Correlation Plot",
      "url": "https://www.itl.nist.gov/div898/handbook/eda/section3/eda33g.htm"
    },
    {
      "title": "NIST/SEMATECH e-Handbook: Linear Least Squares Regression",
      "url": "https://www.itl.nist.gov/div898/handbook/pmd/section1/pmd141.htm"
    },
    {
      "title": "NIST/SEMATECH e-Handbook: Experiments and Experimental Design",
      "url": "https://www.itl.nist.gov/div898/handbook/ppc/section1/ppc136.htm"
    }
  ],
  "chunks": [
    {
      "text": "暑い日に、",
      "duration_multiplier": 1
    },
    {
      "text": "冷たい飲み物の売上と",
      "duration_multiplier": 1
    },
    {
      "text": "熱中症の搬送が増えたとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "二つの値が一緒に動くことを、",
      "duration_multiplier": 1
    },
    {
      "text": "相関として捉えられます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "売上が搬送を増やしたとは",
      "duration_multiplier": 1
    },
    {
      "text": "この観察だけでは言えません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "気温が、",
      "duration_multiplier": 1
    },
    {
      "text": "両方に影響する",
      "duration_multiplier": 1
    },
    {
      "text": "第三の要因かもしれません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "搬送が多いから",
      "duration_multiplier": 1
    },
    {
      "text": "飲み物を買うという",
      "duration_multiplier": 1
    },
    {
      "text": "逆方向も考えられます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ピアソンの相関係数は、",
      "duration_multiplier": 1
    },
    {
      "text": "直線的な関係の向きと強さを",
      "duration_multiplier": 1
    },
    {
      "text": "要約します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "係数がゼロに近くても、",
      "duration_multiplier": 1
    },
    {
      "text": "曲線的な関係を",
      "duration_multiplier": 1
    },
    {
      "text": "見落とすことがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "まず散布図で、",
      "duration_multiplier": 1
    },
    {
      "text": "外れ値や関係の形を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回帰は、",
      "duration_multiplier": 1
    },
    {
      "text": "説明変数から結果の変化を",
      "duration_multiplier": 1
    },
    {
      "text": "表すモデルです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "売上と搬送の関係を、",
      "duration_multiplier": 1
    },
    {
      "text": "気温も加えて",
      "duration_multiplier": 1
    },
    {
      "text": "比べる方法があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "気温を入れれば因果関係が",
      "duration_multiplier": 1
    },
    {
      "text": "証明されるわけではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "記録していない条件や、",
      "duration_multiplier": 1
    },
    {
      "text": "測定方法の問題が",
      "duration_multiplier": 1
    },
    {
      "text": "残るからです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回帰係数は、",
      "duration_multiplier": 1
    },
    {
      "text": "モデルと含めた変数の条件で",
      "duration_multiplier": 1
    },
    {
      "text": "意味が変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "予測に役立つ変数でも、",
      "duration_multiplier": 1
    },
    {
      "text": "結果を変える原因とは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "原因を確かめるには、",
      "duration_multiplier": 1
    },
    {
      "text": "比較する集団の作り方が重要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "無作為に介入を割り当てる実験は、",
      "duration_multiplier": 1
    },
    {
      "text": "因果を調べる強い方法です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "しかし、",
      "duration_multiplier": 1
    },
    {
      "text": "実験できない場合もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "観察データを使うときは、",
      "duration_multiplier": 1
    },
    {
      "text": "選択の偏りや",
      "duration_multiplier": 1
    },
    {
      "text": "交絡の可能性を検討します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "いつ測った値かと、",
      "duration_multiplier": 1
    },
    {
      "text": "先に起きた出来事も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "結論は、",
      "duration_multiplier": 1
    },
    {
      "text": "関連を見たのか、",
      "duration_multiplier": 1
    },
    {
      "text": "原因を検証したのかを分けます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "広告を増やした週に売上も増えました。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ週に休日が重なったとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "広告以外の要因と比較条件を調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一緒に増えれば広告の効果ですか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "観察だけでは原因を確定できません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "相関の強さだけで因果を決めません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "時系列の順序も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "第三の要因を検討します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "選択の偏りもあり得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "回帰は条件付き関係を表せます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "モデル前提を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "予測精度と因果解釈を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "因果には追加の設計が必要です。",
      "duration_multiplier": 1.15
    }
  ]
}
