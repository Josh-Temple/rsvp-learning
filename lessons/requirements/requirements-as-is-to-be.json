{
  "schema_version": 1,
  "id": "requirements-as-is-to-be",
  "title": "As-IsとTo-Be",
  "topic": "システム開発",
  "summary": "現行業務を把握し、改善後の業務像を設計するためのAs-Is / To-Beの基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "As-Isは、",
      "duration_multiplier": 1
    },
    {
      "text": "現在の業務の姿です",
      "duration_multiplier": 1.35
    },
    {
      "text": "To-Beは、",
      "duration_multiplier": 1
    },
    {
      "text": "目指す業務の姿です",
      "duration_multiplier": 1.15
    },
    {
      "text": "改善では、",
      "duration_multiplier": 1
    },
    {
      "text": "最初にAs-Isを",
      "duration_multiplier": 1
    },
    {
      "text": "観察します",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰が、何を、",
      "duration_multiplier": 1
    },
    {
      "text": "どの順番で行うかを",
      "duration_multiplier": 1
    },
    {
      "text": "整理します",
      "duration_multiplier": 1.15
    },
    {
      "text": "使っている帳票や",
      "duration_multiplier": 1
    },
    {
      "text": "システムも確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "待ち時間、手戻り、",
      "duration_multiplier": 1
    },
    {
      "text": "重複入力を探します",
      "duration_multiplier": 1.15
    },
    {
      "text": "例外処理も、",
      "duration_multiplier": 1
    },
    {
      "text": "現行業務の一部です",
      "duration_multiplier": 1.15
    },
    {
      "text": "To-Beでは、",
      "duration_multiplier": 1
    },
    {
      "text": "目的から必要な変化を",
      "duration_multiplier": 1
    },
    {
      "text": "考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "単に現行業務を",
      "duration_multiplier": 1
    },
    {
      "text": "デジタル化するだけでは",
      "duration_multiplier": 1
    },
    {
      "text": "不十分です",
      "duration_multiplier": 1.15
    },
    {
      "text": "不要な工程は、",
      "duration_multiplier": 1
    },
    {
      "text": "削除できないか",
      "duration_multiplier": 1
    },
    {
      "text": "検討します",
      "duration_multiplier": 1.15
    },
    {
      "text": "自動化できる工程と、",
      "duration_multiplier": 1
    },
    {
      "text": "人が判断すべき工程を",
      "duration_multiplier": 1
    },
    {
      "text": "分けます",
      "duration_multiplier": 1.15
    },
    {
      "text": "To-Beは、",
      "duration_multiplier": 1
    },
    {
      "text": "現場で運用できる",
      "duration_multiplier": 1
    },
    {
      "text": "必要があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "移行時には、",
      "duration_multiplier": 1
    },
    {
      "text": "As-IsからTo-Beへ",
      "duration_multiplier": 1
    },
    {
      "text": "どう変えるかも",
      "duration_multiplier": 1
    },
    {
      "text": "考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "良いTo-Beは、",
      "duration_multiplier": 1
    },
    {
      "text": "改善目的と",
      "duration_multiplier": 1
    },
    {
      "text": "つながっています",
      "duration_multiplier": 1.35
    },
    {
      "text": "現状は紙の申請を窓口で受け、",
      "duration_multiplier": 1
    },
    {
      "text": "担当者が台帳へ転記するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "改善後は利用者が入力し、",
      "duration_multiplier": 1
    },
    {
      "text": "受付番号を自動で返す案を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "転記がなくなっても、",
      "duration_multiplier": 1
    },
    {
      "text": "書類不足や代理人申請の判断は残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "現状の待ち時間と誤記の発生場所を調べ、",
      "duration_multiplier": 1
    },
    {
      "text": "改善後の担当と例外処理を描きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "差分を要件へつなげます。",
      "duration_multiplier": 1.35
    }
  ]
}
