{
  "schema_version": 1,
  "id": "requirements-validation-traceability",
  "title": "要件の検証とトレーサビリティ",
  "topic": "システム開発",
  "summary": "良い要件の条件と、業務目的からテストまでのつながりを追えるようにする考え方を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "業務目的を申請の取りこぼしを減らすこととします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受付番号を発行する要件を作り、",
      "duration_multiplier": 1
    },
    {
      "text": "申請直後に番号が",
      "duration_multiplier": 1
    },
    {
      "text": "表示され記録される試験へ結びます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件は、",
      "duration_multiplier": 1
    },
    {
      "text": "書けば完成ではありません",
      "duration_multiplier": 1.35
    },
    {
      "text": "曖昧さがないか",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "実現可能か",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "他の要件と",
      "duration_multiplier": 1
    },
    {
      "text": "矛盾していないか",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "テストで確認できる",
      "duration_multiplier": 1
    },
    {
      "text": "表現か確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "使いやすいシステム、",
      "duration_multiplier": 1
    },
    {
      "text": "だけでは",
      "duration_multiplier": 1
    },
    {
      "text": "検証しにくい要件です",
      "duration_multiplier": 1.15
    },
    {
      "text": "測定条件を加えると、",
      "duration_multiplier": 1
    },
    {
      "text": "確認しやすくなります",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件には、",
      "duration_multiplier": 1
    },
    {
      "text": "優先順位も必要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "すべてを",
      "duration_multiplier": 1
    },
    {
      "text": "同じ重要度にすると",
      "duration_multiplier": 1
    },
    {
      "text": "判断できません",
      "duration_multiplier": 1.15
    },
    {
      "text": "トレーサビリティは、",
      "duration_multiplier": 1
    },
    {
      "text": "要件のつながりを",
      "duration_multiplier": 1
    },
    {
      "text": "追える性質です",
      "duration_multiplier": 1.15
    },
    {
      "text": "受付番号の表示試験が失敗したとき、",
      "duration_multiplier": 1
    },
    {
      "text": "申請の取りこぼし防止という",
      "duration_multiplier": 1
    },
    {
      "text": "目的まで影響をたどれます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "業務目的から、",
      "duration_multiplier": 1
    },
    {
      "text": "業務要件へつなげます",
      "duration_multiplier": 1.15
    },
    {
      "text": "業務要件から、",
      "duration_multiplier": 1
    },
    {
      "text": "システム要件へ",
      "duration_multiplier": 1
    },
    {
      "text": "つなげます",
      "duration_multiplier": 1.15
    },
    {
      "text": "システム要件から、",
      "duration_multiplier": 1
    },
    {
      "text": "設計やテストへ",
      "duration_multiplier": 1
    },
    {
      "text": "つなげます",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更時に",
      "duration_multiplier": 1
    },
    {
      "text": "影響範囲を確認できる",
      "duration_multiplier": 1
    },
    {
      "text": "ことが重要です",
      "duration_multiplier": 1.35
    },
    {
      "text": "試験が失敗したら、",
      "duration_multiplier": 1
    },
    {
      "text": "どの要件と目的に影響するかたどれます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "逆に目的につながらない機能は必要性を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更時には対応する試験も更新します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "目的から試験まで対応を残すと、",
      "duration_multiplier": 1
    },
    {
      "text": "変更時に直す箇所と確認し直す条件が分かります。",
      "duration_multiplier": 1.35
    }
  ]
}
