{
  "schema_version": 1,
  "id": "requirements-validation-traceability",
  "title": "要件の検証とトレーサビリティ",
  "topic": "システム開発",
  "summary": "良い要件の条件と、業務目的からテストまでのつながりを追えるようにする考え方を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "申請の取りこぼしを減らすとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受付番号の発行を要件にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし表示だけでは不十分です。",
      "duration_multiplier": 1.35
    },
    {
      "text": "保存まで確認できる形にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件は書けば完成ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "曖昧さと矛盾を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実現可能性も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "試験できる表現にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "「使いやすい」だけでは曖昧です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰が何をできるか具体化します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受入条件は合否の条件を示します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "条件は観測できる形にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "優先順位も明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "すべてを最優先にはできません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "トレーサビリティはつながりを追います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "業務目的から業務要件へつなぎます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "業務要件からシステム要件へ進みます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件から設計と試験へつなぎます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "逆向きにも理由をたどります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "目的につながらない機能を見直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更時は影響範囲を追います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件を変えたら試験も見直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "試験失敗から関連要件をたどります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "関連要件から業務目的を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "番号が表示されても保存されないとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "表示だけの試験では見逃します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "保存記録まで確認する必要があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "次に通知機能を追加するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "目的が同じか別かを確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "別目的なら対応関係を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一つの試験で全部を証明しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "目的ごとに必要な結果を確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "画面が通れば十分でしょうか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "業務目的まで届く結果を確認します。",
      "duration_multiplier": 1.15
    }
  ]
}
