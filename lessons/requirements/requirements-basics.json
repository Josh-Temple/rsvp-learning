{
  "schema_version": 1,
  "id": "requirements-basics",
  "title": "要件定義の基礎",
  "topic": "システム開発",
  "summary": "要件定義の目的、業務要件とシステム要件、機能・非機能、関係者、スコープ、検証可能性を一つの流れで整理する入口教材です。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "要件定義は実装前の整理です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "何を実現するかを明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "最初に業務目的を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "技術名から始めません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "現状業務を理解します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "誰が何をするかを見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "どこで困っているかを見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "改善後の結果を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "業務要件を整理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "業務要件は達成したい結果です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "次にSystem要件へ落とします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "System要件は実現条件です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "機能要件があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "何をするかを表します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "非機能要件もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "どの品質で動くかを表します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "性能も非機能要件です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "可用性も含まれます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Securityも含まれます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用性も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者だけが関係者ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "現場職員も関係します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "管理者も関係します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "保守担当も関係します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "外部事業者も関係します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "要望と要件を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "要望をそのまま採用しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "目的との関係を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "何を作らないかも決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Scopeを明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "対象外も明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "優先順位を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "すべてを一度に作りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "曖昧な表現を減らします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "確認可能な条件へ変えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "使いやすいだけでは曖昧です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "観測できる条件へ具体化します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件同士の矛盾を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実現可能性も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "根拠を追えるようにします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "業務目的へ戻れるようにします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設計へつなげます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Testへもつなげます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更時の影響も追います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件は書けば終わりではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "関係者と認識を合わせます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更理由も記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "目的から条件へ変換します。",
      "duration_multiplier": 1.15
    }
  ]
}
