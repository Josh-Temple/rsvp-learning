    {
      "text": "申請APIが止まってもデータが",
      "duration_multiplier": 1
    },
    {
      "text": "無事なら十分とは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "復旧まで許される時間と、",
      "duration_multiplier": 1
    },
    {
      "text": "失ってよいデータの範囲を先に決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "クラウドでは、",
      "duration_multiplier": 1
    },
    {
      "text": "データの置き場所も",
      "duration_multiplier": 1
    },
    {
      "text": "用途に応じて",
      "duration_multiplier": 1
    },
    {
      "text": "選びます",
      "duration_multiplier": 1.35
    },
    {
      "text": "ファイル向けの",
      "duration_multiplier": 1
    },
    {
      "text": "Object Storageが",
      "duration_multiplier": 1.35
    },
    {
      "text": "あります",
      "duration_multiplier": 1.15
    },
    {
      "text": "構造化データには、",
      "duration_multiplier": 1
    },
    {
      "text": "データベースを",
      "duration_multiplier": 1
    },
    {
      "text": "使うことが多いです",
      "duration_multiplier": 1.15
    },
    {
      "text": "保存場所が違えば、",
      "duration_multiplier": 1
    },
    {
      "text": "性能や費用も",
      "duration_multiplier": 1
    },
    {
      "text": "変わります",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要データには、",
      "duration_multiplier": 1
    },
    {
      "text": "バックアップが必要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "バックアップは、",
      "duration_multiplier": 1
    },
    {
      "text": "作るだけでなく",
      "duration_multiplier": 1
    },
    {
      "text": "復元できるか",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "可用性は、",
      "duration_multiplier": 1
    },
    {
      "text": "必要なときに",
      "duration_multiplier": 1
    },
    {
      "text": "サービスを使える",
      "duration_multiplier": 1
    },
    {
      "text": "度合いです",
      "duration_multiplier": 1.15
    },
    {
      "text": "単一障害点を",
      "duration_multiplier": 1
    },
    {
      "text": "減らすために、",
      "duration_multiplier": 1
    },
    {
      "text": "冗長化を考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "複数の障害領域へ",
      "duration_multiplier": 1
    },
    {
      "text": "分散する設計も",
      "duration_multiplier": 1
    },
    {
      "text": "あります",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし、",
      "duration_multiplier": 1
    },
    {
      "text": "冗長化すると",
      "duration_multiplier": 1
    },
    {
      "text": "構成と費用は",
      "duration_multiplier": 1
    },
    {
      "text": "増えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "画面が開くだけの監視では、",
      "duration_multiplier": 1
    },
    {
      "text": "申請を保存できない障害を見逃す場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "監視では、",
      "duration_multiplier": 1
    },
    {
      "text": "CPUなどの資源だけを",
      "duration_multiplier": 1
    },
    {
      "text": "見るわけではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "エラー率、応答時間、",
      "duration_multiplier": 1
    },
    {
      "text": "業務処理数も",
      "duration_multiplier": 1
    },
    {
      "text": "重要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "ログとメトリクスを",
      "duration_multiplier": 1
    },
    {
      "text": "組み合わせて",
      "duration_multiplier": 1
    },
    {
      "text": "状態を把握します",
      "duration_multiplier": 1.15
    },
    {
      "text": "可用性は、",
      "duration_multiplier": 1
    },
    {
      "text": "技術設計と運用設計の",
      "duration_multiplier": 1
    },
    {
      "text": "両方で作ります",
      "duration_multiplier": 1.35
    },
    {
      "text": "稼働監視では画面が開くかだけでなく、",
      "duration_multiplier": 1
    },
    {
      "text": "申請を最後まで送れるかを確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "遅延、エラー、依存先の異常を",
      "duration_multiplier": 1
    },
    {
      "text": "時刻とともに記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "バックアップから戻せることも実際に試します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "復旧目標を満たせるかは、",
      "duration_multiplier": 1
    },
    {
      "text": "バックアップの存在だけで",
      "duration_multiplier": 1
    },
    {
      "text": "なく復元手順の実行で確かめます。",
      "duration_multiplier": 1.35
    }
  ]
