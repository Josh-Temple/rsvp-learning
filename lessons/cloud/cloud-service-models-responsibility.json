{
  "schema_version": 1,
  "id": "cloud-service-models-responsibility",
  "title": "クラウドのサービスモデルと責任分界",
  "topic": "クラウド",
  "summary": "IaaS・PaaS・SaaSと、利用者側・提供者側の責任分界を整理します。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-145: The NIST Definition of Cloud Computing",
      "url": "https://csrc.nist.gov/pubs/sp/800/145/final"
    },
    {
      "title": "NIST SP 500-292: NIST Cloud Computing Reference Architecture",
      "url": "https://www.nist.gov/publications/nist-cloud-computing-reference-architecture"
    }
  ],
  "chunks": [
    {
      "text": "申請管理をSaaSで使う場合、",
      "duration_multiplier": 1
    },
    {
      "text": "利用者はアカウントや共有設定を",
      "duration_multiplier": 1
    },
    {
      "text": "管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "PaaSで自作アプリを動かす場合は、",
      "duration_multiplier": 1
    },
    {
      "text": "アプリとデータを管理し、",
      "duration_multiplier": 1
    },
    {
      "text": "実行基盤の管理範囲を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "クラウドでは、",
      "duration_multiplier": 1
    },
    {
      "text": "どこまでを自分で",
      "duration_multiplier": 1
    },
    {
      "text": "管理するかが",
      "duration_multiplier": 1
    },
    {
      "text": "重要です",
      "duration_multiplier": 1.35
    },
    {
      "text": "IaaSは、",
      "duration_multiplier": 1
    },
    {
      "text": "仮想マシンや",
      "duration_multiplier": 1
    },
    {
      "text": "ネットワークなど",
      "duration_multiplier": 1
    },
    {
      "text": "基盤に近い資源を",
      "duration_multiplier": 1
    },
    {
      "text": "利用します",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者は、",
      "duration_multiplier": 1
    },
    {
      "text": "OSやアプリを",
      "duration_multiplier": 1
    },
    {
      "text": "管理する場面が",
      "duration_multiplier": 1
    },
    {
      "text": "多くなります",
      "duration_multiplier": 1.15
    },
    {
      "text": "PaaSは、",
      "duration_multiplier": 1
    },
    {
      "text": "アプリ実行環境まで",
      "duration_multiplier": 1
    },
    {
      "text": "提供される形です",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者は、",
      "duration_multiplier": 1
    },
    {
      "text": "基盤管理を減らして",
      "duration_multiplier": 1
    },
    {
      "text": "アプリへ集中できます",
      "duration_multiplier": 1.15
    },
    {
      "text": "SaaSは、",
      "duration_multiplier": 1
    },
    {
      "text": "完成したソフトウェアを",
      "duration_multiplier": 1
    },
    {
      "text": "サービスとして",
      "duration_multiplier": 1
    },
    {
      "text": "利用します",
      "duration_multiplier": 1.15
    },
    {
      "text": "サービスモデルが",
      "duration_multiplier": 1
    },
    {
      "text": "変わると、",
      "duration_multiplier": 1
    },
    {
      "text": "管理責任も変わります",
      "duration_multiplier": 1.15
    },
    {
      "text": "クラウド事業者が",
      "duration_multiplier": 1
    },
    {
      "text": "すべてを守ってくれる",
      "duration_multiplier": 1
    },
    {
      "text": "わけではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者側には、",
      "duration_multiplier": 1
    },
    {
      "text": "設定や権限管理の",
      "duration_multiplier": 1
    },
    {
      "text": "責任が残ります",
      "duration_multiplier": 1.15
    },
    {
      "text": "これを、",
      "duration_multiplier": 1
    },
    {
      "text": "責任共有モデルとして",
      "duration_multiplier": 1
    },
    {
      "text": "考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "サービスが提供する層が増えるほど、",
      "duration_multiplier": 1
    },
    {
      "text": "利用者が直接管理する基盤の範囲は変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "どの層を",
      "duration_multiplier": 1
    },
    {
      "text": "誰が管理するかを",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "障害対応でも、",
      "duration_multiplier": 1
    },
    {
      "text": "責任分界が重要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "契約やサービス仕様も、",
      "duration_multiplier": 1
    },
    {
      "text": "責任範囲へ",
      "duration_multiplier": 1
    },
    {
      "text": "影響します",
      "duration_multiplier": 1.15
    },
    {
      "text": "クラウド選定では、",
      "duration_multiplier": 1
    },
    {
      "text": "便利さだけでなく",
      "duration_multiplier": 1
    },
    {
      "text": "責任範囲を見ます",
      "duration_multiplier": 1.35
    },
    {
      "text": "IaaSの仮想マシンで動かす場合は、",
      "duration_multiplier": 1
    },
    {
      "text": "OS更新やアプリ保守も",
      "duration_multiplier": 1
    },
    {
      "text": "担当範囲に入ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "いずれも権限設定は",
      "duration_multiplier": 1
    },
    {
      "text": "利用者側の課題であり、",
      "duration_multiplier": 1
    },
    {
      "text": "契約と構成に沿って責任分界を",
      "duration_multiplier": 1
    },
    {
      "text": "確認します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "どの方式でも権限やデータの扱いが残るため、",
      "duration_multiplier": 1
    },
    {
      "text": "責任分界は実際の契約と設定で確かめます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "SaaSへ移すと、OS更新は提供者の範囲です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一方、共有設定の誤りは利用者が直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "契約と設定で担当する層を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "基盤を任せればデータ管理も不要ですか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "権限と利用方法の管理は残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "責任分界はサービスごとに確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "同じ分類でも提供範囲は違います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定責任は利用者側に残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "データ分類も利用者が行います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "契約と技術設定を両方見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "委託しても説明責任は残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "障害時の連絡経路も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "責任の空白を作らないようにします。",
      "duration_multiplier": 1.15
    }
  ]
}
