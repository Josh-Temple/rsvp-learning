{
  "schema_version": 1,
  "id": "cloud-service-models-responsibility",
  "title": "クラウドのサービスモデルと責任分界",
  "topic": "クラウド",
  "summary": "IaaS・PaaS・SaaSと、利用者側・提供者側の責任分界を整理します。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-145: The NIST Definition of Cloud Computing",
      "url": "https://csrc.nist.gov/pubs/sp/800/145/final"
    },
    {
      "title": "NIST SP 500-292: NIST Cloud Computing Reference Architecture",
      "url": "https://www.nist.gov/publications/nist-cloud-computing-reference-architecture"
    }
  ],
  "chunks": [
    {
      "text": "クラウドでは、",
      "duration_multiplier": 1
    },
    {
      "text": "どこまでを自分で",
      "duration_multiplier": 1
    },
    {
      "text": "管理するかが",
      "duration_multiplier": 1
    },
    {
      "text": "重要です",
      "duration_multiplier": 1.35
    },
    {
      "text": "IaaSは、",
      "duration_multiplier": 1
    },
    {
      "text": "仮想マシンや",
      "duration_multiplier": 1
    },
    {
      "text": "ネットワークなど",
      "duration_multiplier": 1
    },
    {
      "text": "基盤に近い資源を",
      "duration_multiplier": 1
    },
    {
      "text": "利用します",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者は、",
      "duration_multiplier": 1
    },
    {
      "text": "OSやアプリを",
      "duration_multiplier": 1
    },
    {
      "text": "管理する場面が",
      "duration_multiplier": 1
    },
    {
      "text": "多くなります",
      "duration_multiplier": 1.15
    },
    {
      "text": "PaaSは、",
      "duration_multiplier": 1
    },
    {
      "text": "アプリ実行環境まで",
      "duration_multiplier": 1
    },
    {
      "text": "提供される形です",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者は、",
      "duration_multiplier": 1
    },
    {
      "text": "基盤管理を減らして",
      "duration_multiplier": 1
    },
    {
      "text": "アプリへ集中できます",
      "duration_multiplier": 1.15
    },
    {
      "text": "SaaSは、",
      "duration_multiplier": 1
    },
    {
      "text": "完成したソフトウェアを",
      "duration_multiplier": 1
    },
    {
      "text": "サービスとして",
      "duration_multiplier": 1
    },
    {
      "text": "利用します",
      "duration_multiplier": 1.15
    },
    {
      "text": "サービスモデルが",
      "duration_multiplier": 1
    },
    {
      "text": "変わると、",
      "duration_multiplier": 1
    },
    {
      "text": "管理責任も変わります",
      "duration_multiplier": 1.15
    },
    {
      "text": "クラウド事業者が",
      "duration_multiplier": 1
    },
    {
      "text": "すべてを守ってくれる",
      "duration_multiplier": 1
    },
    {
      "text": "わけではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者側には、",
      "duration_multiplier": 1
    },
    {
      "text": "設定や権限管理の",
      "duration_multiplier": 1
    },
    {
      "text": "責任が残ります",
      "duration_multiplier": 1.15
    },
    {
      "text": "これを、",
      "duration_multiplier": 1
    },
    {
      "text": "責任共有モデルとして",
      "duration_multiplier": 1
    },
    {
      "text": "考えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "どの層を",
      "duration_multiplier": 1
    },
    {
      "text": "誰が管理するかを",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "障害対応でも、",
      "duration_multiplier": 1
    },
    {
      "text": "責任分界が重要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "契約やサービス仕様も、",
      "duration_multiplier": 1
    },
    {
      "text": "責任範囲へ",
      "duration_multiplier": 1
    },
    {
      "text": "影響します",
      "duration_multiplier": 1.15
    },
    {
      "text": "クラウド選定では、",
      "duration_multiplier": 1
    },
    {
      "text": "便利さだけでなく",
      "duration_multiplier": 1
    },
    {
      "text": "責任範囲を見ます",
      "duration_multiplier": 1.35
    },
    {
      "text": "申請管理をSaaSで使う場合、利用者",
      "duration_multiplier": 1
    },
    {
      "text": "はアカウントと共有設定を管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "仮想マシンを借りて自作する場合は、",
      "duration_multiplier": 1
    },
    {
      "text": "OS更新やアプリの保守も担当範囲に",
      "duration_multiplier": 1
    },
    {
      "text": "入ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "提供者が基盤を守っていても、誤った",
      "duration_multiplier": 1
    },
    {
      "text": "公開設定は利用者側の問題になりえます",
      "duration_multiplier": 1
    },
    {
      "text": "。",
      "duration_multiplier": 1.15
    },
    {
      "text": "契約、サービス構成、データの扱いを",
      "duration_multiplier": 1
    },
    {
      "text": "確認し、誰が何を更新し監視するか表",
      "duration_multiplier": 1
    },
    {
      "text": "にします。",
      "duration_multiplier": 1.35
    }
  ]
}
