{
  "schema_version": 1,
  "id": "cloud-iam",
  "title": "クラウドのIAM",
  "topic": "クラウド",
  "summary": "クラウドでの認証・認可・最小権限・権限分離の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-53 Rev. 5 Update 1",
      "url": "https://csrc.nist.gov/pubs/sp/800/53/r5/upd1/final"
    },
    {
      "title": "NIST SP 800-63B-4: Authentication and Authenticator Management",
      "url": "https://csrc.nist.gov/pubs/sp/800/63/b/4/final"
    },
    {
      "title": "NIST Glossary: Least Privilege",
      "url": "https://csrc.nist.gov/glossary/term/least_privilege"
    }
  ],
  "chunks": [
    {
      "text": "IAMは、",
      "duration_multiplier": 1
    },
    {
      "text": "Identity and ",
      "duration_multiplier": 1
    },
    {
      "text": "Access Management",
      "duration_multiplier": 1.25
    },
    {
      "text": "の略です",
      "duration_multiplier": 1.35
    },
    {
      "text": "誰が、何へ、",
      "duration_multiplier": 1
    },
    {
      "text": "何をできるかを",
      "duration_multiplier": 1
    },
    {
      "text": "管理します",
      "duration_multiplier": 1.15
    },
    {
      "text": "認証は、",
      "duration_multiplier": 1
    },
    {
      "text": "利用者やシステムの",
      "duration_multiplier": 1
    },
    {
      "text": "本人性を確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "認可は、",
      "duration_multiplier": 1
    },
    {
      "text": "許可する操作を",
      "duration_multiplier": 1
    },
    {
      "text": "決めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "クラウドでは、",
      "duration_multiplier": 1
    },
    {
      "text": "人だけでなく",
      "duration_multiplier": 1
    },
    {
      "text": "アプリにも権限が",
      "duration_multiplier": 1
    },
    {
      "text": "必要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "長期間使う",
      "duration_multiplier": 1
    },
    {
      "text": "強い権限は、",
      "duration_multiplier": 1
    },
    {
      "text": "リスクを高めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "最小権限は、",
      "duration_multiplier": 1
    },
    {
      "text": "必要な権限だけを",
      "duration_multiplier": 1
    },
    {
      "text": "与える考え方です",
      "duration_multiplier": 1.15
    },
    {
      "text": "管理者権限を",
      "duration_multiplier": 1
    },
    {
      "text": "日常作業で",
      "duration_multiplier": 1
    },
    {
      "text": "使わないようにします",
      "duration_multiplier": 1.15
    },
    {
      "text": "役割ごとに",
      "duration_multiplier": 1
    },
    {
      "text": "権限をまとめる",
      "duration_multiplier": 1
    },
    {
      "text": "方法があります",
      "duration_multiplier": 1.15
    },
    {
      "text": "重要操作では、",
      "duration_multiplier": 1
    },
    {
      "text": "多要素認証が有効です",
      "duration_multiplier": 1.15
    },
    {
      "text": "秘密情報は、",
      "duration_multiplier": 1
    },
    {
      "text": "安全な保管場所で",
      "duration_multiplier": 1
    },
    {
      "text": "管理します",
      "duration_multiplier": 1.15
    },
    {
      "text": "退職や異動時には、",
      "duration_multiplier": 1
    },
    {
      "text": "不要な権限を",
      "duration_multiplier": 1
    },
    {
      "text": "速やかに外します",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限変更のログを",
      "duration_multiplier": 1
    },
    {
      "text": "残すことも重要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "IAMは、",
      "duration_multiplier": 1
    },
    {
      "text": "クラウドセキュリティの",
      "duration_multiplier": 1
    },
    {
      "text": "中心的な要素です",
      "duration_multiplier": 1.35
    },
    {
      "text": "担当者が審査部署から異動したとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "旧部署の申請データを読める権限は外し、",
      "duration_multiplier": 1
    },
    {
      "text": "新部署に必要な権限だけ付けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "個人に直接権限を積み重ねると",
      "duration_multiplier": 1
    },
    {
      "text": "異動時に見落としやすくなります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "役割ごとの権限と例外を管理し、",
      "duration_multiplier": 1
    },
    {
      "text": "定期的に見直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "操作履歴から誰がどの権限で",
      "duration_multiplier": 1
    },
    {
      "text": "変更したかを追えるようにします。",
      "duration_multiplier": 1.35
    }
  ]
}
