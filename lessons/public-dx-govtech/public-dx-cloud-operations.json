  "chunks": [
    {
      "text": "クラウド利用は移設だけではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用設計も変わります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "責任分界を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Cloud事業者の責任があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用組織の責任も残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定責任を曖昧にしません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "IAMを設計します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "管理者権限を絞ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者権限も最小化します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Service Accountも管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Logを集めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "監視対象を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "可用性要件を定めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "冗長化だけで十分とは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "依存Serviceも確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Backupを設計します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "復元試験も行います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "保存しているだけでは不十分です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "RTOを考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "RPOも考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "障害時の連絡経路を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "責任者を明確にします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "事業者間の境界もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "アプリ事業者も関係します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用事業者も関係します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "障害切り分けを準備します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更管理も必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定変更を記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "IaCを使う場合もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "再現性を高められます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Costも継続監視します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "使った分だけ安いとは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "過剰資源を見直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Data Transfer費もあり得ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Managed Serviceも費用があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用工数も合わせて見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Lock-inも評価します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "ただし抽象化には費用があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Exit Planを持ちます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Data Exportを確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "設定情報も引き継ぎます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "暗号鍵も管理します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "契約終了時を想定します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Cloud Native化が目的ではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "公共サービスの価値が目的です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "標準準拠と運用最適化を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "移行後も継続して改善します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "責任と観測を明確にします。",
      "duration_multiplier": 1.15
    }
