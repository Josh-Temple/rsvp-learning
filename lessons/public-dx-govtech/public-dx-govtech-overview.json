  "sources": [],
  "chunks": [
    {
      "text": "公共DXは、",
      "duration_multiplier": 1
    },
    {
      "text": "行政サービスと",
      "duration_multiplier": 1
    },
    {
      "text": "行政内部の業務を",
      "duration_multiplier": 1
    },
    {
      "text": "デジタルで改善する",
      "duration_multiplier": 1
    },
    {
      "text": "取り組みです",
      "duration_multiplier": 1.4
    },
    {
      "text": "目的は、",
      "duration_multiplier": 1
    },
    {
      "text": "システム導入ではなく",
      "duration_multiplier": 1
    },
    {
      "text": "住民や職員への価値です",
      "duration_multiplier": 1.15
    },
    {
      "text": "行政では、",
      "duration_multiplier": 1
    },
    {
