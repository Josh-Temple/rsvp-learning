{
  "schema_version": 1,
  "id": "system-development-design",
  "title": "基本設計と詳細設計",
  "topic": "システム開発",
  "summary": "要件を実装できる形へ変換する設計工程の役割を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "設計は、要件を実装可能な形へ変える工程です",
      "duration_multiplier": 1.35
    },
    {
      "text": "基本設計は、利用者や外部から見える仕様を扱うことが多いです",
      "duration_multiplier": 1.1
    },
    {
      "text": "画面、帳票、API、データの大枠を整理します",
      "duration_multiplier": 1.1
    },
    {
      "text": "権限や業務フローも、設計対象になります",
      "duration_multiplier": 1.1
    },
    {
      "text": "詳細設計は、実装に近い内部構造を具体化します",
      "duration_multiplier": 1.1
    },
    {
      "text": "処理手順やデータ構造を細かく決めます",
      "duration_multiplier": 1.1
    },
    {
      "text": "組織によって、基本設計と詳細設計の境界は異なります",
      "duration_multiplier": 1.1
    },
    {
      "text": "重要なのは、名前より責務です",
      "duration_multiplier": 1.1
    },
    {
      "text": "設計では、正常系だけでなく異常系も考えます",
      "duration_multiplier": 1.1
    },
    {
      "text": "入力エラーや通信失敗時の動作を決めます",
      "duration_multiplier": 1.1
    },
    {
      "text": "運用時に必要なログも設計します",
      "duration_multiplier": 1.1
    },
    {
      "text": "変更しやすさも、設計品質の一部です",
      "duration_multiplier": 1.1
    },
    {
      "text": "設計判断には、コストと複雑性のトレードオフがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "良い設計は、要件とのつながりを説明できます",
      "duration_multiplier": 1.35
    }
  ]
}
