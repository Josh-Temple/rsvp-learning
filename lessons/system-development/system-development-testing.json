{
  "schema_version": 1,
  "id": "system-development-testing",
  "title": "テストの基本",
  "topic": "システム開発",
  "summary": "単体、結合、システム、受入テストの役割と、テスト設計の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-115: Technical Guide to Information Security Testing and Assessment",
      "url": "https://csrc.nist.gov/pubs/sp/800/115/final"
    }
  ],
  "chunks": [
    {
      "text": "テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "期待どおり動くかを",
      "duration_multiplier": 1
    },
    {
      "text": "確認する活動です",
      "duration_multiplier": 1.35
    },
    {
      "text": "単体テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "小さな部品を",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "結合テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "複数の部品の",
      "duration_multiplier": 1
    },
    {
      "text": "連携を確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "システムテストは、",
      "duration_multiplier": 1
    },
    {
      "text": "システム全体を",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "受入テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "利用者側の要求を",
      "duration_multiplier": 1
    },
    {
      "text": "満たすか確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "工程名や範囲は、",
      "duration_multiplier": 1
    },
    {
      "text": "組織によって",
      "duration_multiplier": 1
    },
    {
      "text": "異なることがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "テストケースは、",
      "duration_multiplier": 1
    },
    {
      "text": "確認する条件と",
      "duration_multiplier": 1
    },
    {
      "text": "期待結果を定めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "正常系だけでは",
      "duration_multiplier": 1
    },
    {
      "text": "不十分です",
      "duration_multiplier": 1.15
    },
    {
      "text": "異常入力や",
      "duration_multiplier": 1
    },
    {
      "text": "境界値も確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限による違いも",
      "duration_multiplier": 1
    },
    {
      "text": "テスト対象です",
      "duration_multiplier": 1.15
    },
    {
      "text": "非機能要件には、",
      "duration_multiplier": 1
    },
    {
      "text": "性能や可用性の",
      "duration_multiplier": 1
    },
    {
      "text": "テストがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "不具合は、",
      "duration_multiplier": 1
    },
    {
      "text": "再現条件を明確にして",
      "duration_multiplier": 1
    },
    {
      "text": "管理します",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件からテストまで",
      "duration_multiplier": 1
    },
    {
      "text": "追えることが重要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "品質を作る最後の",
      "duration_multiplier": 1
    },
    {
      "text": "工程ではなく、",
      "duration_multiplier": 1
    },
    {
      "text": "品質を確認する工程です",
      "duration_multiplier": 1.35
    },
    {
      "text": "申請期限の計算を単体テストで確かめ、",
      "duration_multiplier": 1
    },
    {
      "text": "画面とAPIの接続を結合テストで確か",
      "duration_multiplier": 1
    },
    {
      "text": "めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受入テストでは利用者が一件の申請を",
      "duration_multiplier": 1
    },
    {
      "text": "完了できるか見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "各試験で見つかる不具合は異なるため、",
      "duration_multiplier": 1
    },
    {
      "text": "一つが通っても他を省けません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通常の入力に加え、期限ぎりぎりと書類",
      "duration_multiplier": 1
    },
    {
      "text": "不足も試します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "期待結果を要件に結びます。",
      "duration_multiplier": 1.35
    }
  ]
}
