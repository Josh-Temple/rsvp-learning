{
  "schema_version": 1,
  "id": "system-development-testing",
  "title": "テストの基本",
  "topic": "システム開発",
  "summary": "単体、結合、システム、受入テストの役割と、テスト設計の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "テストは、期待どおり動くかを確認する活動です",
      "duration_multiplier": 1.35
    },
    {
      "text": "単体テストは、小さな部品を確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "結合テストは、複数の部品の連携を確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "システムテストは、システム全体を確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "受入テストは、利用者側の要求を満たすか確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "工程名や範囲は、組織によって異なることがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "テストケースは、確認する条件と期待結果を定めます",
      "duration_multiplier": 1.1
    },
    {
      "text": "正常系だけでは不十分です",
      "duration_multiplier": 1.1
    },
    {
      "text": "異常入力や境界値も確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "権限による違いもテスト対象です",
      "duration_multiplier": 1.1
    },
    {
      "text": "非機能要件には、性能や可用性のテストがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "不具合は、再現条件を明確にして管理します",
      "duration_multiplier": 1.1
    },
    {
      "text": "要件からテストまで追えることが重要です",
      "duration_multiplier": 1.1
    },
    {
      "text": "テストは、品質を作る最後の工程ではなく、品質を確認する工程です",
      "duration_multiplier": 1.35
    }
  ]
}
