{
  "schema_version": 1,
  "id": "system-development-testing",
  "title": "テストの基本",
  "topic": "システム開発",
  "summary": "単体、結合、システム、受入テストの役割と、テスト設計の基本を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "ISTQB Certified Tester Foundation Level Syllabus v4.0.1",
      "url": "https://istqb.org/wp-content/uploads/2024/11/ISTQB_CTFL_Syllabus_v4.0.1.pdf"
    }
  ],
  "chunks": [
    {
      "text": "申請期限の計算を単体テストで確かめ、",
      "duration_multiplier": 1
    },
    {
      "text": "画面とAPIの接続を結合テストで確かめます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "受入テストでは利用者が",
      "duration_multiplier": 1
    },
    {
      "text": "一件の申請を完了できるか見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "期待どおり動くかを",
      "duration_multiplier": 1
    },
    {
      "text": "確認する活動です",
      "duration_multiplier": 1.35
    },
    {
      "text": "単体テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "小さな部品を",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "結合テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "複数の部品の",
      "duration_multiplier": 1
    },
    {
      "text": "連携を確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "システムテストは、",
      "duration_multiplier": 1
    },
    {
      "text": "システム全体を",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "受入テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "利用者側の要求を",
      "duration_multiplier": 1
    },
    {
      "text": "満たすか確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "工程名や範囲は、",
      "duration_multiplier": 1
    },
    {
      "text": "組織によって",
      "duration_multiplier": 1
    },
    {
      "text": "異なることがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "テストケースは、",
      "duration_multiplier": 1
    },
    {
      "text": "確認する条件と",
      "duration_multiplier": 1
    },
    {
      "text": "期待結果を定めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "正常系だけでは",
      "duration_multiplier": 1
    },
    {
      "text": "不十分です",
      "duration_multiplier": 1.15
    },
    {
      "text": "異常入力や",
      "duration_multiplier": 1
    },
    {
      "text": "境界値も確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限による違いも",
      "duration_multiplier": 1
    },
    {
      "text": "テスト対象です",
      "duration_multiplier": 1.15
    },
    {
      "text": "期限計算の単体試験だけでは、",
      "duration_multiplier": 1
    },
    {
      "text": "画面から申請が完了するか分かりません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "非機能要件には、",
      "duration_multiplier": 1
    },
    {
      "text": "性能や可用性の",
      "duration_multiplier": 1
    },
    {
      "text": "テストがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "不具合は、",
      "duration_multiplier": 1
    },
    {
      "text": "再現条件を明確にして",
      "duration_multiplier": 1
    },
    {
      "text": "管理します",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件からテストまで",
      "duration_multiplier": 1
    },
    {
      "text": "追えることが重要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "テストは、",
      "duration_multiplier": 1
    },
    {
      "text": "品質を作る最後の",
      "duration_multiplier": 1
    },
    {
      "text": "工程ではなく、",
      "duration_multiplier": 1
    },
    {
      "text": "品質を確認する工程です",
      "duration_multiplier": 1.35
    },
    {
      "text": "各試験で見つかる不具合は異なるため、",
      "duration_multiplier": 1
    },
    {
      "text": "一つが通っても他を省けません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "通常の入力に加え、",
      "duration_multiplier": 1
    },
    {
      "text": "期限ぎりぎりと書類不足も試します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "期待結果を要件に結びます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "連携と受入の試験を要件につなぎ、",
      "duration_multiplier": 1
    },
    {
      "text": "どの段階でどの問題を見つけるか整理します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "期限計算が正しくても、APIが拒否するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "単体試験だけでは申請を完了できません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "結合試験で接続を、受入試験で目的を見ます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "一段階の試験が通れば十分でしょうか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "異なる失敗を拾うため、段階を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "正常系だけでは十分でありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "境界値と異常系も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "再現条件を記録します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "期待結果を先に定めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "自動化しにくい試験もあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "自動試験だけで品質を保証しません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "本番に近い条件も必要です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "欠陥の傾向を次の設計へ戻します。",
      "duration_multiplier": 1.15
    }
  ]
}
