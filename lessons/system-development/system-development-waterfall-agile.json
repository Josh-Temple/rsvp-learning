{
  "schema_version": 1,
  "id": "system-development-waterfall-agile",
  "title": "WaterfallとAgile",
  "topic": "システム開発",
  "summary": "代表的な開発アプローチであるWaterfallとAgileの違いと使い分けの考え方を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "アジャイルソフトウェア開発宣言（日本語）",
      "url": "https://agilemanifesto.org/iso/ja/manifesto.html"
    }
  ],
  "chunks": [
    {
      "text": "申請制度の確定した要件をまとめて設計し、",
      "duration_multiplier": 1
    },
    {
      "text": "段階ごとに確認する進め方を考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "別の進め方では、受付だけ先に試し、",
      "duration_multiplier": 1
    },
    {
      "text": "利用者の反応を見て改善します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "WaterfallとAgileは、",
      "duration_multiplier": 1
    },
    {
      "text": "開発の進め方を考える",
      "duration_multiplier": 1
    },
    {
      "text": "代表的な枠組みです",
      "duration_multiplier": 1.25
    },
    {
      "text": "Waterfallでは、",
      "duration_multiplier": 1
    },
    {
      "text": "工程を順に",
      "duration_multiplier": 1
    },
    {
      "text": "進める形が基本です",
      "duration_multiplier": 1.25
    },
    {
      "text": "初期に要件や計画を明確にすることを重視します",
      "duration_multiplier": 1.1
    },
    {
      "text": "ただし、工程が進んだ後の変更は",
      "duration_multiplier": 1
    },
    {
      "text": "影響範囲が広くなる場合があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "案件の規模だけで、",
      "duration_multiplier": 1
    },
    {
      "text": "進め方を選ぶわけではありません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "Agileでは、小さな単位で",
      "duration_multiplier": 1
    },
    {
      "text": "作り、確認し、改善を繰り返します",
      "duration_multiplier": 1.25
    },
    {
      "text": "早い段階で利用者から",
      "duration_multiplier": 1
    },
    {
      "text": "フィードバックを得やすくなります",
      "duration_multiplier": 1.25
    },
    {
      "text": "不確実性が高い領域に向く場合があります",
      "duration_multiplier": 1.1
    },
    {
      "text": "ただし、Agileでも計画や品質管理は必要です",
      "duration_multiplier": 1.1
    },
    {
      "text": "Waterfallでも、",
      "duration_multiplier": 1
    },
    {
      "text": "途中の検証や",
      "duration_multiplier": 1
    },
    {
      "text": "改善はできます",
      "duration_multiplier": 1.25
    },
    {
      "text": "要件が固まっていても途中変更は起こり、",
      "duration_multiplier": 1
    },
    {
      "text": "反復を選んでも規制上の条件は残ります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "実務では、両者を組み合わせることもあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "重要なのは、",
      "duration_multiplier": 1
    },
    {
      "text": "名称ではなく",
      "duration_multiplier": 1
    },
    {
      "text": "要求の不確実性や",
      "duration_multiplier": 1
    },
    {
      "text": "変更頻度に合う",
      "duration_multiplier": 1
    },
    {
      "text": "進め方です",
      "duration_multiplier": 1.25
    },
    {
      "text": "契約、組織、規制、技術条件も選択に影響します",
      "duration_multiplier": 1.1
    },
    {
      "text": "手法を目的化せず、価値を届ける方法として考えます",
      "duration_multiplier": 1.35
    },
    {
      "text": "途中で制度が変われば、",
      "duration_multiplier": 1
    },
    {
      "text": "どちらも影響範囲と承認を確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "短い反復でも法令上の要件を省けません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更の頻度と利用者の関与に",
      "duration_multiplier": 1
    },
    {
      "text": "合わせて進め方を選びます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "利用者がいつ確かめられるか、",
      "duration_multiplier": 1
    },
    {
      "text": "変更をどう取り込むかで進め方を比較します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "短い反復で受付画面を先に公開するとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "審査規程が未確定なら、受付可否を決められません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "反復の範囲と確定が必要な条件を分けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "反復型なら承認を後回しにできますか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "規程上の確認は進め方と独立に必要です。",
      "duration_multiplier": 1.15
    }
  ]
}
