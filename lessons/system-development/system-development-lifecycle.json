{
  "schema_version": 1,
  "id": "system-development-lifecycle",
  "title": "開発ライフサイクル",
  "topic": "システム開発",
  "summary": "企画から運用保守まで、システム開発の工程と各工程の目的を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "小さな申請システムでも、",
      "duration_multiplier": 1
    },
    {
      "text": "目的の整理から要件、設計、",
      "duration_multiplier": 1
    },
    {
      "text": "実装、試験、運用まで続きます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "公開した時点で終わりではなく、",
      "duration_multiplier": 1
    },
    {
      "text": "制度改正時に案内を直す必要があります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "システム開発は、",
      "duration_multiplier": 1
    },
    {
      "text": "複数の工程で進みます",
      "duration_multiplier": 1.35
    },
    {
      "text": "企画では、",
      "duration_multiplier": 1
    },
    {
      "text": "解くべき課題と",
      "duration_multiplier": 1
    },
    {
      "text": "投資目的を整理します",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件定義では、",
      "duration_multiplier": 1
    },
    {
      "text": "実現すべき条件を",
      "duration_multiplier": 1
    },
    {
      "text": "決めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "設計では、",
      "duration_multiplier": 1
    },
    {
      "text": "要件を実装可能な",
      "duration_multiplier": 1
    },
    {
      "text": "構造へ落とします",
      "duration_multiplier": 1.15
    },
    {
      "text": "実装では、",
      "duration_multiplier": 1
    },
    {
      "text": "コードや設定として",
      "duration_multiplier": 1
    },
    {
      "text": "形にします",
      "duration_multiplier": 1.15
    },
    {
      "text": "テストでは、",
      "duration_multiplier": 1
    },
    {
      "text": "期待どおり動くか",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "移行では、",
      "duration_multiplier": 1
    },
    {
      "text": "旧環境から",
      "duration_multiplier": 1
    },
    {
      "text": "新環境へ切り替えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "リリース後は、",
      "duration_multiplier": 1
    },
    {
      "text": "運用と保守が",
      "duration_multiplier": 1
    },
    {
      "text": "始まります",
      "duration_multiplier": 1.15
    },
    {
      "text": "障害対応だけが、",
      "duration_multiplier": 1
    },
    {
      "text": "運用ではありません",
      "duration_multiplier": 1.15
    },
    {
      "text": "監視、問い合わせ、",
      "duration_multiplier": 1
    },
    {
      "text": "改善も運用に含まれます",
      "duration_multiplier": 1.15
    },
    {
      "text": "公開後に制度が変われば、",
      "duration_multiplier": 1
    },
    {
      "text": "要件と案内を直し、試験してから反映します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "前工程の曖昧さは、",
      "duration_multiplier": 1
    },
    {
      "text": "後工程で",
      "duration_multiplier": 1
    },
    {
      "text": "大きな手戻りに",
      "duration_multiplier": 1
    },
    {
      "text": "なり得ます",
      "duration_multiplier": 1.15
    },
    {
      "text": "一方で、",
      "duration_multiplier": 1
    },
    {
      "text": "すべてを最初に",
      "duration_multiplier": 1
    },
    {
      "text": "確定できるとは",
      "duration_multiplier": 1
    },
    {
      "text": "限りません",
      "duration_multiplier": 1.15
    },
    {
      "text": "工程ごとの目的と",
      "duration_multiplier": 1
    },
    {
      "text": "成果物を理解する",
      "duration_multiplier": 1
    },
    {
      "text": "ことが重要です",
      "duration_multiplier": 1.15
    },
    {
      "text": "全体像を持つと、",
      "duration_multiplier": 1
    },
    {
      "text": "自分の担当の",
      "duration_multiplier": 1
    },
    {
      "text": "位置づけが見えます",
      "duration_multiplier": 1.35
    },
    {
      "text": "各段階の成果を次の段階へ渡し、",
      "duration_multiplier": 1
    },
    {
      "text": "利用者の確認を受けます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "不具合の報告があれば原因を調べ、",
      "duration_multiplier": 1
    },
    {
      "text": "修正後に回帰を試験します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "保守の担当と費用を計画に含めます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "企画時に保守の担当と費用を考えるのは、",
      "duration_multiplier": 1
    },
    {
      "text": "公開後も価値を保つためです。",
      "duration_multiplier": 1.35
    },
    {
      "text": "公開後、代理人の必要書類が変わったとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "案内文だけ直すと、入力チェックが古いままです。",
      "duration_multiplier": 1.15
    },
    {
      "text": "要件から試験まで変更の影響をたどります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "公開後の変更を単なる文言修正としてよいですか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "動作と運用への影響も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "工程は一方向にしか進むとは限りません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "試験結果から設計へ戻ることがあります。",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用課題から要件を見直します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "保守も開発の続きとして扱います。",
      "duration_multiplier": 1.15
    },
    {
      "text": "廃止時のデータ処理も考えます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "変更理由を履歴に残します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "各工程の成果物をつなぎます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "公開後もライフサイクルは続きます。",
      "duration_multiplier": 1.15
    }
  ]
}
