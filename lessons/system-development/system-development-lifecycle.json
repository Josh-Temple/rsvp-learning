{
  "schema_version": 1,
  "id": "system-development-lifecycle",
  "title": "開発ライフサイクル",
  "topic": "システム開発",
  "summary": "企画から運用保守まで、システム開発の工程と各工程の目的を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "システム開発は、複数の工程で進みます",
      "duration_multiplier": 1.35
    },
    {
      "text": "企画では、解くべき課題と投資目的を整理します",
      "duration_multiplier": 1.1
    },
    {
      "text": "要件定義では、実現すべき条件を決めます",
      "duration_multiplier": 1.1
    },
    {
      "text": "設計では、要件を実装可能な構造へ落とします",
      "duration_multiplier": 1.1
    },
    {
      "text": "実装では、コードや設定として形にします",
      "duration_multiplier": 1.1
    },
    {
      "text": "テストでは、期待どおり動くか確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "移行では、旧環境から新環境へ切り替えます",
      "duration_multiplier": 1.1
    },
    {
      "text": "リリース後は、運用と保守が始まります",
      "duration_multiplier": 1.1
    },
    {
      "text": "障害対応だけが、運用ではありません",
      "duration_multiplier": 1.1
    },
    {
      "text": "監視、問い合わせ、改善も運用に含まれます",
      "duration_multiplier": 1.1
    },
    {
      "text": "前工程の曖昧さは、後工程で大きな手戻りになり得ます",
      "duration_multiplier": 1.1
    },
    {
      "text": "一方で、すべてを最初に確定できるとは限りません",
      "duration_multiplier": 1.1
    },
    {
      "text": "工程ごとの目的と成果物を理解することが重要です",
      "duration_multiplier": 1.1
    },
    {
      "text": "全体像を持つと、自分の担当の位置づけが見えます",
      "duration_multiplier": 1.35
    }
  ]
}
