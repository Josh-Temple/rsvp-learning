{
  "schema_version": 1,
  "id": "system-development-migration-operations",
  "title": "移行と運用設計",
  "topic": "システム開発",
  "summary": "新システムへの切替と、リリース後に安定運用するための準備を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [
    {
      "title": "NIST SP 800-34 Rev. 1 Update 1: Contingency Planning Guide",
      "url": "https://csrc.nist.gov/pubs/sp/800/34/r1/upd1/final"
    }
  ],
  "chunks": [
    {
      "text": "紙台帳の申請を新システムへ移すとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "氏名だけでは同姓同名を区別できず、",
      "duration_multiplier": 1
    },
    {
      "text": "件数一致だけでは正しい移行とは言えません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "システムは、",
      "duration_multiplier": 1
    },
    {
      "text": "完成しただけでは",
      "duration_multiplier": 1
    },
    {
      "text": "利用できません",
      "duration_multiplier": 1.35
    },
    {
      "text": "移行では、",
      "duration_multiplier": 1
    },
    {
      "text": "旧環境から",
      "duration_multiplier": 1
    },
    {
      "text": "新環境へ切り替えます",
      "duration_multiplier": 1.15
    },
    {
      "text": "データ移行では、",
      "duration_multiplier": 1
    },
    {
      "text": "形式と意味の両方を",
      "duration_multiplier": 1
    },
    {
      "text": "確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "欠損や重複がないか",
      "duration_multiplier": 1
    },
    {
      "text": "検証します",
      "duration_multiplier": 1.15
    },
    {
      "text": "利用者や権限の",
      "duration_multiplier": 1
    },
    {
      "text": "移行も必要になる",
      "duration_multiplier": 1
    },
    {
      "text": "ことがあります",
      "duration_multiplier": 1.15
    },
    {
      "text": "本番切替の手順を",
      "duration_multiplier": 1
    },
    {
      "text": "事前に決めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "失敗した場合の",
      "duration_multiplier": 1
    },
    {
      "text": "戻し方も準備します",
      "duration_multiplier": 1.15
    },
    {
      "text": "これが、",
      "duration_multiplier": 1
    },
    {
      "text": "rollbackの考え方です",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用設計では、",
      "duration_multiplier": 1
    },
    {
      "text": "誰が何を監視するかを",
      "duration_multiplier": 1
    },
    {
      "text": "決めます",
      "duration_multiplier": 1.15
    },
    {
      "text": "障害時の連絡先と",
      "duration_multiplier": 1
    },
    {
      "text": "判断権限を明確にします",
      "duration_multiplier": 1.15
    },
    {
      "text": "移行前後で件数が一致しても、",
      "duration_multiplier": 1
    },
    {
      "text": "別人の申請へ情報を結びつければ失敗です。",
      "duration_multiplier": 1.15
    },
    {
      "text": "バックアップと",
      "duration_multiplier": 1
    },
    {
      "text": "復旧手順を確認します",
      "duration_multiplier": 1.15
    },
    {
      "text": "問い合わせ対応や",
      "duration_multiplier": 1
    },
    {
      "text": "変更手順も設計します",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用担当へ",
      "duration_multiplier": 1
    },
    {
      "text": "必要な情報を",
      "duration_multiplier": 1
    },
    {
      "text": "引き継ぎます",
      "duration_multiplier": 1.15
    },
    {
      "text": "良い移行は、",
      "duration_multiplier": 1
    },
    {
      "text": "技術だけでなく",
      "duration_multiplier": 1
    },
    {
      "text": "業務継続を守ります",
      "duration_multiplier": 1.35
    },
    {
      "text": "移行前後の識別子、",
      "duration_multiplier": 1
    },
    {
      "text": "重要項目、件数を照合します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "失敗した場合に旧台帳へ戻す期限と手順を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "切替後の問い合わせ、バックアップ、",
      "duration_multiplier": 1
    },
    {
      "text": "障害対応の担当も用意します。",
      "duration_multiplier": 1.35
    },
    {
      "text": "識別子と重要項目を照合し、",
      "duration_multiplier": 1
    },
    {
      "text": "戻せる期限を越える前に切替可否を決めます。",
      "duration_multiplier": 1.35
    },
    {
      "text": "移行後に同じ人が二件に分かれたとします。",
      "duration_multiplier": 1.15
    },
    {
      "text": "旧台帳では氏名の表記が揺れていました。",
      "duration_multiplier": 1.15
    },
    {
      "text": "統合規則を決め、元の記録を残して照合します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "件数が一致すれば重複もないでしょうか。",
      "duration_multiplier": 1.25
    },
    {
      "text": "重複と誤結合は別に調べます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "移行前に照合基準を決めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "件数以外の整合性も確認します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "切替条件を事前に定めます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "戻す条件も決めておきます。",
      "duration_multiplier": 1.15
    },
    {
      "text": "運用手順を実地で試します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "権限移行も忘れません。",
      "duration_multiplier": 1.15
    },
    {
      "text": "監視と問い合わせ先を準備します。",
      "duration_multiplier": 1.15
    },
    {
      "text": "安定後に旧環境を閉じます。",
      "duration_multiplier": 1.15
    }
  ]
}
