{
  "schema_version": 1,
  "id": "system-development-migration-operations",
  "title": "移行と運用設計",
  "topic": "システム開発",
  "summary": "新システムへの切替と、リリース後に安定運用するための準備を学びます。",
  "created_at": "2026-09-27",
  "base_duration_ms": 680,
  "sources": [],
  "chunks": [
    {
      "text": "システムは、完成しただけでは利用できません",
      "duration_multiplier": 1.35
    },
    {
      "text": "移行では、旧環境から新環境へ切り替えます",
      "duration_multiplier": 1.1
    },
    {
      "text": "データ移行では、形式と意味の両方を確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "欠損や重複がないか検証します",
      "duration_multiplier": 1.1
    },
    {
      "text": "利用者や権限の移行も必要になることがあります",
      "duration_multiplier": 1.1
    },
    {
      "text": "本番切替の手順を事前に決めます",
      "duration_multiplier": 1.1
    },
    {
      "text": "失敗した場合の戻し方も準備します",
      "duration_multiplier": 1.1
    },
    {
      "text": "これが、rollbackの考え方です",
      "duration_multiplier": 1.1
    },
    {
      "text": "運用設計では、誰が何を監視するかを決めます",
      "duration_multiplier": 1.1
    },
    {
      "text": "障害時の連絡先と判断権限を明確にします",
      "duration_multiplier": 1.1
    },
    {
      "text": "バックアップと復旧手順を確認します",
      "duration_multiplier": 1.1
    },
    {
      "text": "問い合わせ対応や変更手順も設計します",
      "duration_multiplier": 1.1
    },
    {
      "text": "運用担当へ必要な情報を引き継ぎます",
      "duration_multiplier": 1.1
    },
    {
      "text": "良い移行は、技術だけでなく業務継続を守ります",
      "duration_multiplier": 1.35
    }
  ]
}
